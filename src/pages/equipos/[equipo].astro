  "wolverhampton-wanderers": { primario: "#FDB913", secundario: "#111111", acento: "#FFFFFF", primarioRgb: "253, 185, 19", secundarioRgb: "17, 17, 17", acentoRgb: "255, 255, 255" }
};

const temaEquipo = paletasEquipos[equipoSlug] ?? temaNeutro;

const convertirRgb = (rgb: string) =>
  rgb.split(",").map((valor) => Number(valor.trim()));

const luminancia = (rgb: string) => {
  const [r = 0, g = 0, b = 0] = convertirRgb(rgb);
  return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
};

const primarioMuyClaro = luminancia(temaEquipo.primarioRgb) > 0.82;

const fondoPrincipalRgb = primarioMuyClaro
  ? temaEquipo.secundarioRgb
  : temaEquipo.primarioRgb;

const fondoSecundarioRgb = primarioMuyClaro
  ? temaEquipo.acentoRgb
  : temaEquipo.secundarioRgb;

const intensidadFondo = primarioMuyClaro ? 0.23 : 0.18;

const colorNavegador = primarioMuyClaro
  ? temaEquipo.secundario
  : temaEquipo.primario;

const escudoUrlAbsoluta = new URL(
  obtenerEscudo(equipo),
  Astro.url.origin
).href;

const imagenSocial = camisetas[0]
  ? new URL(camisetas[0].fullSrc, Astro.url.origin).href
  : escudoUrlAbsoluta;

const urlCanonica = new URL(Astro.url.pathname, Astro.url.origin).href;
const urlEquipoAnterior = new URL(`/equipos/${crearSlug(equipoAnterior)}`, Astro.url.origin).href;
const urlEquipoSiguiente = new URL(`/equipos/${crearSlug(equipoSiguiente)}`, Astro.url.origin).href;

const datosEstructurados = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `Camisetas de ${equipo}`,
  description: `Colección de camisetas de ${equipo} organizada por temporada y tipo.`,
  url: urlCanonica,
  primaryImageOfPage: imagenSocial,
  isPartOf: {
    "@type": "WebSite",
    name: "Elite Jerseys",
    url: Astro.url.origin
  },
  about: {
    "@type": "SportsTeam",
    name: equipo,
    image: escudoUrlAbsoluta
  },
  numberOfItems: camisetas.length,
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", Astro.url.origin).href },
      { "@type": "ListItem", position: 2, name: categoria, item: urlCanonica },
      { "@type": "ListItem", position: 3, name: equipo, item: urlCanonica }
    ]
  },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: camisetas.length,
    itemListElement: camisetas.map((camiseta, indice) => ({
      "@type": "ListItem",
      position: indice + 1,
      name: `${equipo} ${camiseta.temporada} ${camiseta.tipo}`,
      url: `${urlCanonica}#${camiseta.temporada.replace("/", "-")}-${camiseta.tipoSlug}`,
      image: {
        "@type": "ImageObject",
        contentUrl: new URL(camiseta.fullSrc, Astro.url.origin).href,
        caption: `${equipo} ${camiseta.temporada} ${camiseta.tipo}`
      }
    }))
  }
};
