---
import fs from "node:fs";
import path from "node:path";

import {
  categorias,
  crearSlug,
  obtenerEscudo
} from "../../data/catalogo";

export function getStaticPaths() {
  return categorias.flatMap((categoria) =>
    categoria.equipos.map((equipo) => ({
      params: {
        equipo: crearSlug(equipo)
      },
      props: {
        equipo,
        categoria: categoria.nombre
      }
    }))
  );
}

interface Props {
  equipo: string;
  categoria: string;
}

interface Camiseta {
  src: string;
  fullSrc: string;
  thumbSrc: string;
  temporada: string;
  tipo: string;
  tipoSlug: string;
  ordenTemporada: number;
  ordenTipo: number;
}

const { equipo, categoria } = Astro.props;

const equipoSlug = crearSlug(equipo);

const categoriaActual = categorias.find(
  (item) => item.nombre === categoria
);

const equiposCategoria = categoriaActual
  ? categoriaActual.equipos
      .slice()
      .sort((a, b) => a.localeCompare(b, "es"))
  : [];

const categoriasOrdenadas = categorias.map((item) => ({
  ...item,
  equipos: item.equipos
    .slice()
    .sort((a, b) => a.localeCompare(b, "es"))
}));

const indiceEquipoActual = equiposCategoria.indexOf(equipo);

const equipoAnterior =
  indiceEquipoActual > 0
    ? equiposCategoria[indiceEquipoActual - 1]
    : equiposCategoria[equiposCategoria.length - 1];

const equipoSiguiente =
  indiceEquipoActual >= 0 && indiceEquipoActual < equiposCategoria.length - 1
    ? equiposCategoria[indiceEquipoActual + 1]
    : equiposCategoria[0];

const carpetaEquipo = path.join(
  process.cwd(),
  "public",
  "camisetas",
  equipoSlug
);

const ordenTipos: Record<string, number> = {
  local: 1,
  visitante: 2,
  tercera: 3,
  cuarta: 4,
  portero: 5,
  entrenamiento: 6
};

const convertirTipo = (tipo: string) =>
  tipo
    .split("-")
    .map((parte) => parte.charAt(0).toUpperCase() + parte.slice(1))
    .join(" ");

const camisetas: Camiseta[] = [];

if (fs.existsSync(carpetaEquipo)) {
  const entradas = fs
    .readdirSync(carpetaEquipo, { withFileTypes: true })
    .filter((entrada) => entrada.isFile())
    .map((entrada) => entrada.name);

  const patronImagen = /^\d{4}-\d{4}-.+\.(jpg|jpeg|png|webp)$/i;
  const extensionesPermitidas = /\.(jpg|jpeg|png|webp)$/i;

  for (const archivo of entradas) {
    if (
      extensionesPermitidas.test(archivo) &&
      !patronImagen.test(archivo)
    ) {
      console.warn(
        `[Elite Jerseys] Nombre de camiseta no válido: ${equipoSlug}/${archivo}`
      );
    }
  }

  const prioridadExtension: Record<string, number> = {
    webp: 1,
    jpg: 2,
    jpeg: 3,
    png: 4
  };

  const originalesPorBase = new Map<string, string>();
  const miniaturasPorBase = new Map<string, string>();

  const elegirMejorFormato = (
    mapa: Map<string, string>,
    clave: string,
    archivo: string
  ) => {
    const actual = mapa.get(clave);

    if (!actual) {
      mapa.set(clave, archivo);
      return;
    }

    const extensionNueva = archivo.split(".").pop()?.toLowerCase() ?? "";
    const extensionActual = actual.split(".").pop()?.toLowerCase() ?? "";

    if (
      (prioridadExtension[extensionNueva] ?? 99) <
      (prioridadExtension[extensionActual] ?? 99)
    ) {
      mapa.set(clave, archivo);
    }
  };

  for (const archivo of entradas.filter((nombre) => patronImagen.test(nombre))) {
    const sinExtension = archivo.replace(extensionesPermitidas, "");
    const esMiniatura = sinExtension.toLowerCase().endsWith("-thumb");
    const nombreBase = esMiniatura
      ? sinExtension.slice(0, -"-thumb".length)
      : sinExtension;

    const clave = nombreBase.toLowerCase();

    elegirMejorFormato(
      esMiniatura ? miniaturasPorBase : originalesPorBase,
      clave,
      archivo
    );
  }

  for (const [clave, archivo] of originalesPorBase) {
    const sinExtension = archivo.replace(extensionesPermitidas, "");
    const partes = sinExtension.split("-");
    const inicio = partes[0];
    const fin = partes[1];
    const tipoSlug = partes.slice(2).join("-").toLowerCase();

    if (
      !inicio ||
      !fin ||
      !tipoSlug ||
      !/^\d{4}$/.test(inicio) ||
      !/^\d{4}$/.test(fin)
    ) {
      console.warn(
        `[Elite Jerseys] Archivo ignorado por formato incorrecto: ${equipoSlug}/${archivo}`
      );
      continue;
    }

    const miniatura = miniaturasPorBase.get(clave);
    const fullSrc = `/camisetas/${equipoSlug}/${archivo}`;
    const thumbSrc = miniatura
      ? `/camisetas/${equipoSlug}/${miniatura}`
      : fullSrc;

    camisetas.push({
      src: thumbSrc,
      fullSrc,
      thumbSrc,
      temporada: `${inicio}/${fin}`,
      tipo: convertirTipo(tipoSlug),
      tipoSlug,
      ordenTemporada: Number(inicio),
      ordenTipo: ordenTipos[tipoSlug] ?? 99
    });
  }
}

camisetas.sort((a, b) => {
  if (a.ordenTemporada !== b.ordenTemporada) {
    return b.ordenTemporada - a.ordenTemporada;
  }

  if (a.ordenTipo !== b.ordenTipo) {
    return a.ordenTipo - b.ordenTipo;
  }

  return a.tipoSlug.localeCompare(b.tipoSlug, "es", {
    numeric: true,
    sensitivity: "base"
  });
});

const temporadas = [...new Set(camisetas.map((camiseta) => camiseta.temporada))];
const tipos = [...new Set(camisetas.map((camiseta) => camiseta.tipoSlug))]
  .sort((a, b) => (ordenTipos[a] ?? 99) - (ordenTipos[b] ?? 99));

