---
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Administración · Elite Jerseys</title>
  <meta name="ej-supabase-url" content={supabaseUrl} />
  <meta name="ej-supabase-key" content={supabaseKey} />
  <style is:global>
    :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color:#101713; }
    * { box-sizing:border-box; }
    body { margin:0; min-height:100vh; background:#f4f7f5; }
    .page { min-height:100vh; display:grid; place-items:center; padding:24px; }
    .card { width:min(100%,440px); background:#fff; border:1px solid #dde5e0; border-radius:22px; padding:30px; box-shadow:0 18px 55px rgba(16,23,19,.08); }
    .brand { display:flex; align-items:center; gap:12px; margin-bottom:28px; }
    .mark { width:44px; height:44px; border-radius:13px; display:grid; place-items:center; background:#101713; color:#d8b65b; font-weight:900; font-size:18px; }
    .brand strong { display:block; font-size:20px; }
    .brand span { display:block; color:#6b756f; font-size:13px; margin-top:2px; }
    h1 { margin:0 0 8px; font-size:27px; letter-spacing:-.5px; }
    .intro { margin:0 0 25px; color:#68736d; line-height:1.5; font-size:14px; }
    label { display:block; font-weight:750; font-size:13px; margin:0 0 8px; }
    .field { margin-bottom:17px; }
    input { width:100%; height:50px; border:1px solid #ccd7d1; border-radius:12px; padding:0 14px; font:inherit; outline:none; background:#fff; color:#101713; }
    input:focus { border-color:#218d63; box-shadow:0 0 0 3px rgba(33,141,99,.11); }
    button { width:100%; height:51px; border:0; border-radius:12px; background:#218d63; color:#fff; font:inherit; font-weight:850; cursor:pointer; margin-top:5px; }
    button:hover { background:#197b55; }
    button:disabled { opacity:.65; cursor:wait; }
    .message { display:none; margin-top:16px; padding:12px 14px; border-radius:11px; font-size:13px; line-height:1.4; }
    .message.error { display:block; color:#a51d1d; background:#fff0f0; border:1px solid #f0caca; }
    .message.ok { display:block; color:#126342; background:#edf9f3; border:1px solid #bfe5d2; }
    .footer { text-align:center; margin-top:22px; font-size:12px; color:#89918d; }
    .panel { display:none; width:min(100%,900px); }
    .panel-card { background:#fff; border:1px solid #dde5e0; border-radius:22px; padding:28px; }
    .panel-head { display:flex; justify-content:space-between; align-items:center; gap:20px; }
    .panel h1 { margin:0; }
    .logout { width:auto; height:42px; padding:0 18px; margin:0; background:#101713; }
    .placeholder { margin-top:25px; padding:30px; border:1px dashed #cfd8d3; border-radius:16px; color:#68736d; text-align:center; background:#f8faf9; }

    .dashboard-tools { display:flex; justify-content:space-between; align-items:center; gap:14px; margin:24px 0 16px; }
    .summary { color:#68736d; font-size:14px; }
    .refresh { width:auto; height:42px; padding:0 16px; margin:0; background:#eef3f0; color:#17201b; border:1px solid #d8e1dc; }
    .stats { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin:0 0 14px; }
    .stat-card { width:100%; height:auto; min-height:76px; margin:0; padding:14px 16px; border:1px solid #dfe7e2; border-radius:14px; background:#f8faf9; color:#17201b; text-align:left; display:flex; align-items:center; justify-content:space-between; box-shadow:none; }
    .stat-card span { font-size:12px; color:#68736d; font-weight:800; }
    .stat-card strong { font-size:24px; line-height:1; }
    .stat-card:hover,.stat-card.active { background:#fff; border-color:#c8d6ce; }
    .stat-new strong { color:#9a6a00; }.stat-ordered strong { color:#245c9d; }.stat-delivered strong { color:#176640; }
    .order-toolbar { display:grid; grid-template-columns:minmax(280px,1fr) auto; gap:12px; align-items:center; margin-bottom:16px; padding:12px; border:1px solid #e1e8e4; border-radius:15px; background:#f8faf9; }
    .admin-search { position:relative; display:block; }
    .admin-search svg { position:absolute; left:14px; top:50%; transform:translateY(-50%); width:18px; height:18px; fill:none; stroke:#718078; stroke-width:2; stroke-linecap:round; }
    .admin-search input { width:100%; height:44px; padding:0 14px 0 43px; border:1px solid #d5dfda; border-radius:11px; background:#fff; color:#17201b; font:inherit; outline:none; }
    .admin-search input:focus { border-color:#8fb5a3; box-shadow:0 0 0 3px rgba(39,131,95,.08); }
    .filter-pills { display:flex; gap:6px; flex-wrap:wrap; }
    .filter-pill { width:auto; height:38px; margin:0; padding:0 12px; border:1px solid transparent; border-radius:10px; background:transparent; color:#66716b; font-size:12px; box-shadow:none; }
    .filter-pill:hover { background:#eef3f0; }
    .filter-pill.active { background:#111713; color:#fff; }
    .order-head { position:relative; padding-right:52px !important; }
    .order-head::after { content:"⌄"; position:absolute; right:18px; top:50%; transform:translateY(-54%); width:24px; height:24px; border-radius:50%; display:grid; place-items:center; background:#f1f5f3; color:#536059; font-size:17px; font-weight:900; transition:transform .18s ease,background .18s ease; }
    .order.open .order-head::after { transform:translateY(-46%) rotate(180deg); background:#e9f3ee; color:#207956; }
    .order { transition:border-color .18s ease, box-shadow .18s ease; }
    .order:hover { border-color:#cbd9d1; box-shadow:0 7px 20px rgba(16,32,23,.045); }
    .order.open { border-color:#bdd2c6; box-shadow:0 10px 28px rgba(16,32,23,.06); }
    .section-label { margin:17px 0 9px; font-size:10px; font-weight:900; letter-spacing:.8px; color:#77827c; text-transform:uppercase; }
    .management-box { margin-top:16px; padding:14px; border:1px solid #e1e8e4; border-radius:14px; background:#f8faf9; }
    .whatsapp { display:inline-flex; align-items:center; justify-content:center; height:44px; padding:0 15px; border-radius:11px; background:#edf8f2; border:1px solid #c9e5d6; color:#176640; font-weight:900; font-size:13px; text-decoration:none; white-space:nowrap; }
    .whatsapp:hover { background:#e3f4eb; }
    .no-results { padding:32px; text-align:center; border:1px dashed #d1dad5; border-radius:15px; color:#68736d; background:#f9fbfa; }
        .orders { display:grid; gap:14px; }
    .order { border:1px solid #dce5e0; border-radius:17px; overflow:hidden; background:#fff; }
    .order-head { width:100%; height:auto; margin:0; padding:17px 18px; border-radius:0; background:#fff; color:#101713; display:flex; align-items:center; justify-content:space-between; gap:18px; text-align:left; }
    .order-head:hover { background:#f7faf8; }
    .order-main { display:grid; gap:4px; }
    .order-number { font-weight:900; font-size:15px; }
    .order-name { display:block; font-weight:900; font-size:15px; color:#111713; margin-bottom:4px; }
    .order-client { font-size:13px; color:#6b756f; font-weight:500; }
    .order-right { display:flex; align-items:center; gap:14px; flex-shrink:0; }
    .order-total { font-weight:900; }
    .status { padding:6px 10px; border-radius:999px; font-size:11px; font-weight:900; text-transform:uppercase; letter-spacing:.3px; }
    .status.nuevo { background:#fff3d6; color:#7d5700; }
    .status.pedido { background:#e9f2ff; color:#245c9d; }
    .status.entregado { background:#e7f7ee; color:#176640; }
    .order-detail { display:none; padding:0 18px 18px; border-top:1px solid #edf1ef; }
    .order.open .order-detail { display:block; }
    .meta { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; padding:16px 0; }
    .meta-box { background:#f7faf8; border-radius:12px; padding:11px 12px; }
    .meta-box span { display:block; font-size:11px; color:#748079; margin-bottom:4px; }
    .meta-box strong { font-size:13px; }

    .detail-title { display:flex; justify-content:space-between; align-items:flex-end; gap:20px; padding:18px 0 4px; }
    .detail-title > div:first-child { display:grid; gap:3px; }
    .detail-title span { font-size:10px; font-weight:900; letter-spacing:.8px; color:#7a857f; }
    .detail-title strong { font-size:18px; color:#111713; }
    .detail-total { text-align:right; display:grid; gap:2px; }
    .detail-total strong { font-size:22px; }
    .item { position:relative; padding-top:38px !important; }
    .item-number { position:absolute; top:12px; left:12px; font-size:10px; font-weight:900; letter-spacing:.7px; color:#27835f; }

    .items { display:grid; gap:12px; }
    .item { display:grid; grid-template-columns:92px 1fr; gap:14px; border:1px solid #e1e8e4; border-radius:14px; padding:12px; }
    .item img { width:92px; height:112px; object-fit:cover; border-radius:10px; background:#111; }
    .item h3 { margin:0 0 7px; font-size:15px; }
    .item-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:5px 14px; font-size:12px; color:#59645e; }
    .item-grid b { color:#18201c; }
    .actions { display:grid; grid-template-columns:1fr auto; gap:12px; margin-top:16px; padding-top:16px; border-top:1px solid #edf1ef; }
    .state-select { height:44px; border:1px solid #ccd7d1; border-radius:11px; padding:0 12px; background:#fff; font:inherit; }
    .delete { width:auto; height:44px; margin:0; padding:0 15px; background:#fff5f5; color:#a41e1e; border:1px solid #efcaca; }
    .delete:hover { background:#ffeaea; }
    .empty, .loading, .dashboard-error { padding:28px; text-align:center; border:1px dashed #d1dad5; border-radius:15px; color:#68736d; background:#f9fbfa; }
    .dashboard-error { color:#a51d1d; border-color:#efcaca; background:#fff5f5; }
    @media(max-width:700px){
      .card{padding:23px}.panel-head{align-items:flex-start;flex-direction:column}.logout{width:100%}
      .meta{grid-template-columns:1fr}.item{grid-template-columns:72px 1fr}.item img{width:72px;height:90px}
      .item-grid{grid-template-columns:1fr}.order-right{gap:7px;flex-direction:column;align-items:flex-end}.actions{grid-template-columns:1fr}.delete{width:100%}
      .stats{grid-template-columns:repeat(2,1fr)}.order-toolbar{grid-template-columns:1fr}.filter-pills{display:grid;grid-template-columns:repeat(2,1fr)}.filter-pill{width:100%}
      .order-head{padding-right:46px!important}.order-client{line-height:1.5}.dashboard-tools{margin-top:18px}.whatsapp{width:100%}
    }
  </style>
</head>
<body>
  <main class="page">
    <section class="card" id="login-view">
      <div class="brand">
        <div class="mark">EJ</div>
        <div><strong>Elite Jerseys</strong><span>Área privada</span></div>
      </div>

      <h1>Administración</h1>
      <p class="intro">Acceso exclusivo para gestionar los pedidos de Elite Jerseys.</p>

      <form id="login-form">
        <div class="field">
          <label for="admin-email">Correo electrónico</label>
          <input id="admin-email" type="email" autocomplete="username" required />
        </div>
        <div class="field">
          <label for="admin-password">Contraseña</label>
          <input id="admin-password" type="password" autocomplete="current-password" required />
        </div>
        <button id="login-button" type="submit">Entrar al panel</button>
        <div id="login-message" class="message" role="status"></div>
      </form>

      <div class="footer">Página privada · No indexada</div>
    </section>

    <section class="panel" id="admin-view">
      <div class="panel-card">
        <div class="panel-head">
          <div>
            <div class="brand" style="margin-bottom:12px">
              <div class="mark">EJ</div>
              <div><strong>Elite Jerseys</strong><span>Panel de administración</span></div>
            </div>
            <h1>Pedidos</h1>
          </div>
          <button class="logout" id="logout-button" type="button">Cerrar sesión</button>
        </div>
        <div class="dashboard-tools">
          <div class="summary" id="orders-summary">Cargando pedidos…</div>
          <button class="refresh" id="refresh-button" type="button" title="Actualizar pedidos">↻ <span>Actualizar</span></button>
        </div>

        <div class="stats" aria-label="Resumen de pedidos">
          <button class="stat-card stat-all active" type="button" data-filter="Todos"><span>Total</span><strong id="stat-total">0</strong></button>
          <button class="stat-card stat-new" type="button" data-filter="Nuevo"><span>Nuevos</span><strong id="stat-new">0</strong></button>
          <button class="stat-card stat-ordered" type="button" data-filter="Pedido"><span>Pedidos</span><strong id="stat-ordered">0</strong></button>
          <button class="stat-card stat-delivered" type="button" data-filter="Entregado"><span>Entregados</span><strong id="stat-delivered">0</strong></button>
        </div>

        <div class="order-toolbar">
          <label class="admin-search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
            <input id="order-search" type="search" placeholder="Buscar por cliente, teléfono o n.º de pedido…" autocomplete="off" />
          </label>
          <div class="filter-pills" aria-label="Filtrar pedidos">
            <button class="filter-pill active" type="button" data-filter="Todos">Todos</button>
            <button class="filter-pill" type="button" data-filter="Nuevo">Nuevos</button>
            <button class="filter-pill" type="button" data-filter="Pedido">Pedidos</button>
            <button class="filter-pill" type="button" data-filter="Entregado">Entregados</button>
          </div>
        </div>

        <div class="orders" id="orders-list">
          <div class="loading">Cargando pedidos…</div>
        </div>
      </div>
    </section>
  </main>

  
<style is:global>
/* V9 PC · Elite Jerseys */
@media (min-width:701px){
body{background:#f3f6f4}
.stats{gap:12px!important}
.stat-card{min-height:82px!important;border-radius:15px!important;box-shadow:0 3px 10px rgba(17,23,19,.025)!important}
.stat-all{background:#fff!important}
.stat-new{background:#fffaf0!important;border-color:#f1e2bb!important}
.stat-ordered{background:#f3f7fd!important;border-color:#dbe6f5!important}
.stat-delivered{background:#f1f9f5!important;border-color:#d7ebdf!important}
.stat-new strong{color:#a46d00!important}.stat-ordered strong{color:#245c9d!important}.stat-delivered strong{color:#176640!important}
.order-toolbar{background:#f8faf9!important;border-color:#dfe7e2!important}
.filter-pill.active{background:#111713!important;color:#fff!important;box-shadow:0 4px 10px rgba(17,23,19,.10)!important}
.order{position:relative;overflow:hidden;background:#fff!important;border-color:#dbe4df!important;box-shadow:0 5px 16px rgba(17,23,19,.025)}
.order::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:#d9dfdc;z-index:2}
.order:has(.status-new)::before{background:#d9a321}.order:has(.status-ordered)::before{background:#3976bd}.order:has(.status-delivered)::before{background:#2c9668}
.order.open{box-shadow:0 12px 30px rgba(17,23,19,.06)!important}
.order-head{min-height:78px;padding-right:58px!important}
.order-name{font-size:15px!important;margin-bottom:5px!important}.order-client{color:#66726b!important}.order-right{gap:12px!important}.order-total{font-size:16px!important;min-width:64px;text-align:right}.order-head::after{right:15px!important}
.section-label{margin:18px 0 9px!important;color:#707b75!important;letter-spacing:1px!important}
.section-label::before{content:"";display:inline-block;width:15px;height:2px;margin-right:7px;vertical-align:middle;background:#dfbd68;border-radius:99px}
.meta{gap:10px!important}.meta-box{background:#f6f8f7!important;border:1px solid #edf1ef;border-radius:12px!important}
.item{grid-template-columns:112px 1fr!important;grid-template-rows:auto auto;gap:10px 18px!important;padding:14px!important;border-color:#dfe6e2!important;background:#fff!important;padding-top:14px!important}
.item-number{position:static!important;grid-column:1/-1;grid-row:1;margin:0!important;padding:0 0 8px!important;border-bottom:1px solid #edf1ef;font-size:10px!important;font-weight:900!important;letter-spacing:.7px!important;color:#27835f!important}
.item img{grid-column:1;grid-row:2;width:112px!important;height:136px!important;object-fit:cover!important;border-radius:11px!important;background:#111713;cursor:zoom-in;transition:transform .15s ease,box-shadow .15s ease}
.item img:hover{transform:translateY(-1px);box-shadow:0 7px 18px rgba(17,23,19,.14)}
.item>div:last-child{grid-column:2;grid-row:2}
.item h3{font-size:16px!important;margin-bottom:9px!important}.item-grid{row-gap:7px!important;column-gap:24px!important}
.item-grid span:last-child{margin-top:5px;padding-top:8px;border-top:1px solid #e8eeea;color:#536059}.item-grid span:last-child b{color:#111713;font-size:14px}
.management-box{background:#f7f9f8!important;border-color:#dfe7e2!important;padding:14px!important}
.management-box .actions{grid-template-columns:minmax(280px,1fr) auto auto!important;align-items:center;gap:10px!important}
.state-select{height:44px!important;background:#fff!important;border-color:#cfdad4!important}
.whatsapp{height:44px!important;background:#edf8f2!important;border-color:#c9e5d6!important;color:#176640!important;padding:0 16px!important}
.whatsapp::before{content:"✆";margin-right:7px;font-size:16px}
.delete{width:auto!important;height:44px!important;margin:0!important;padding:0 14px!important;background:#fff7f6!important;border:1px solid #efc9c5!important;color:#b52b24!important;border-radius:11px!important;box-shadow:none!important;white-space:nowrap}
.delete:hover{background:#fff0ee!important}
.detail-title>div:first-child::after{content:"";display:block;width:34px;height:2px;margin-top:8px;background:#dfbd68;border-radius:99px}


/* V11 PC · gestión y estados finales */
@media (min-width:701px){
  .state-select.state-nuevo{background:#fff9ea!important;border-color:#ead7a0!important;color:#8a5b00!important;font-weight:850}
  .state-select.state-pedido{background:#f2f7fd!important;border-color:#cadcf2!important;color:#245c9d!important;font-weight:850}
  .state-select.state-entregado{background:#eff8f3!important;border-color:#c8e3d4!important;color:#176640!important;font-weight:850}
  .refresh.is-loading{opacity:.72;pointer-events:none}
  .refresh.is-loading::first-letter{display:inline-block}
  .management-feedback{min-height:18px;margin-top:8px;font-size:11px;font-weight:800;color:#27835f}
  .management-feedback.error{color:#b52b24}
  .empty-state{padding:42px 24px;text-align:center;border:1px dashed #ccd8d1;border-radius:16px;background:#fafcfb}
  .empty-state strong{display:block;margin-bottom:6px;font-size:16px;color:#17201b}
  .empty-state span{font-size:12px;color:#6d7872}
}
/* Visor grande de camiseta */
.admin-lightbox{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;padding:34px;background:rgba(5,9,7,.88);backdrop-filter:blur(5px)}
.admin-lightbox.open{display:flex}
.admin-lightbox-inner{position:relative;display:flex;align-items:center;justify-content:center;max-width:min(92vw,1050px);max-height:92vh}
.admin-lightbox-image{display:block;max-width:min(82vw,850px);max-height:86vh;width:auto;height:auto;object-fit:contain;border-radius:14px;box-shadow:0 24px 70px rgba(0,0,0,.45)}
.admin-lightbox-close{position:absolute;top:-18px;right:-18px;width:44px;height:44px;margin:0;border:1px solid rgba(255,255,255,.18);border-radius:50%;display:grid;place-items:center;background:#fff;color:#111713;font-size:25px;font-weight:500;line-height:1;box-shadow:0 8px 24px rgba(0,0,0,.22)}
.admin-lightbox-close:hover{background:#f1f4f2}
.admin-lightbox-caption{position:absolute;left:50%;bottom:-28px;transform:translateX(-50%);color:#fff;font-size:13px;font-weight:750;white-space:nowrap;text-shadow:0 2px 10px rgba(0,0,0,.6)}
}
</style>

<div class="admin-lightbox" id="admin-lightbox" aria-hidden="true">
  <div class="admin-lightbox-inner">
    <button class="admin-lightbox-close" id="admin-lightbox-close" type="button" aria-label="Cerrar visor">×</button>
    <img class="admin-lightbox-image" id="admin-lightbox-image" src="" alt="">
    <div class="admin-lightbox-caption" id="admin-lightbox-caption"></div>
  </div>
</div>

<script>
    import { createClient } from "@supabase/supabase-js";

    const supabaseUrl = document.querySelector('meta[name="ej-supabase-url"]')?.getAttribute("content") || "";
    const supabaseKey = document.querySelector('meta[name="ej-supabase-key"]')?.getAttribute("content") || "";

    const loginView = document.querySelector("#login-view");
    const adminView = document.querySelector("#admin-view");
    const form = document.querySelector("#login-form");
    const email = document.querySelector("#admin-email");
    const password = document.querySelector("#admin-password");
    const button = document.querySelector("#login-button");
    const message = document.querySelector("#login-message");
    const logout = document.querySelector("#logout-button");

    function showLogin() {
      loginView.style.display = "block";
      adminView.style.display = "none";
    }

    function showAdmin() {
      loginView.style.display = "none";
      adminView.style.display = "block";
    }

    function setMessage(text = "", type = "") {
      message.textContent = text;
      message.className = type ? `message ${type}` : "message";
    }

    if (!supabaseUrl || !supabaseKey) {
      setMessage("Falta la configuración de Supabase.", "error");
    } else {
      const supabase = createClient(supabaseUrl, supabaseKey);
      const ordersList = document.querySelector("#orders-list");
      const ordersSummary = document.querySelector("#orders-summary");
      const refreshButton = document.querySelector("#refresh-button");
      const orderSearch = document.querySelector("#order-search");
      const statTotal = document.querySelector("#stat-total");
      const statNew = document.querySelector("#stat-new");
      const statOrdered = document.querySelector("#stat-ordered");
      const statDelivered = document.querySelector("#stat-delivered");
      const adminLightbox = document.querySelector("#admin-lightbox");
      const adminLightboxImage = document.querySelector("#admin-lightbox-image");
      const adminLightboxCaption = document.querySelector("#admin-lightbox-caption");
      const adminLightboxClose = document.querySelector("#admin-lightbox-close");
      let allOrders = [];
      let activeFilter = "Todos";

      const esc = (value) => String(value ?? "")
        .replaceAll("&", "&amp;").replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;").replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

      const imageSrc = (path) => {
        const value = String(path || "");
        if (!value) return "";
        if (/^https?:\/\//i.test(value)) return value;
        return new URL(value, window.location.origin).href;
      };

      const statusClass = (state) => {
        const s = String(state || "Nuevo").toLowerCase();
        return s === "entregado" ? "entregado" : s === "pedido" ? "pedido" : "nuevo";
      };

      const normalize = (value) => String(value || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

      function updateStats() {
        statTotal.textContent = allOrders.length;
        statNew.textContent = allOrders.filter(o => (o.estado || "Nuevo") === "Nuevo").length;
        statOrdered.textContent = allOrders.filter(o => o.estado === "Pedido").length;
        statDelivered.textContent = allOrders.filter(o => o.estado === "Entregado").length;
        ordersSummary.textContent = `${allOrders.length} pedido${allOrders.length === 1 ? "" : "s"} almacenado${allOrders.length === 1 ? "" : "s"}`;
      }

      function syncFilterButtons() {
        document.querySelectorAll("[data-filter]").forEach(btn => btn.classList.toggle("active", btn.dataset.filter === activeFilter));
      }

      function renderOrders() {
        const q = normalize(orderSearch?.value);
        const filtered = allOrders.filter(order => {
          const state = order.estado || "Nuevo";
          const matchesState = activeFilter === "Todos" || state === activeFilter;
          const haystack = normalize(`${order.nombre_cliente} ${order.telefono} ${order.numero_pedido}`);
          return matchesState && (!q || haystack.includes(q));
        });

        if (!filtered.length) {
          const hasAny = allOrders.length > 0;
          ordersList.innerHTML = hasAny
            ? '<div class="empty-state"><strong>No hay resultados</strong><span>Prueba con otra búsqueda o cambia el filtro seleccionado.</span></div>'
            : '<div class="empty-state"><strong>Todavía no hay pedidos</strong><span>Los nuevos pedidos aparecerán aquí automáticamente.</span></div>';
          return;
        }

        ordersList.innerHTML = filtered.map((order) => {
          const items = order.articulos_pedido || [];
          const units = items.reduce((sum, item) => sum + Number(item.cantidad || 1), 0);
          const state = order.estado || "Nuevo";
          const dateObj = order.creado_en ? new Date(order.creado_en) : null;
          const created = dateObj ? dateObj.toLocaleString("es-ES", {day:"2-digit",month:"2-digit",year:"numeric",hour:"2-digit",minute:"2-digit"}).replace(",", " ·") : "—";
          const shortDate = dateObj ? dateObj.toLocaleDateString("es-ES", {day:"2-digit",month:"2-digit",year:"numeric"}) : "—";
          const phoneDigits = String(order.telefono || "").replace(/\D/g, "");
          const waPhone = phoneDigits.startsWith("34") ? phoneDigits : `34${phoneDigits}`;
          const waText = encodeURIComponent(`Hola ${order.nombre_cliente || ""}, te contacto de Elite Jerseys sobre tu pedido ${order.numero_pedido || ""}.`);
          return `
            <article class="order" data-id="${esc(order.id)}">
              <button class="order-head" type="button" data-toggle>
                <span class="order-main">
                  <span class="order-name">${esc(order.nombre_cliente)}</span>
                  <span class="order-client">N.º pedido: ${esc(order.numero_pedido)} · ${esc(order.telefono)} · ${units} unidad${units === 1 ? "" : "es"} · ${esc(shortDate)}</span>
                </span>
                <span class="order-right">
                  <span class="status ${statusClass(state)}">${esc(state)}</span>
                  <span class="order-total">${Number(order.total || 0).toFixed(2)} €</span>
                </span>
              </button>
              <div class="order-detail">
                <div class="detail-title">
                  <div><span>DETALLE DEL PEDIDO</span><strong>${esc(order.numero_pedido)}</strong></div>
                  <div class="detail-total"><span>Total</span><strong>${Number(order.total || 0).toFixed(2)} €</strong></div>
                </div>
                <div class="section-label">Datos del cliente</div>
                <div class="meta">
                  <div class="meta-box"><span>Cliente</span><strong>${esc(order.nombre_cliente)}</strong></div>
                  <div class="meta-box"><span>Teléfono</span><strong>${esc(order.telefono)}</strong></div>
                  <div class="meta-box"><span>Fecha</span><strong>${esc(created)}</strong></div>
                </div>
                <div class="section-label">Artículos · ${units} unidad${units === 1 ? "" : "es"}</div>
                <div class="items">
                  ${items.map((item, index) => `
                    <div class="item">
                      <div class="item-number">ARTÍCULO ${index + 1}</div>
                      ${item.imagen_url ? `<img src="${esc(imageSrc(item.imagen_url))}" alt="${esc(item.equipo)}" loading="lazy" data-product-image data-team="${esc(item.equipo)}">` : '<div></div>'}
                      <div>
                        <h3>${esc(item.equipo)}</h3>
                        <div class="item-grid">
                          <span>Temporada: <b>${esc(item.temporada || "—")}</b></span>
                          <span>Tipo: <b>${esc(item.tipo_camiseta || "—")}</b></span>
                          <span>Producto: <b>${esc(item.producto || "—")}</b></span>
                          <span>Versión: <b>${esc(item.version || "—")}</b></span>
                          <span>Talla: <b>${esc(item.talla || "—")}</b></span>
                          <span>Cantidad: <b>${esc(item.cantidad || 1)}</b></span>
                          <span>Nombre + dorsal: <b>${item.nombre_dorsal ? `${esc(item.nombre_personalizado || "")} ${esc(item.dorsal || "")}` : "No"}</b></span>
                          <span>Parches: <b>${item.parches ? esc(item.tipo_parche || "Sí") : "No"}</b></span>
                          <span>Importe: <b>${Number(item.importe || 0).toFixed(2)} €</b></span>
                        </div>
                      </div>
                    </div>`).join("")}
                </div>
                <div class="section-label">Gestión del pedido</div>
                <div class="management-box">
                  <div class="actions" style="margin-top:0;padding-top:0;border-top:0">
                    <select class="state-select state-${normalize(state)}" data-state aria-label="Estado del pedido">
                      ${["Nuevo","Pedido","Entregado"].map(s => `<option value="${s}" ${s === state ? "selected" : ""}>${s}</option>`).join("")}
                    </select>
                    ${phoneDigits ? `<a class="whatsapp" href="https://wa.me/${esc(waPhone)}?text=${waText}" target="_blank" rel="noopener">Contactar por WhatsApp</a>` : ""}
                    <button class="delete" type="button" data-delete>Eliminar pedido</button>
                  </div>
                  <div class="management-feedback" data-feedback aria-live="polite"></div>
                </div>
              </div>
            </article>`;
        }).join("");
      }

      async function loadOrders() {
        refreshButton?.classList.add("is-loading");
        if (refreshButton) refreshButton.innerHTML = '↻ <span>Actualizando…</span>';
        ordersList.innerHTML = '<div class="loading">Cargando pedidos…</div>';
        const { data, error } = await supabase
          .from("pedidos")
          .select("*, articulos_pedido(*)")
          .order("creado_en", { ascending: false });

        if (error) {
          console.error("[Elite Jerseys Admin] Error cargando pedidos:", error);
          ordersSummary.textContent = "No se han podido cargar los pedidos";
          ordersList.innerHTML = `<div class="dashboard-error">${esc(error.message)}</div>`;
          refreshButton?.classList.remove("is-loading");
          if (refreshButton) refreshButton.innerHTML = '↻ <span>Actualizar</span>';
          return;
        }

        allOrders = data || [];
        updateStats();
        syncFilterButtons();
        renderOrders();
        refreshButton?.classList.remove("is-loading");
        if (refreshButton) refreshButton.innerHTML = '↻ <span>Actualizar</span>';
      }

      document.querySelectorAll("[data-filter]").forEach(btn => {
        btn.addEventListener("click", () => {
          activeFilter = btn.dataset.filter || "Todos";
          syncFilterButtons();
          renderOrders();
        });
      });
      orderSearch?.addEventListener("input", renderOrders);

      ordersList.addEventListener("click", async (event) => {
        const order = event.target.closest(".order");
        if (!order) return;

        const productImage = event.target.closest("[data-product-image]");
        if (productImage) {
          adminLightboxImage.src = productImage.src;
          adminLightboxImage.alt = productImage.alt || "Camiseta";
          adminLightboxCaption.textContent = productImage.dataset.team || productImage.alt || "";
          adminLightbox.classList.add("open");
          adminLightbox.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
          return;
        }

        if (event.target.closest("[data-toggle]")) {
          const willOpen = !order.classList.contains("open");
          ordersList.querySelectorAll(".order.open").forEach(card => {
            if (card !== order) card.classList.remove("open");
          });
          order.classList.toggle("open", willOpen);
          return;
        }

        if (event.target.closest("[data-delete]")) {
          if (!confirm("¿Eliminar definitivamente este pedido y todos sus artículos?")) return;
          const id = order.dataset.id;
          const { error: itemsError } = await supabase.from("articulos_pedido").delete().eq("pedido_id", id);
          if (itemsError) return alert(`No se han podido eliminar los artículos: ${itemsError.message}`);
          const { error } = await supabase.from("pedidos").delete().eq("id", id);
          if (error) return alert(`No se ha podido eliminar el pedido: ${error.message}`);
          await loadOrders();
        }
      });

      ordersList.addEventListener("change", async (event) => {
      });


      // V12 · cambio de estado inmediato y sincronizado
      ordersList.addEventListener("change", async (event) => {
        const select = event.target.closest("[data-state]");
        if (!select) return;

        const order = select.closest(".order");
        if (!order) return;

        const orderId = order.dataset.id;
        const currentOrder = allOrders.find(item => String(item.id) === String(orderId));
        const previous = currentOrder?.estado || "Nuevo";
        const next = select.value;
        const feedback = order.querySelector("[data-feedback]");

        select.disabled = true;
        if (feedback) {
          feedback.classList.remove("error");
          feedback.textContent = "Guardando cambio…";
        }

        const { error } = await supabase
          .from("pedidos")
          .update({ estado: next })
          .eq("id", orderId);

        select.disabled = false;

        if (error) {
          select.value = previous;
          select.className = `state-select state-${normalize(previous)}`;
          if (feedback) {
            feedback.classList.add("error");
            feedback.textContent = "No se ha podido guardar el cambio.";
          }
          console.error("[Elite Jerseys Admin] Error cambiando estado:", error);
          return;
        }

        if (currentOrder) currentOrder.estado = next;

        select.className = `state-select state-${normalize(next)}`;

        const badge = order.querySelector(".status");
        if (badge) {
          badge.textContent = next;
          badge.className = `status ${statusClass(next)}`;
        }

        updateStats();

        if (feedback) {
          feedback.classList.remove("error");
          feedback.textContent = `Estado actualizado a ${next}.`;
          window.setTimeout(() => {
            if (feedback.textContent === `Estado actualizado a ${next}.`) {
              feedback.textContent = "";
            }
          }, 2200);
        }

        // Si estamos viendo un filtro concreto y el pedido deja de pertenecer a él,
        // se retira del listado después de confirmar Supabase.
        if (activeFilter !== "Todos" && activeFilter !== next) {
          renderOrders();
        }
      });

      function closeAdminLightbox() {
        adminLightbox.classList.remove("open");
        adminLightbox.setAttribute("aria-hidden", "true");
        adminLightboxImage.src = "";
        adminLightboxCaption.textContent = "";
        document.body.style.overflow = "";
      }

      adminLightboxClose?.addEventListener("click", closeAdminLightbox);
      adminLightbox?.addEventListener("click", (event) => {
        if (event.target === adminLightbox) closeAdminLightbox();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && adminLightbox?.classList.contains("open")) closeAdminLightbox();
      });

      refreshButton.addEventListener("click", loadOrders);

      const { data: { session } } = await supabase.auth.getSession();

      if (session) {
        loginView.style.display = "none";
        adminView.style.display = "block";
        await loadOrders();
      } else {
        showLogin();
      }

      supabase.auth.onAuthStateChange((event, currentSession) => {
        if (!currentSession) {
          showLogin();
          return;
        }

        // Al iniciar sesión cargamos los pedidos una sola vez.
        if (event === "SIGNED_IN") {
          loginView.style.display = "none";
          adminView.style.display = "block";
          loadOrders();
        }
      });

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        setMessage();
        button.disabled = true;
        button.textContent = "Comprobando acceso…";

        const { error } = await supabase.auth.signInWithPassword({
          email: email.value.trim(),
          password: password.value
        });

        if (error) {
          setMessage("Correo o contraseña incorrectos.", "error");
          password.value = "";
          password.focus();
        } else {
          setMessage("Acceso correcto.", "ok");
          showAdmin();
          allOrders = allOrders.filter(item => String(item.id) !== String(order.dataset.id));
        updateStats();
        renderOrders();
        }

        button.disabled = false;
        button.textContent = "Entrar al panel";
      });

      logout.addEventListener("click", async () => {
        await supabase.auth.signOut();
        password.value = "";
        setMessage();
        showLogin();
      });
    }
  </script>
</body>
</html>
