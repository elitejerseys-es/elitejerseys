---
import fs from "node:fs";
import path from "node:path";

import {
  categorias,
  crearSlug,
  obtenerEscudo
} from "../data/catalogo";

const totalEquipos = categorias.reduce(
  (total, categoria) => total + categoria.equipos.length,
  0
);

const carpetaCamisetas = path.join(
  process.cwd(),
  "public",
  "camisetas"
);

const extensionesCompatibles = /\.(jpg|jpeg|png|webp)$/i;
const patronCamiseta = /^\d{4}-\d{4}-.+\.(jpg|jpeg|png|webp)$/i;

const obtenerNombresBaseUnicos = (rutaEquipo: string) => {
  if (!fs.existsSync(rutaEquipo)) return new Set<string>();

  const nombresBase = new Set<string>();

  for (const entrada of fs.readdirSync(rutaEquipo, { withFileTypes: true })) {
    if (!entrada.isFile() || !patronCamiseta.test(entrada.name)) continue;

    nombresBase.add(
      entrada.name
        .replace(extensionesCompatibles, "")
        .toLowerCase()
    );
  }

  return nombresBase;
};

const camisetasPorEquipo = new Map<string, number>();

for (const categoria of categorias) {
  for (const equipo of categoria.equipos) {
    const slug = crearSlug(equipo);
    const rutaEquipo = path.join(carpetaCamisetas, slug);
    camisetasPorEquipo.set(slug, obtenerNombresBaseUnicos(rutaEquipo).size);
  }
}

const totalCamisetas = [...camisetasPorEquipo.values()].reduce(
  (total, cantidad) => total + cantidad,
  0
);

const categoriasConMetricas = categorias.map((categoria) => {
  const camisetas = categoria.equipos.reduce(
    (total, equipo) =>
      total + (camisetasPorEquipo.get(crearSlug(equipo)) ?? 0),
    0
  );

  return {
    ...categoria,
    camisetas
  };
});

const categoriasOrdenadas = categoriasConMetricas.map((categoria) => ({
  ...categoria,
  equipos: categoria.equipos
    .slice()
    .sort((a, b) => a.localeCompare(b, "es"))
}));

const aliasEquipos: Record<string, string[]> = {
  "paris-saint-germain": ["psg", "paris sg"],
  "olympique-de-marseille": ["om", "marseille"],
  "olympique-lyonnais": ["lyon", "ol"],
  "manchester-united": ["man united", "man utd", "united"],
  "manchester-city": ["man city", "city"],
  "tottenham-hotspur": ["tottenham", "spurs"],
  "wolverhampton-wanderers": ["wolves"],
  "brighton-and-hove-albion": ["brighton"],
  "bayern-munich": ["bayern", "bayern munchen"],
  "borussia-monchengladbach": ["gladbach"],
  "inter": ["inter milan", "internazionale"],
  "ac-milan": ["milan"],
  "juventus": ["juve"],
  "fc-barcelona": ["barca", "barcelona"],
  "real-madrid": ["madrid"],
  "atletico-de-madrid": ["atleti", "atletico"],
  "athletic-club": ["athletic", "bilbao"]
};

const indiceEquipos = categoriasOrdenadas.flatMap((categoria) =>
  categoria.equipos.map((equipo) => {
    const slug = crearSlug(equipo);
    const alias = aliasEquipos[slug] ?? [];

    return {
      nombre: equipo,
      nombreNormalizado: [equipo, ...alias]
        .join(" ")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, ""),
      slug,
      href: `/equipos/${slug}`,
      escudo: obtenerEscudo(equipo),
      categoria: categoria.nombre,
      camisetas: camisetasPorEquipo.get(slug) ?? 0
    };
  })
);

const tituloPagina = "Elite Jerseys | Catálogo de camisetas de fútbol";
const descripcionPagina =
  `Explora ${totalCamisetas} camisetas de ${totalEquipos} equipos, organizadas por liga, temporada y tipo de equipación.`;

const canonicalUrl = new URL("/", Astro.site).href;
const imagenSocial = new URL(
  "/images/logo-elite-jerseys.png",
  Astro.site
).href;

const datosEstructurados = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Elite Jerseys",
  description: descripcionPagina,
  url: canonicalUrl,
  primaryImageOfPage: imagenSocial,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: totalEquipos,
    itemListElement: indiceEquipos.map((item, indice) => ({
      "@type": "ListItem",
      position: indice + 1,
      name: item.nombre,
      url: new URL(item.href, Astro.site).href
    }))
  }
};

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="description" content={descripcionPagina} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#111713" />

    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="preload"
      href="/images/logo-elite-jerseys.png"
      as="image"
      fetchpriority="high"
    />
    <link rel="dns-prefetch" href="//fonts.googleapis.com" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Elite Jerseys" />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descripcionPagina} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imagenSocial} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloPagina} />
    <meta name="twitter:description" content={descripcionPagina} />
    <meta name="twitter:image" content={imagenSocial} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(datosEstructurados)}
    />

    <title>{tituloPagina}</title>
  </head>

  <body>
    <a class="saltar-contenido" href="#contenido-principal">
      Saltar al contenido
    </a>

    <header class="cabecera">
      <div class="contenedor cabecera-interior">
        <a href="/" class="marca" aria-label="Página de inicio">
          <span class="marca-icono">
            <img
              src="/images/logo-elite-jerseys.png"
              alt=""
              width="46"
              height="46"
              decoding="async"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
            />
            <span class="marca-icono-fallback">EJ</span>
          </span>

          <span class="marca-texto">
            <strong>Elite Jerseys</strong>
            <small>Catálogo de camisetas de fútbol</small>
          </span>
        </a>
      </div>
    </header>

    <main id="contenido-principal">
      <section class="hero">
        <div class="contenedor hero-interior">
          <div class="hero-contenido">
            <span class="etiqueta-superior">
              CATÁLOGO INDEPENDIENTE
            </span>

            <h1>
              Camisetas de fútbol,
              <span>organizadas para explorar.</span>
            </h1>

            <p>
              Descubre clubes y selecciones por liga, equipo,
              temporada y tipo de equipación.
            </p>

            <div class="hero-acciones">
              <a href="#catalogo" class="boton boton-principal">
                Explorar catálogo
              </a>

              <a href="#buscar" class="boton boton-secundario">
                Buscar equipo
              </a>
            </div>
          </div>

          <div class="hero-visual" aria-hidden="true">
            <div class="hero-tarjeta">
              <div class="hero-marca">
                <span class="corona">♛</span>
                <strong>EJ</strong>
                <span>ELITE</span>
                <small>JERSEYS</small>
              </div>

              <div class="hero-categorias">
                {
                  categoriasOrdenadas.slice(0, 5).map((categoria) => (
                    <div class="hero-categoria">
                      <img
                        src={categoria.logo}
                        alt=""
                        width="28"
                        height="28"
                        loading="lazy"
                        decoding="async"
                      />
                      <span>{categoria.nombre}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="catalogo" class="catalogo contenedor">
        <div class="seccion-cabecera">
          <div>
            <span class="etiqueta-seccion">CATÁLOGO</span>
            <h2>Ligas y selecciones</h2>

            <p>
              Abre una categoría para consultar todos sus equipos.
            </p>
          </div>
        </div>

        <div id="buscar" class="buscador-contenedor">
          <div class="buscador-cabecera">
            <div>
              <span class="etiqueta-busqueda">BUSCADOR</span>
              <h3>Encuentra tu equipo</h3>
            </div>

            <span class="atajo-teclado"><kbd>/</kbd> para buscar</span>
          </div>

          <div class="buscador">
            <span class="icono-busqueda" aria-hidden="true">⌕</span>

            <input
              id="buscador-equipos"
              type="search"
              placeholder="Real Madrid, Arsenal, Milan, España..."
              autocomplete="off"
              aria-label="Buscar equipo"
              aria-controls="resultados-directos"
              aria-describedby="resultado-busqueda"
              enterkeyhint="search"
              spellcheck="false"
            />

            <button
              id="limpiar-buscador"
              type="button"
              aria-label="Borrar búsqueda"
              hidden
            >
              ×
            </button>
          </div>

          <p
            id="resultado-busqueda"
            class="resultado-busqueda"
            aria-live="polite"
          >
            Escribe el nombre de un equipo para encontrarlo rápidamente.
          </p>

          <div
            id="resultados-directos"
            class="resultados-directos"
            role="listbox"
            aria-label="Resultados de búsqueda"
            hidden
          ></div>
        </div>

        <section class="categorias">
          {
            categoriasOrdenadas.map((categoria, indice) => (
              <article
                class="categoria"
                data-categoria={categoria.nombre.toLowerCase()}
                data-slug={categoria.slug}
                style={`--indice:${indice}; --categoria-color:${["#ef4444","#6b21a8","#2563eb","#111827","#dc2626","#0f766e"][indice] ?? "#16805a"}`}
              >
                <button
                  class="categoria-cabecera"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`equipos-${categoria.slug}`}
                  id={`boton-${categoria.slug}`}
                >
                  <div class="categoria-info">
                    <div class="logo-liga">
                      <img
                        src={categoria.logo}
                        alt={`Logotipo de ${categoria.nombre}`}
                        width="46"
                        height="46"
                        loading="lazy"
                        decoding="async"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                      />

                      <span class="logo-provisional">⚽</span>
                    </div>

                    <span class="categoria-textos">
                      <strong>{categoria.nombre}</strong>

                      <small>
                        {categoria.equipos.length} equipos · {categoria.camisetas} camisetas
                      </small>
                    </span>
                  </div>

                  <div class="categoria-vista-previa" aria-hidden="true">
                    {
                      categoria.equipos.slice(0, 6).map((equipo) => (
                        <span class="mini-escudo">
                          <img
                            src={obtenerEscudo(equipo)}
                            alt=""
                            width="27"
                            height="27"
                            loading="lazy"
                            decoding="async"
                            onerror="this.style.display='none'"
                          />
                        </span>
                      ))
                    }
                  </div>

                  <span class="categoria-derecha">
                                        <span class="flecha">⌄</span>
                  </span>
                </button>

                <div
                  id={`equipos-${categoria.slug}`}
                  class="equipos"
                  role="region"
                  aria-labelledby={`boton-${categoria.slug}`}
                  hidden
                >
                  {
                    categoria.equipos.map((equipo) => (
                      <a
                        class="equipo"
                        href={`/equipos/${crearSlug(equipo)}`}
                        data-equipo={equipo.toLowerCase()}
                      >
                        <div class="escudo">
                          <img
                            src={obtenerEscudo(equipo)}
                            alt={`Escudo de ${equipo}`}
                            width="36"
                            height="36"
                            loading="lazy"
                            decoding="async"
                            onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                          />

                          <span class="escudo-provisional">
                            {equipo.charAt(0)}
                          </span>
                        </div>

                        <span class="nombre-equipo">{equipo}</span>
                        <span class="flecha-equipo">›</span>
                      </a>
                    ))
                  }
                </div>
              </article>
            ))
          }
        </section>

        <div id="sin-resultados" class="sin-resultados" hidden>
          <span>⚽</span>
          <h3>No se encontraron equipos</h3>
          <p>Prueba con otro nombre o elimina la búsqueda.</p>
        </div>
      </section>
    </main>

    <footer class="pie">
      <div class="contenedor pie-interior">
        <div>
          <strong>Elite Jerseys</strong>
          <p>Catálogo independiente de camisetas de fútbol.</p>
        </div>

        <a href="#">Volver arriba ↑</a>
      </div>
    </footer>

    <script
      id="indice-equipos"
      type="application/json"
      set:html={JSON.stringify(indiceEquipos)}
    />

    <script>
      interface EquipoIndice {
        nombre: string;
        nombreNormalizado: string;
        slug: string;
        href: string;
        escudo: string;
        categoria: string;
        camisetas: number;
      }

      const botonesCategoria =
        document.querySelectorAll<HTMLButtonElement>(
          ".categoria-cabecera"
        );

      const categoriasElementos =
        document.querySelectorAll<HTMLElement>(".categoria");

      const buscador =
        document.querySelector<HTMLInputElement>(
          "#buscador-equipos"
        );

      const botonLimpiar =
        document.querySelector<HTMLButtonElement>(
          "#limpiar-buscador"
        );

      const textoResultado =
        document.querySelector<HTMLElement>(
          "#resultado-busqueda"
        );

      const sinResultados =
        document.querySelector<HTMLElement>(
          "#sin-resultados"
        );

      const resultadosDirectos =
        document.querySelector<HTMLElement>(
          "#resultados-directos"
        );

      const indiceElemento =
        document.querySelector<HTMLScriptElement>(
          "#indice-equipos"
        );

      let indiceEquipos: EquipoIndice[] = [];
      let indiceResultadoActivo = -1;

      try {
        indiceEquipos = JSON.parse(
          indiceElemento?.textContent ?? "[]"
        );
      } catch {
        indiceEquipos = [];
      }

      const normalizarTexto = (texto: string) =>
        texto
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/\s+/g, " ")
          .trim();

      const claveCategorias =
        "elite-jerseys:categorias-abiertas";

      const obtenerCategoriasGuardadas = (): string[] => {
        try {
          return JSON.parse(
            localStorage.getItem(claveCategorias) ?? "[]"
          );
        } catch {
          return [];
        }
      };

      const guardarCategoriasAbiertas = () => {
        const abiertas = [...categoriasElementos]
          .filter((categoria) => {
            const boton =
              categoria.querySelector<HTMLButtonElement>(
                ".categoria-cabecera"
              );

            return boton?.getAttribute("aria-expanded") === "true";
          })
          .map((categoria) => categoria.dataset.slug ?? "")
          .filter(Boolean);

        localStorage.setItem(
          claveCategorias,
          JSON.stringify(abiertas)
        );
      };

      const establecerCategoria = (
        boton: HTMLButtonElement,
        abierta: boolean,
        guardar = true
      ) => {
        boton.setAttribute(
          "aria-expanded",
          String(abierta)
        );

        const idContenido =
          boton.getAttribute("aria-controls");

        const contenido = idContenido
          ? document.getElementById(idContenido)
          : boton.nextElementSibling;

        if (contenido instanceof HTMLElement) {
          contenido.hidden = !abierta;
        }

        if (guardar) guardarCategoriasAbiertas();
      };

      const cerrarCategorias = (
        excepcion?: HTMLButtonElement
      ) => {
        botonesCategoria.forEach((boton) => {
          if (boton !== excepcion) {
            establecerCategoria(boton, false, false);
          }
        });

        guardarCategoriasAbiertas();
      };

      botonesCategoria.forEach((boton) => {
        boton.addEventListener("click", () => {
          const abierta =
            boton.getAttribute("aria-expanded") === "true";

          establecerCategoria(boton, !abierta);
        });
      });


      const categoriasGuardadas =
        new Set(obtenerCategoriasGuardadas());

      categoriasElementos.forEach((categoria) => {
        const boton =
          categoria.querySelector<HTMLButtonElement>(
            ".categoria-cabecera"
          );

        if (!boton) return;

        establecerCategoria(
          boton,
          categoriasGuardadas.has(
            categoria.dataset.slug ?? ""
          ),
          false
        );
      });


      const actualizarUrl = (busqueda: string) => {
        const url = new URL(window.location.href);

        if (busqueda) {
          url.searchParams.set("q", busqueda);
        } else {
          url.searchParams.delete("q");
        }

        window.history.replaceState({}, "", url);
      };

      const renderizarResultados = (
        coincidencias: EquipoIndice[]
      ) => {
        if (!resultadosDirectos) return;

        resultadosDirectos.replaceChildren();
        indiceResultadoActivo = -1;

        if (coincidencias.length === 0) {
          resultadosDirectos.hidden = true;
          buscador?.removeAttribute("aria-activedescendant");
          return;
        }

        const fragmento = document.createDocumentFragment();

        coincidencias.slice(0, 10).forEach(
          (resultado, indice) => {
            const enlace = document.createElement("a");
            enlace.id = `resultado-${indice}`;
            enlace.className = "resultado-directo";
            enlace.href = resultado.href;
            enlace.setAttribute("role", "option");
            enlace.setAttribute("aria-selected", "false");

            const imagen = document.createElement("img");
            imagen.src = resultado.escudo;
            imagen.alt = "";
            imagen.width = 40;
            imagen.height = 40;
            imagen.loading = "lazy";
            imagen.decoding = "async";

            const textos = document.createElement("span");
            textos.className =
              "resultado-directo-textos";

            const nombre = document.createElement("strong");
            nombre.textContent = resultado.nombre;

            const detalle = document.createElement("small");
            detalle.textContent =
              `${resultado.categoria} · ${resultado.camisetas} camisetas`;

            const flecha = document.createElement("span");
            flecha.className =
              "resultado-directo-flecha";
            flecha.textContent = "›";
            flecha.setAttribute("aria-hidden", "true");

            textos.append(nombre, detalle);
            enlace.append(imagen, textos, flecha);
            fragmento.append(enlace);
          }
        );

        resultadosDirectos.append(fragmento);
        resultadosDirectos.hidden = false;
      };

      const resultadosRenderizados = () =>
        resultadosDirectos
          ? [
              ...resultadosDirectos.querySelectorAll<
                HTMLAnchorElement
              >(".resultado-directo")
            ]
          : [];

      const seleccionarResultado = (indice: number) => {
        const resultados = resultadosRenderizados();

        if (resultados.length === 0) return;

        indiceResultadoActivo =
          (indice + resultados.length) %
          resultados.length;

        resultados.forEach((resultado, posicion) => {
          const activo =
            posicion === indiceResultadoActivo;

          resultado.classList.toggle(
            "seleccionado",
            activo
          );

          resultado.setAttribute(
            "aria-selected",
            String(activo)
          );

          if (activo) {
            buscador?.setAttribute(
              "aria-activedescendant",
              resultado.id
            );

            resultado.scrollIntoView({
              block: "nearest"
            });
          }
        });
      };

      const filtrarEquipos = ({
        actualizarDireccion = true
      }: {
        actualizarDireccion?: boolean;
      } = {}) => {
        const valor = buscador?.value.trim() ?? "";
        const busqueda = normalizarTexto(valor);

        const coincidencias = busqueda
          ? indiceEquipos.filter((item) =>
              item.nombreNormalizado.includes(busqueda)
            )
          : [];

        categoriasElementos.forEach((categoria) => {
          const enlaces =
            categoria.querySelectorAll<HTMLAnchorElement>(
              ".equipo"
            );

          const botonCategoria =
            categoria.querySelector<HTMLButtonElement>(
              ".categoria-cabecera"
            );

          let coincidenciasCategoria = 0;

          enlaces.forEach((enlace) => {
            const nombre = normalizarTexto(
              enlace.dataset.equipo ?? ""
            );

            const coincide =
              busqueda === "" ||
              nombre.includes(busqueda);

            enlace.hidden = !coincide;

            if (coincide && busqueda) {
              coincidenciasCategoria++;
            }
          });

          categoria.hidden =
            busqueda !== "" &&
            coincidenciasCategoria === 0;

          if (botonCategoria) {
            if (busqueda) {
              establecerCategoria(
                botonCategoria,
                coincidenciasCategoria > 0,
                false
              );
            } else {
              establecerCategoria(
                botonCategoria,
                categoriasGuardadas.has(
                  categoria.dataset.slug ?? ""
                ),
                false
              );
            }
          }
        });

        renderizarResultados(coincidencias);

        if (busqueda && coincidencias.length === 1) {
          const objetivo = document.querySelector<HTMLElement>(
            `.equipo[href="${coincidencias[0].href}"]`
          );

          objetivo?.scrollIntoView({
            behavior: "smooth",
            block: "center"
          });
        }

        if (botonLimpiar) {
          botonLimpiar.hidden = valor === "";
        }

        if (textoResultado) {
          if (!busqueda) {
            textoResultado.textContent =
              "Escribe el nombre de un equipo para encontrarlo rápidamente.";
          } else if (coincidencias.length === 1) {
            textoResultado.textContent =
              "Se ha encontrado 1 equipo.";
          } else {
            textoResultado.textContent =
              `Se han encontrado ${coincidencias.length} equipos.`;
          }
        }

        if (sinResultados) {
          sinResultados.hidden =
            busqueda === "" ||
            coincidencias.length > 0;
        }

        if (actualizarDireccion) {
          actualizarUrl(valor);
        }

      };

      let temporizadorBusqueda: number | undefined;

      buscador?.addEventListener("input", () => {
        window.clearTimeout(temporizadorBusqueda);

        temporizadorBusqueda = window.setTimeout(
          () => filtrarEquipos(),
          70
        );
      });

      buscador?.addEventListener("keydown", (evento) => {
        const resultados = resultadosRenderizados();

        if (
          evento.key === "ArrowDown" &&
          resultados.length > 0
        ) {
          evento.preventDefault();
          seleccionarResultado(
            indiceResultadoActivo + 1
          );
        }

        if (
          evento.key === "ArrowUp" &&
          resultados.length > 0
        ) {
          evento.preventDefault();
          seleccionarResultado(
            indiceResultadoActivo - 1
          );
        }

        if (
          evento.key === "Enter" &&
          indiceResultadoActivo >= 0
        ) {
          evento.preventDefault();
          resultados[indiceResultadoActivo]?.click();
        }

        if (evento.key === "Escape") {
          buscador.value = "";
          filtrarEquipos();
          buscador.focus();
        }
      });

      botonLimpiar?.addEventListener("click", () => {
        if (!buscador) return;

        buscador.value = "";
        filtrarEquipos();
        buscador.focus();
      });

      document.addEventListener("keydown", (evento) => {
        const objetivo = evento.target;

        const escribiendo =
          objetivo instanceof HTMLInputElement ||
          objetivo instanceof HTMLTextAreaElement ||
          objetivo instanceof HTMLSelectElement ||
          (objetivo instanceof HTMLElement &&
            objetivo.isContentEditable);

        if (evento.key === "/" && !escribiendo) {
          evento.preventDefault();
          buscador?.focus();
          buscador?.select();
        }
      });

      window.addEventListener("popstate", () => {
        if (!buscador) return;

        buscador.value =
          new URL(window.location.href)
            .searchParams.get("q") ?? "";

        filtrarEquipos({
          actualizarDireccion: false
        });
      });

      if (buscador) {
        buscador.value =
          new URL(window.location.href)
            .searchParams.get("q") ?? "";

        if (buscador.value) {
          filtrarEquipos({
            actualizarDireccion: false
          });
        }
      }

      if ("IntersectionObserver" in window) {
        const observerCategorias = new IntersectionObserver(
          (entradas, observer) => {
            entradas.forEach((entrada) => {
              if (!entrada.isIntersecting) return;

              entrada.target.classList.add("categoria-visible");
              observer.unobserve(entrada.target);
            });
          },
          { rootMargin: "160px 0px" }
        );

        categoriasElementos.forEach((categoria) => {
          observerCategorias.observe(categoria);
        });
      } else {
        categoriasElementos.forEach((categoria) => {
          categoria.classList.add("categoria-visible");
        });
      }

      document.documentElement.classList.add(
        "pagina-cargada"
      );
    </script>
  </body>
