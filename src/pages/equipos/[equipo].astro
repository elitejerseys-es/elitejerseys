    min-width: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid #dfe5e1;
    border-radius: 16px;
    color: #202723;
    cursor: pointer;
    text-align: left;
    background: white;
    box-shadow:
      0 6px 18px rgba(23, 34, 27, 0.045),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
    animation: aparecerTarjeta 0.45s ease both;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .foto:nth-child(2) {
    animation-delay: 0.04s;
  }

  .foto:nth-child(3) {
    animation-delay: 0.08s;
  }

  .foto:nth-child(4) {
    animation-delay: 0.12s;
  }

  .foto:nth-child(5) {
    animation-delay: 0.16s;
  }

  .foto:hover {
    border-color: #b9ccc1;
    transform: translateY(-5px);
    box-shadow:
      0 18px 38px rgba(19, 40, 28, 0.13),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .foto[hidden] {
    display: none;
  }

  .foto-imagen {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #0f1210;
  }

  .foto-imagen::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 32%;
    opacity: 0;
    background: linear-gradient(transparent, rgba(5, 8, 6, 0.5));
    transition: opacity 0.22s ease;
  }

  .foto:hover .foto-imagen::after {
    opacity: 1;
  }

  .foto-imagen img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition:
      transform 0.35s ease,
      filter 0.35s ease;
  }

  .foto:hover .foto-imagen img {
    transform: scale(1.035);
    filter: contrast(1.02);
  }

  .ampliar {
    position: absolute;
    right: 11px;
    bottom: 11px;
    z-index: 2;
    padding: 7px 10px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    color: white;
    font-size: 10px;
    font-weight: 750;
    opacity: 0;
    background: rgba(12, 18, 14, 0.8);
    backdrop-filter: blur(8px);
    transform: translateY(6px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .foto:hover .ampliar {
    opacity: 1;
    transform: translateY(0);
  }

  .foto-texto {
    padding: 13px 14px 15px;
  }

  .foto-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
  }

  .badge-tipo {
    display: inline-flex;
    align-items: center;
    min-height: 23px;
    padding: 0 8px;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .tipo-local {
    color: #0c6b47;
    background: #e5f4ed;
  }

  .tipo-visitante {
    color: #1d59a5;
    background: #e9f1fb;
  }

  .tipo-tercera {
    color: #7a45a5;
    background: #f1eafa;
  }

  .tipo-cuarta {
    color: #a66012;
    background: #fff0dc;
  }

  .tipo-portero {
    color: #a14f14;
    background: #ffeddc;
  }

  .tipo-entrenamiento {
    color: #5a6260;
    background: #edf0ef;
  }

  .foto-texto .temporada {
    color: #758078;
    font-size: 10px;
    font-weight: 750;
  }

  .foto-texto > strong {
    display: block;
    overflow: hidden;
    color: #162019;
    font-size: 13px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .abrir-ficha {
    display: block;
    margin-top: 5px;
    color: #8a948e;
    font-size: 10px;
    transition: color 0.16s ease;
  }

  .foto:hover .abrir-ficha {
    color: #16805a;
  }

  @keyframes aparecerTarjeta {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ESTADOS VACÍOS */

  .sin-fotos,
  .sin-filtros {
    padding: 80px 20px;
    border: 1px solid #dde3df;
    border-radius: 17px;
    text-align: center;
    background: white;
  }

  .sin-filtros {
    margin-bottom: 70px;
  }

  .sin-filtros[hidden] {
    display: none;
  }

  .sin-fotos > span,
  .sin-filtros > span {
    font-size: 44px;
  }

  .sin-fotos h2,
  .sin-filtros h3 {
    margin: 15px 0 8px;
  }

  .sin-fotos p,
  .sin-filtros p {
    margin: 0;
    color: #7b857f;
  }

  /* NAVEGACIÓN ENTRE EQUIPOS */

  .navegacion-equipos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 12px;
    margin: -12px 0 34px;
  }

  .navegacion-equipos a {
    min-width: 0;
    min-height: 66px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 13px 16px;
    overflow: hidden;
    border: 1px solid rgba(var(--club-primary-rgb), 0.14);
    border-radius: 14px;
    color: #172019;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.86);
    box-shadow:
      0 8px 22px rgba(var(--club-secondary-rgb), 0.07),
      inset 0 1px 0 rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      background 0.18s ease;
  }

  .navegacion-equipos a:hover {
    border-color: rgba(var(--club-primary-rgb), 0.34);
    background: rgba(255, 255, 255, 0.96);
    transform: translateY(-2px);
    box-shadow:
      0 13px 30px rgba(var(--club-secondary-rgb), 0.11),
      inset 0 1px 0 rgba(255, 255, 255, 0.96);
  }

  .equipo-anterior,
  .equipo-siguiente {
    min-width: 0;
  }

  .equipo-siguiente {
    align-items: flex-end;
    text-align: right;
  }

  .equipo-anterior span,
  .equipo-siguiente span {
    color: #7b857f;
    font-size: 9px;
    font-weight: 850;
    letter-spacing: 0.65px;
    text-transform: uppercase;
  }

  .equipo-anterior strong,
  .equipo-siguiente strong {
    max-width: 100%;
    overflow: hidden;
    color: #172019;
    font-size: 13px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .equipo-anterior:hover strong,
  .equipo-siguiente:hover strong {
    color: var(--club-primary);
  }

  /* VISOR PREMIUM */

  .visor {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: none;
    place-items: center;
    padding: 24px;
  }

  .visor.abierto {
    display: grid;
  }

  .visor-fondo {
    position: absolute;
    inset: 0;
    background: rgba(4, 7, 5, 0.92);
    backdrop-filter: blur(12px);
  }

  .visor-contenido {
    position: relative;
    z-index: 2;
    width: min(1180px, 100%);
    min-height: min(90vh, 860px);
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) 54px;
    align-items: center;
    gap: 16px;
    animation: aparecerVisor 0.2s ease both;
  }

  .visor figure {
    min-width: 0;
    max-height: 90vh;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .visor-imagen-contenedor {
    max-width: 100%;
    max-height: calc(90vh - 82px);
    overflow: auto;
    border-radius: 15px;
    background: #090c0a;
    box-shadow: 0 30px 85px rgba(0, 0, 0, 0.5);
  }

  .visor figure img {
    max-width: 100%;
    max-height: calc(90vh - 82px);
    display: block;
    border-radius: 15px;
    object-fit: contain;
    transform-origin: center;
    transition: transform 0.18s ease;
  }

  .visor-pie {
    width: min(760px, 100%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-top: 12px;
  }

  .visor figcaption {
    min-width: 0;
    flex: 1;
    color: white;
    font-size: 13px;
  }

  .controles-zoom {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .controles-zoom button,
  .controles-zoom span {
    min-height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: white;
    font-size: 11px;
    background: rgba(255, 255, 255, 0.08);
  }

  .controles-zoom button {
    min-width: 32px;
    cursor: pointer;
  }

  .controles-zoom span {
    min-width: 50px;
  }

  #zoom-restablecer {
    padding: 0 9px;
  }

  .visor-cerrar,
  .visor-anterior,
  .visor-siguiente {
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: white;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.09);
    backdrop-filter: blur(8px);
    transition:
      background 0.16s ease,
      transform 0.16s ease;
  }

  .visor-cerrar:hover,
  .visor-anterior:hover,
  .visor-siguiente:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  .visor-cerrar {
    position: absolute;
    top: -4px;
    right: 0;
    z-index: 3;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 26px;
  }

  .visor-anterior,
  .visor-siguiente {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    font-size: 36px;
  }

  .visor-anterior:hover {
    transform: translateX(-2px);
  }

  .visor-siguiente:hover {
    transform: translateX(2px);
  }

  @keyframes aparecerVisor {
    from {
      opacity: 0;
      transform: scale(0.985);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* PIE */

  .pie {
    border-top: 1px solid #dce2de;
    background: white;
  }

  .pie-interior {
    min-height: 120px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
  }

  .pie strong {
    font-size: 16px;
  }

  .pie p {
    margin: 6px 0 0;
    color: #7a857e;
    font-size: 12px;
  }

  .pie a {
    color: #16805a;
    font-size: 12px;
    font-weight: 750;
    text-decoration: none;
  }

  /* RESPONSIVE */

  @media (max-width: 1150px) {
    .galeria {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .barra-galeria {
      align-items: flex-start;
      flex-direction: column;
    }

    .filtros {
      width: 100%;
      justify-content: flex-start;
    }
  }

  @media (max-width: 900px) {
    .galeria {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .contenedor {
      width: min(100% - 24px, 1320px);
    }

    .equipo-hero {
      align-items: flex-start;
      flex-direction: column;
    }

    .galeria {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .desplegable-inicio,
    .desplegable-liga {
      position: fixed;
      top: 78px;
      right: 12px;
      left: 12px;
      width: auto;
      max-width: none;
      max-height: calc(100vh - 94px);
    }

    .lista-categorias,
    .lista-equipos {
      max-height: calc(100vh - 150px);
    }

    .equipos-categoria {
      max-height: calc(100vh - 275px);
    }

    .navegacion-equipos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: -8px;
      margin-bottom: 28px;
    }

    .visor-pie {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 560px) {
    .cabecera-interior {
      min-height: 66px;
    }
{
      display: none;
    }

    .marca-icono {
      width: 41px;
      height: 41px;
    }

    .marca-texto strong {
      font-size: 16px;
    }

    .marca-texto small {
      font-size: 10px;
    }

    .migas {
      padding-top: 18px;
      font-size: 11px;
    }

    .equipo-hero {
      margin-bottom: 32px;
      padding: 18px;
    }

    .equipo-identidad {
      align-items: flex-start;
      gap: 14px;
    }

    .escudo-grande {
      width: 68px;
      height: 68px;
      flex-basis: 68px;
      border-radius: 15px;
    }

    .escudo-grande img {
      max-width: 56px;
      max-height: 56px;
    }

    .equipo-hero h1 {
      font-size: 28px;
    }

    .estado-catalogo {
      display: none;
    }

    .barra-galeria h2 {
      font-size: 27px;
    }

    .barra-galeria p {
      font-size: 12px;
    }

    .filtros {
      display: grid;
      grid-template-columns: 1fr;
    }

    .filtros select {
      width: 100%;
    }

    .filtros-rapidos {
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 3px;
    }

    .filtro-rapido {
      flex: 0 0 auto;
    }

    .foto-imagen {
      aspect-ratio: 1 / 1;
    }

    .foto-texto {
      padding: 9px;
    }

    .foto-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 5px;
      margin-bottom: 7px;
    }

    .foto-texto > strong {
      font-size: 11px;
    }

    .abrir-ficha {
      display: none;
    }

    .ampliar {
      display: none;
    }

    .navegacion-equipos {
      gap: 8px;
      margin-top: -6px;
      margin-bottom: 24px;
    }

    .navegacion-equipos a {
      min-height: 60px;
      padding: 10px 11px;
      border-radius: 12px;
    }

    .equipo-anterior strong,
    .equipo-siguiente strong {
      font-size: 12px;
    }

    .visor {
      padding: 9px;
    }

    .visor-contenido {
      min-height: 92vh;
      grid-template-columns: 38px minmax(0, 1fr) 38px;
      gap: 4px;
    }

    .visor-anterior,
    .visor-siguiente {
      width: 38px;
      height: 38px;
      font-size: 27px;
    }

    .visor-cerrar {
      top: 3px;
      width: 40px;
      height: 40px;
    }

    .visor-pie {
      display: none;
    }

    .pie-interior {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(*) {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* IDENTIDAD VISUAL DINÁMICA DEL EQUIPO */

  :global(body) {
    position: relative;
    isolation: isolate;
    overflow-x: hidden;
  }

  .fondo-escudo-equipo {
    position: fixed;
    z-index: -2;
    top: 90px;
    right: -8vw;
    width: min(54vw, 760px);
    aspect-ratio: 1;
    object-fit: contain;
    opacity: 0.12;
    filter:
      blur(72px)
      saturate(1.55)
      contrast(1.05);
    transform: scale(1.18);
    pointer-events: none;
    user-select: none;
  }

  :global(body)::after {
    content: "";
    position: fixed;
    z-index: -1;
    inset: 74px 0 0;
    background:
      radial-gradient(
        circle at 88% 8%,
        rgba(255, 255, 255, 0.6),
        transparent 30rem
      ),
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.1),
        rgba(242, 245, 243, 0.92) 36rem
      );
    pointer-events: none;
  }

  .equipo-hero {
    isolation: isolate;
    border-color: rgba(255, 255, 255, 0.78);
    background:
      linear-gradient(
        112deg,
        rgba(255, 255, 255, 0.97) 0%,
        rgba(255, 255, 255, 0.91) 58%,
        rgba(255, 255, 255, 0.72) 100%
      );
    backdrop-filter: blur(16px);
  }

  .marca-agua-escudo {
    position: absolute;
    z-index: -1;
    top: 50%;
    right: clamp(25px, 7vw, 110px);
    width: clamp(150px, 22vw, 290px);
    max-height: 88%;
    object-fit: contain;
    opacity: 0.07;
    filter: saturate(1.35);
    transform: translateY(-50%);
    pointer-events: none;
    user-select: none;
  }

  .escudo-grande {
    border-color: rgba(255, 255, 255, 0.88);
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.98),
        rgba(246, 248, 247, 0.88)
      );
    box-shadow:
      0 13px 30px rgba(18, 30, 22, 0.13),
      inset 0 1px 0 white;
    backdrop-filter: blur(10px);
  }

  .foto {
    position: relative;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
  }

  .foto::before {
    content: "";
    position: absolute;
    z-index: 3;
    top: 0;
    right: 0;
    left: 0;
    height: 3px;
    opacity: 0.28;
    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(22, 128, 90, 0.85),
        transparent
      );
    pointer-events: none;
  }

  @media (max-width: 760px) {
    .fondo-escudo-equipo {
      top: 170px;
      right: -28vw;
      width: 96vw;
      opacity: 0.09;
      filter:
        blur(56px)
        saturate(1.45);
    }

    .marca-agua-escudo {
      right: -20px;
      width: 175px;
      opacity: 0.045;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fondo-escudo-equipo {
      filter: blur(45px);
    }
  }


  /* FONDO GENERAL PREMIUM POR CLUB */

  :global(body) {
    background: #f2f5f3;
  }

  .fondo-paleta-club {
    position: fixed;
    z-index: -5;
    inset: 74px 0 0;
    overflow: hidden;
    background:
      linear-gradient(
        145deg,
        rgba(var(--club-primary-rgb), 0.12) 0%,
        rgba(255, 255, 255, 0.84) 28%,
        rgba(var(--club-secondary-rgb), 0.09) 66%,
        rgba(var(--club-accent-rgb), 0.12) 100%
      ),
      #f2f5f3;
    pointer-events: none;
  }

  .fondo-paleta-club::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.16;
    background-image:
      linear-gradient(
        rgba(var(--club-primary-rgb), 0.14) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(var(--club-secondary-rgb), 0.12) 1px,
        transparent 1px
      );
    background-size: 70px 70px;
    mask-image:
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.72),
        transparent 78%
      );
  }

  .halo {
    position: absolute;
    display: block;
    border-radius: 50%;
    filter: blur(72px);
    opacity: 0.36;
    mix-blend-mode: multiply;
    transform: translateZ(0);
  }

  .halo-primario {
    top: -12%;
    left: -9%;
    width: min(58vw, 820px);
    aspect-ratio: 1;
    background: rgba(var(--club-primary-rgb), 0.72);
  }

  .halo-secundario {
    top: 8%;
    right: -13%;
    width: min(53vw, 760px);
    aspect-ratio: 1;
    background: rgba(var(--club-secondary-rgb), 0.64);
  }

  .halo-acento {
    right: 13%;
    bottom: -24%;
    width: min(42vw, 620px);
    aspect-ratio: 1;
    opacity: 0.22;
    background: rgba(var(--club-accent-rgb), 0.68);
  }

  .trama-club {
    position: absolute;
    top: 0;
    right: 0;
    width: 44%;
    height: 100%;
    opacity: 0.09;
    background:
      repeating-linear-gradient(
        125deg,
        rgba(var(--club-primary-rgb), 0.7) 0 2px,
        transparent 2px 18px
      );
    mask-image:
      linear-gradient(
        to left,
        rgba(0, 0, 0, 0.9),
        transparent
      );
  }

  :global(body)::after {
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.06),
        rgba(242, 245, 243, 0.58) 44rem,
        rgba(242, 245, 243, 0.8)
      );
  }

  .fondo-escudo-equipo {
    opacity: 0.08;
    filter:
      blur(74px)
      saturate(1.25);
  }

  .equipo-hero {
    border-color: rgba(var(--club-primary-rgb), 0.18);
    background:
      linear-gradient(
        112deg,
        rgba(255, 255, 255, 0.96) 0%,
        rgba(255, 255, 255, 0.84) 60%,
        rgba(var(--club-primary-rgb), 0.09) 100%
      );
    box-shadow:
      0 24px 60px rgba(var(--club-secondary-rgb), 0.12),
