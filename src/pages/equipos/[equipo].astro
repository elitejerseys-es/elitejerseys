<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add("pagina-lista");</script>

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={`Todas las camisetas de ${equipo} en Elite Jerseys`}
    />

    <meta name="theme-color" content={colorNavegador} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={urlCanonica} />

    {
      camisetas[0] && (
        <link
          rel="preload"
          as="image"
          href={camisetas[0].thumbSrc}
          fetchpriority="high"
        />
      )
    }

    {
      equipoAnterior && (
        <link rel="prefetch" href={`/equipos/${crearSlug(equipoAnterior)}`} />
      )
    }

    {
      equipoSiguiente && (
        <link rel="prefetch" href={`/equipos/${crearSlug(equipoSiguiente)}`} />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Elite Jerseys" />
    <meta property="og:title" content={`${equipo} | Elite Jerseys`} />
    <meta
      property="og:description"
      content={`Explora todas las camisetas de ${equipo} por temporada y tipo de equipación.`}
    />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image:alt" content={`Camisetas de ${equipo}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${equipo} | Elite Jerseys`} />
    <meta
      name="twitter:description"
      content={`Catálogo de camisetas de ${equipo} en Elite Jerseys.`}
    />
    <meta name="twitter:image" content={imagenSocial} />

    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%23111713'/%3E%3Ctext x='32' y='40' text-anchor='middle' font-family='Arial' font-size='25' font-weight='700' fill='%23d7ad4d'%3EEJ%3C/text%3E%3C/svg%3E"
    />

    <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
    <link rel="prefetch" href={urlEquipoAnterior} />
    <link rel="prefetch" href={urlEquipoSiguiente} />
    <title>{equipo} | Elite Jerseys</title>
  </head>

  <body
    style={[
      `--club-primary:${temaEquipo.primario}`,
      `--club-secondary:${temaEquipo.secundario}`,
      `--club-accent:${temaEquipo.acento}`,
      `--club-primary-rgb:${temaEquipo.primarioRgb}`,
      `--club-secondary-rgb:${temaEquipo.secundarioRgb}`,
      `--club-accent-rgb:${temaEquipo.acentoRgb}`,
      `--club-bg-main-rgb:${fondoPrincipalRgb}`,
      `--club-bg-secondary-rgb:${fondoSecundarioRgb}`,
      `--club-bg-strength:${intensidadFondo}`
    ].join(";")}
  >
    <a class="saltar-contenido" href="#contenido-principal">
      Saltar al contenido
    </a>

    <div class="fondo-paleta-club" aria-hidden="true"></div>
    <img
      class="fondo-escudo-equipo"
      src={obtenerEscudo(equipo)}
      alt=""
      aria-hidden="true"
    />

    <header class="cabecera">
      <div class="contenedor cabecera-interior">
        <a href="/" class="marca" aria-label="Ir al inicio">
          <span class="marca-icono">
            <img
              src="/images/logo-elite-jerseys.png"
              alt=""
              aria-hidden="true"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
            />
            <span class="marca-iniciales">EJ</span>
          </span>

          <span class="marca-texto">
            <strong>Elite Jerseys</strong>
            <small>Catálogo de camisetas de fútbol</small>
          </span>
        </a>
      </div>
    </header>

    <main id="contenido-principal" class="contenedor" tabindex="-1">
      <nav class="migas" aria-label="Navegación">
        <div class="menu-inicio">
          <button
            class="enlace-inicio"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="menu-global"
          >
            <span>Inicio</span>
            <span class="flecha-inicio">▾</span>
          </button>

          <div
            id="menu-global"
            class="desplegable-inicio"
            aria-hidden="true"
          >
            <div class="titulo-desplegable">
              Ligas y selecciones
            </div>

            <label class="busqueda-menu">
              <span class="busqueda-menu-icono" aria-hidden="true">⌕</span>
              <input
                id="buscar-menu-global"
                type="search"
                placeholder="Buscar liga o equipo..."
                autocomplete="off"
                aria-label="Buscar liga o equipo"
              />
              <button
                class="limpiar-busqueda-menu"
                type="button"
                aria-label="Limpiar búsqueda"
                hidden
              >
                ×
              </button>
            </label>

            <div class="lista-categorias">
              {
                categoriasOrdenadas.map((item) => (
                  <details class="categoria-menu">
                    <summary class="categoria-resumen">
                      <span class="categoria-info">
                        <span class="logo-categoria">
                          <img
                            src={item.logo}
                            alt={`Logo de ${item.nombre}`}
                            loading="lazy"
                          />
                        </span>

                        <span>{item.nombre}</span>
                      </span>

                      <span class="flecha-categoria">▾</span>
                    </summary>

                    <div class="equipos-categoria">
                      {
                        item.equipos.map((nombreEquipo) => (
                          <a
                            href={`/equipos/${crearSlug(nombreEquipo)}`}
                            class:list={[
                              "enlace-equipo-inicio",
                              { activo: nombreEquipo === equipo }
                            ]}
                            aria-current={nombreEquipo === equipo ? "page" : undefined}
                          >
                            <img
                              src={obtenerEscudo(nombreEquipo)}
                              alt=""
                              loading="lazy"
                              onerror="this.style.visibility='hidden'"
                            />

                            <span class="nombre-equipo-menu">
                              {nombreEquipo}
                            </span>

                            {
                              nombreEquipo === equipo && (
                                <span class="marca-activo">✓</span>
                              )
                            }
                          </a>
                        ))
                      }
                    </div>
                  </details>
                ))
              }
            </div>
          </div>
        </div>

        <span class="separador">›</span>

        <div class="menu-liga">
          <button
            class="enlace-liga"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="menu-liga"
          >
            <span>{categoria}</span>
            <span class="flecha-menu">▾</span>
          </button>

          <div
            id="menu-liga"
            class="desplegable-liga"
            aria-hidden="true"
          >
            <div class="titulo-desplegable">
              Equipos de {categoria}
            </div>

            <label class="busqueda-menu">
              <span class="busqueda-menu-icono" aria-hidden="true">⌕</span>
              <input
                id="buscar-menu-liga"
                type="search"
                placeholder="Buscar equipo..."
                autocomplete="off"
                aria-label={`Buscar equipo de ${categoria}`}
              />
              <button
                class="limpiar-busqueda-menu"
                type="button"
                aria-label="Limpiar búsqueda"
                hidden
              >
                ×
              </button>
            </label>

            <div class="lista-equipos">
              {
                equiposCategoria.map((nombreEquipo) => (
                  <a
                    href={`/equipos/${crearSlug(nombreEquipo)}`}
                    class:list={[
                      "enlace-equipo-menu",
                      { activo: nombreEquipo === equipo }
                    ]}
                    aria-current={nombreEquipo === equipo ? "page" : undefined}
                  >
                    <img
                      src={obtenerEscudo(nombreEquipo)}
                      alt=""
                      loading="lazy"
                      onerror="this.style.visibility='hidden'"
                    />

                    <span class="nombre-equipo-menu">
                      {nombreEquipo}
                    </span>

                    {
                      nombreEquipo === equipo && (
                        <span class="marca-activo">✓</span>
                      )
                    }
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <span class="separador">›</span>
        <strong>{equipo}</strong>
      </nav>

      <button
        id="fondo-menus"
        class="fondo-menus"
        type="button"
        aria-label="Cerrar menú"
        tabindex="-1"
        hidden
      ></button>

      <section class="equipo-hero">
        <img
          class="marca-agua-escudo"
          src={obtenerEscudo(equipo)}
          alt=""
          aria-hidden="true"
        />

        <div class="equipo-identidad">
          <div class="escudo-grande">
            <img
              src={obtenerEscudo(equipo)}
              alt={`Escudo de ${equipo}`}
              decoding="async"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
            />
            <span class="escudo-error" aria-hidden="true">
              {equipo.charAt(0)}
            </span>
          </div>

          <div class="equipo-datos">
            <div class="categoria-linea">
              <span class="categoria">{categoria}</span>
              <span class="estado-catalogo">CATÁLOGO ACTIVO</span>
            </div>

            <h1>{equipo}</h1>
          </div>
        </div>
      </section>

      {
        equiposCategoria.length > 1 && (
          <nav class="navegacion-equipos navegacion-superior" aria-label="Navegación entre equipos">
            <a href={`/equipos/${crearSlug(equipoAnterior)}`} class="equipo-anterior">
              <span class="nav-flecha" aria-hidden="true">←</span>

              <span class="nav-escudo">
                <img
                  src={obtenerEscudo(equipoAnterior)}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                />
                <span class="nav-escudo-fallback">
                  {equipoAnterior.charAt(0)}
                </span>
              </span>

              <span class="nav-textos">
                <small>Anterior</small>
                <strong>{equipoAnterior}</strong>
              </span>
            </a>

            <a href={`/equipos/${crearSlug(equipoSiguiente)}`} class="equipo-siguiente">
              <span class="nav-textos">
                <small>Siguiente</small>
                <strong>{equipoSiguiente}</strong>
              </span>

              <span class="nav-escudo">
                <img
                  src={obtenerEscudo(equipoSiguiente)}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                />
                <span class="nav-escudo-fallback">
                  {equipoSiguiente.charAt(0)}
                </span>
              </span>

              <span class="nav-flecha" aria-hidden="true">→</span>
            </a>
          </nav>
        )
      }

      {

        camisetas.length > 0 ? (
          <>
            <section class="barra-galeria">
              <div>
                <span class="etiqueta-seccion">COLECCIÓN</span>
                <h2>Camisetas de {equipo}</h2>
                <p>Explora todas las equipaciones disponibles del equipo.</p>
              </div>

              <div class="filtros">

                <select id="filtro-temporada" aria-label="Filtrar por temporada">
                  <option value="todas">Todas las temporadas</option>

                  {
                    temporadas.map((temporada) => (
                      <option value={temporada}>{temporada}</option>
                    ))
                  }
                </select>
              </div>
            </section>

            <div class="filtros-rapidos" aria-label="Filtros rápidos">
              <button class="filtro-rapido activo" type="button" data-filtro-tipo="todos">
                Todas
              </button>

              {
                tipos.map((tipoSlug) => (
                  <button
                    class:list={["filtro-rapido", `tipo-${tipoSlug}`]}
                    type="button"
                    data-filtro-tipo={tipoSlug}
                  >
                    {convertirTipo(tipoSlug)}
                  </button>
                ))
              }
            </div>

            <p
              id="contador-resultados"
              class="contador-resultados"
              aria-live="polite"
            >
              Mostrando {camisetas.length} camisetas
            </p>

            <section class="galeria" aria-label={`Camisetas de ${equipo}`}>
              {
                camisetas.map((camiseta, indice) => (
                  <button
                    id={`${camiseta.temporada.replace("/", "-")}-${camiseta.tipoSlug}`}
                    class="foto"
                    type="button"
                    data-indice={indice}
                    data-orden={indice}
                    data-temporada={camiseta.temporada}
                    data-tipo={camiseta.tipoSlug}
                    data-src={camiseta.thumbSrc}
                    data-full-src={camiseta.fullSrc}
                    data-titulo={`${equipo} · ${camiseta.temporada} · ${camiseta.tipo}`}
                    aria-label={`Abrir ${camiseta.tipo.toLowerCase()} de ${equipo}, temporada ${camiseta.temporada}`}
                  >
                    <div class="foto-imagen">
                      <img
                        src={camiseta.thumbSrc}
                        alt={`${equipo} ${camiseta.temporada} ${camiseta.tipo}`}
                        width="800"
                        height="1000"
                        loading={indice === 0 ? "eager" : "lazy"}
                        decoding="async"
                        fetchpriority={indice === 0 ? "high" : "auto"}
                        sizes="(max-width: 520px) 50vw, (max-width: 900px) 33vw, 260px"
                        onload="this.classList.add('cargada')"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                      />

                      <span class="imagen-no-disponible">
                        <span>Imagen no disponible</span>
                      </span>

                      <span class="ampliar">Ver imagen</span>
                    </div>

                    <div class="foto-texto">
                      <span class:list={["badge-tipo", `tipo-${camiseta.tipoSlug}`]}>
                        {camiseta.tipo}
                      </span>

                      <span class="temporada">{camiseta.temporada}</span>
                    </div>
                  </button>
                ))
              }
            </section>

            <div id="cargar-mas-observador" class="cargar-mas-observador" aria-hidden="true"><span></span></div>

            <section id="sin-filtros" class="sin-filtros" hidden>
              <span>⚽</span>
              <h3>No hay camisetas con esos filtros</h3>
              <p>Prueba con otra temporada o tipo de equipación.</p>
            </section>
          </>
        ) : (
          <section class="sin-fotos">
            <span>📷</span>
            <h2>Todavía no hay camisetas</h2>
            <p>
              Añade fotografías directamente dentro de la carpeta del equipo.
            </p>
          </section>
        )
      }

    </main>

    <div
      id="visor"
      class="visor"
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-labelledby="visor-titulo"
      tabindex="-1"
    >
      <div class="visor-fondo" data-cerrar-visor></div>

      <div class="visor-contenido">
        <button
          class="visor-cerrar"
          type="button"
          aria-label="Cerrar imagen"
          data-cerrar-visor
        >
          <svg
            class="icono-control-visor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M6 6L18 18M18 6L6 18" />
          </svg>
        </button>

        <button
          class="visor-anterior"
          type="button"
          aria-label="Imagen anterior"
        >
          <svg
            class="icono-control-visor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M15 5L8 12L15 19" />
          </svg>
        </button>

        <figure>
          <div class="visor-imagen-contenedor">
            <img
              id="visor-imagen"
              src=""
              alt=""
              width="800"
              height="1000"
              decoding="async"
              onerror="this.style.opacity='0';"
            />
          </div>

          <div class="visor-pie">
            <figcaption id="visor-titulo"></figcaption>

            <div class="visor-estado">
              <span id="visor-contador" aria-live="polite">1 / 1</span>
              <div class="controles-zoom">
                <button id="zoom-menos" type="button" aria-label="Alejar">−</button>
                <span id="zoom-valor">100%</span>
                <button id="zoom-mas" type="button" aria-label="Acercar">+</button>
                <button id="zoom-restablecer" type="button">Restablecer</button>
                <button id="visor-pantalla-completa" type="button" aria-label="Activar pantalla completa" title="Pantalla completa">⛶</button>
              </div>
            </div>
          </div>

          <div
            id="visor-miniaturas"
            class="visor-miniaturas"
            aria-label="Miniaturas de camisetas"
          ></div>
        </figure>

        <button
          class="visor-siguiente"
          type="button"
          aria-label="Imagen siguiente"
        >
          <svg
            class="icono-control-visor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M9 5L16 12L9 19" />
          </svg>
        </button>
      </div>
    </div>

    <script>
      const $ = <T extends Element>(selector: string) =>
        document.querySelector<T>(selector);

      const $$ = <T extends Element>(selector: string) =>
        Array.from(document.querySelectorAll<T>(selector));

      const botonInicio = $<HTMLButtonElement>(".enlace-inicio");
      const menuInicio = $<HTMLElement>(".menu-inicio");
      const desplegableInicio = $<HTMLElement>(".desplegable-inicio");
      const botonLiga = $<HTMLButtonElement>(".enlace-liga");
      const menuLiga = $<HTMLElement>(".menu-liga");
      const desplegableLiga = $<HTMLElement>(".desplegable-liga");
      const fondoMenus = $<HTMLButtonElement>("#fondo-menus");
      const buscarMenuGlobal =
        $<HTMLInputElement>("#buscar-menu-global");
      const buscarMenuLiga =
        $<HTMLInputElement>("#buscar-menu-liga");

      const posicionarPanel = (
        boton: HTMLButtonElement | null,
        panel: HTMLElement | null
      ) => {
        if (!boton || !panel) return;

        /*
         * En escritorio los paneles quedan anclados por CSS justo debajo
         * de su botón. En móvil se muestran como panel inferior.
         */
        panel.style.removeProperty("--menu-top");
        panel.style.removeProperty("--menu-left");
        panel.style.removeProperty("--menu-right");
        panel.style.removeProperty("--menu-max-height");
      };

      const actualizarFondoMenus = () => {
        const abierto =
          menuInicio?.classList.contains("abierto") ||
          menuLiga?.classList.contains("abierto");

        if (fondoMenus) fondoMenus.hidden = !abierto;
        document.body.classList.toggle(
          "menu-superpuesto-abierto",
          Boolean(abierto)
        );
      };


      const esSelectorMovil = () =>
        window.matchMedia("(max-width: 700px)").matches;

      const origenPaneles = new Map<HTMLElement, {
        padre: Node;
        siguiente: Node | null;
      }>();

      [desplegableInicio, desplegableLiga].forEach((panel) => {
        if (panel?.parentNode) {
          origenPaneles.set(panel, {
            padre: panel.parentNode,
            siguiente: panel.nextSibling
          });
        }
      });

      const prepararCierreSelectorMovil = (panel: HTMLElement | null) => {
        if (!panel) return;

        let boton = panel.querySelector<HTMLButtonElement>(".cerrar-selector-movil");
        if (!boton) {
          boton = document.createElement("button");
          boton.type = "button";
          boton.className = "cerrar-selector-movil";
          boton.setAttribute("aria-label", "Volver");
          boton.innerHTML = `
            <span aria-hidden="true">‹</span>
            <strong>Volver</strong>
            <span class="cerrar-selector-x" aria-hidden="true">×</span>
          `;
          panel.prepend(boton);

          boton.addEventListener("click", () => {
            if (panel === desplegableInicio) cerrarInicio();
            if (panel === desplegableLiga) cerrarLiga();
          });
        }
      };

      const moverPanelAlBody = (panel: HTMLElement | null) => {
        if (!panel || !esSelectorMovil()) return;
        prepararCierreSelectorMovil(panel);
        if (panel.parentElement !== document.body) {
          document.body.appendChild(panel);
        }
        panel.classList.add("selector-movil-abierto");
      };

      const devolverPanelAOrigen = (panel: HTMLElement | null) => {
        if (!panel) return;
        panel.classList.remove("selector-movil-abierto");
        const origen = origenPaneles.get(panel);
        if (!origen || panel.parentNode === origen.padre) return;
        origen.padre.insertBefore(panel, origen.siguiente);
      };

      const cambiarEstadoMenu = (
        contenedor: HTMLElement | null,
        boton: HTMLButtonElement | null,
        panel: HTMLElement | null,
        abierto: boolean
      ) => {
        if (abierto) {
          posicionarPanel(boton, panel);
          moverPanelAlBody(panel);
        } else {
          panel?.classList.remove("selector-movil-abierto");
        }

        contenedor?.classList.toggle("abierto", abierto);
        boton?.setAttribute("aria-expanded", String(abierto));
        panel?.setAttribute("aria-hidden", String(!abierto));

        actualizarFondoMenus();

        if (abierto) {
          window.requestAnimationFrame(() => {
            panel
              ?.querySelector<HTMLInputElement>(".busqueda-menu input")
              ?.focus();
          });
        }
      };

      const cerrarInicio = () => {
        cambiarEstadoMenu(
          menuInicio,
          botonInicio,
          desplegableInicio,
          false
        );

        if (buscarMenuGlobal) {
          buscarMenuGlobal.value = "";
          buscarMenuGlobal.dispatchEvent(new Event("input"));
        }
      };

      const cerrarLiga = () => {
        cambiarEstadoMenu(
          menuLiga,
          botonLiga,
          desplegableLiga,
          false
        );

        if (buscarMenuLiga) {
          buscarMenuLiga.value = "";
          buscarMenuLiga.dispatchEvent(new Event("input"));
        }
      };

      const abrirInicio = () => {
        cerrarLiga();
        cambiarEstadoMenu(
          menuInicio,
          botonInicio,
          desplegableInicio,
          true
        );
      };

      const abrirLiga = () => {
        cerrarInicio();
        cambiarEstadoMenu(
          menuLiga,
          botonLiga,
          desplegableLiga,
          true
        );
      };

      botonInicio?.addEventListener("click", () => {
        menuInicio?.classList.contains("abierto")
          ? cerrarInicio()
          : abrirInicio();
      });

      botonLiga?.addEventListener("click", () => {
        menuLiga?.classList.contains("abierto")
          ? cerrarLiga()
          : abrirLiga();
      });

      fondoMenus?.addEventListener("click", () => {
        cerrarInicio();
        cerrarLiga();
      });

      const reposicionarMenuAbierto = () => {
        if (menuInicio?.classList.contains("abierto")) {
          posicionarPanel(botonInicio, desplegableInicio);
        }

        if (menuLiga?.classList.contains("abierto")) {
          posicionarPanel(botonLiga, desplegableLiga);
        }
      };

      window.addEventListener("resize", () => {
        reposicionarMenuAbierto();
        if (!esSelectorMovil()) {
          devolverPanelAOrigen(desplegableInicio);
          devolverPanelAOrigen(desplegableLiga);
        }
      });
      window.addEventListener("scroll", reposicionarMenuAbierto, {
        passive: true
      });

      document.addEventListener("click", (evento) => {
        if (!(evento.target instanceof Node)) return;

        if (
          menuInicio &&
          !menuInicio.contains(evento.target) &&
          !desplegableInicio?.contains(evento.target)
        ) {
          cerrarInicio();
        }

        if (
          menuLiga &&
          !menuLiga.contains(evento.target) &&
          !desplegableLiga?.contains(evento.target)
        ) {
          cerrarLiga();
        }
      });

      const normalizarBusquedaMenu = (valor: string) =>
        valor
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .trim();

      const configurarBusquedaMenu = (
        input: HTMLInputElement | null,
        panel: HTMLElement | null,
        selectorItems: string
      ) => {
        if (!input || !panel) return;

        const botonLimpiar =
          input.parentElement?.querySelector<HTMLButtonElement>(
            ".limpiar-busqueda-menu"
          );

        const aplicar = () => {
          const valor = normalizarBusquedaMenu(input.value);
          const elementos =
            panel.querySelectorAll<HTMLElement>(selectorItems);

          elementos.forEach((elemento) => {
            const texto = normalizarBusquedaMenu(
              elemento.textContent ?? ""
            );

            const coincide = valor === "" || texto.includes(valor);
            elemento.hidden = !coincide;

            if (
              elemento instanceof HTMLDetailsElement &&
              valor !== ""
            ) {
              elemento.open = coincide;
            }
          });

          if (botonLimpiar) {
            botonLimpiar.hidden = input.value.length === 0;
          }
        };

        input.addEventListener("input", aplicar);

        botonLimpiar?.addEventListener("click", () => {
          input.value = "";
          aplicar();
          input.focus();
        });
      };

      configurarBusquedaMenu(
        buscarMenuGlobal,
        desplegableInicio,
        ".categoria-menu"
      );

      configurarBusquedaMenu(
        buscarMenuLiga,
        desplegableLiga,
        ".enlace-equipo-menu"
      );

      const listasDesplegables = $$<HTMLElement>(
        ".lista-categorias, .lista-equipos"
      );

      listasDesplegables.forEach((lista) => {
        lista.addEventListener(
          "wheel",
          (evento) => {
            const puedeBajar =
              lista.scrollTop + lista.clientHeight <
              lista.scrollHeight - 1;

            const puedeSubir = lista.scrollTop > 0;
            const bajando = evento.deltaY > 0;
            const subiendo = evento.deltaY < 0;

            /*
             * Deja actuar al scroll nativo dentro de la lista.
             * Solo bloquea la propagación para que no se mueva la página.
             */
            if (
              (bajando && puedeBajar) ||
              (subiendo && puedeSubir)
            ) {
              evento.stopPropagation();
              return;
            }

            evento.preventDefault();
            evento.stopPropagation();
          },
          { passive: false }
        );

        lista.addEventListener("pointerdown", (evento) => {
          evento.stopPropagation();
        });

        lista.addEventListener(
          "touchstart",
          (evento) => {
            evento.stopPropagation();
          },
          { passive: true }
        );
      });

      const categoriasMenu = $$<HTMLDetailsElement>(".categoria-menu");

      categoriasMenu.forEach((categoriaMenu) => {
        categoriaMenu.addEventListener("toggle", () => {
          if (!categoriaMenu.open) return;

          categoriasMenu.forEach((otraCategoria) => {
            if (otraCategoria !== categoriaMenu) {
              otraCategoria.open = false;
            }
          });
        });
      });

      const filtroTemporada =
        $<HTMLSelectElement>("#filtro-temporada");

      const filtrosRapidos =
        $$<HTMLButtonElement>(".filtro-rapido");

      const tarjetas = $$<HTMLButtonElement>(".foto");
      const contador = $<HTMLElement>("#contador-resultados");
      const sinFiltros = $<HTMLElement>("#sin-filtros");
      const observadorCarga = $<HTMLElement>("#cargar-mas-observador");
      const TAMANO_LOTE = 18;
      let limiteRenderizado = TAMANO_LOTE;
      let totalCoincidenciasFiltro = tarjetas.length;

      const parametrosIniciales = new URLSearchParams(location.search);
      let tipoActivo = parametrosIniciales.get("tipo") ?? "todos";
      const temporadaInicial =
        parametrosIniciales.get("temporada") ?? "todas";

      const sincronizarUrl = () => {
        const url = new URL(location.href);
        const temporada = filtroTemporada?.value ?? "todas";

        if (temporada === "todas") {
          url.searchParams.delete("temporada");
        } else {
          url.searchParams.set("temporada", temporada);
        }

        if (tipoActivo === "todos") {
          url.searchParams.delete("tipo");
        } else {
          url.searchParams.set("tipo", tipoActivo);
        }

        history.replaceState(null, "", url);
      };

      const actualizarLoteVisible = () => {
        const coincidentes = tarjetas.filter((tarjeta) => tarjeta.dataset.coincideFiltro === "true");
        coincidentes.forEach((tarjeta, indice) => {
          const fueraDelLote = indice >= limiteRenderizado;
          tarjeta.classList.toggle("fuera-lote", fueraDelLote);
          tarjeta.setAttribute("aria-hidden", String(fueraDelLote));
        });
        const mostradas = Math.min(limiteRenderizado, coincidentes.length);
        if (contador) contador.textContent = coincidentes.length === 1 ? "Mostrando 1 camiseta" : mostradas < coincidentes.length ? `Mostrando ${mostradas} de ${coincidentes.length} camisetas` : `Mostrando ${coincidentes.length} camisetas`;
        if (observadorCarga) observadorCarga.hidden = mostradas >= coincidentes.length || coincidentes.length === 0;
      };

      const aplicarFiltros = (actualizarUrl = true) => {
        const temporada = filtroTemporada?.value ?? "todas";
        totalCoincidenciasFiltro = 0;
        limiteRenderizado = TAMANO_LOTE;
        tarjetas.forEach((tarjeta) => {
          const coincideTemporada = temporada === "todas" || tarjeta.dataset.temporada === temporada;
          const coincideTipo = tipoActivo === "todos" || tarjeta.dataset.tipo === tipoActivo;
          const coincide = coincideTemporada && coincideTipo;
          tarjeta.hidden = !coincide;
          tarjeta.dataset.coincideFiltro = String(coincide);
          if (coincide) totalCoincidenciasFiltro++;
        });
        filtrosRapidos.forEach((boton) => {
          const activo = (boton.dataset.filtroTipo ?? "todos") === tipoActivo;
          boton.classList.toggle("activo", activo);
          boton.setAttribute("aria-pressed", String(activo));
        });
        if (sinFiltros) sinFiltros.hidden = totalCoincidenciasFiltro > 0;
        actualizarLoteVisible();
        if (actualizarUrl) sincronizarUrl();
      };

      const cargarSiguienteLote = () => {
        if (limiteRenderizado >= totalCoincidenciasFiltro) return;
        limiteRenderizado += TAMANO_LOTE;
        actualizarLoteVisible();
      };

      if (observadorCarga && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entradas) => {
          if (entradas.some((entrada) => entrada.isIntersecting)) cargarSiguienteLote();
        }, { rootMargin: "450px 0px" });
        observer.observe(observadorCarga);
      }

      if (
        filtroTemporada &&
        Array.from(filtroTemporada.options).some(
          (opcion) => opcion.value === temporadaInicial
        )
      ) {
        filtroTemporada.value = temporadaInicial;
      }

      if (
        !filtrosRapidos.some(
          (boton) =>
            (boton.dataset.filtroTipo ?? "todos") === tipoActivo
        )
      ) {
        tipoActivo = "todos";
      }

      filtroTemporada?.addEventListener("change", () =>
        aplicarFiltros()
      );

      filtrosRapidos.forEach((boton) => {
        boton.addEventListener("click", () => {
          tipoActivo = boton.dataset.filtroTipo ?? "todos";
          aplicarFiltros();
        });
      });

      aplicarFiltros(false);

      const visor = $<HTMLElement>("#visor");
      const visorImagen = $<HTMLImageElement>("#visor-imagen");
      const visorTitulo = $<HTMLElement>("#visor-titulo");
      const botonAnterior =
        $<HTMLButtonElement>(".visor-anterior");
      const botonSiguiente =
        $<HTMLButtonElement>(".visor-siguiente");
      const botonCerrar =
        $<HTMLButtonElement>(".visor-cerrar");
      const zoomMas = $<HTMLButtonElement>("#zoom-mas");
      const zoomMenos = $<HTMLButtonElement>("#zoom-menos");
      const zoomRestablecer =
        $<HTMLButtonElement>("#zoom-restablecer");
      const zoomValor = $<HTMLElement>("#zoom-valor");
      const visorMiniaturas =
        $<HTMLElement>("#visor-miniaturas");
      const visorImagenContenedor =
        $<HTMLElement>(".visor-imagen-contenedor");
      const visorContador = $<HTMLElement>("#visor-contador");
      const botonPantallaCompleta = $<HTMLButtonElement>("#visor-pantalla-completa");

      let indiceActual = 0;
      let nivelZoom = 1;
      let inicioDeslizamientoX = 0;
      let disparadorVisor: HTMLButtonElement | null = null;

      let desplazamientoX = 0;
      let desplazamientoY = 0;
      let arrastrandoImagen = false;
      let origenArrastreX = 0;
      let origenArrastreY = 0;
      let origenDesplazamientoX = 0;
      let origenDesplazamientoY = 0;

      const actualizarTransformacionImagen = () => {
        if (!visorImagen) return;

        visorImagen.style.transform =
          `translate3d(${desplazamientoX}px, ${desplazamientoY}px, 0) scale(${nivelZoom})`;

        visorImagen.classList.toggle(
          "ampliada",
          nivelZoom > 1
        );

        if (zoomValor) {
          zoomValor.textContent = `${Math.round(nivelZoom * 100)}%`;
        }
      };

      const actualizarZoom = () => {
        if (nivelZoom <= 1) {
          desplazamientoX = 0;
          desplazamientoY = 0;
        }

        actualizarTransformacionImagen();
      };

      const restablecerZoom = () => {
        nivelZoom = 1;
        desplazamientoX = 0;
        desplazamientoY = 0;
        actualizarTransformacionImagen();
      };

      const tarjetasVisibles = () =>
        tarjetas.filter((tarjeta) => !tarjeta.hidden && tarjeta.dataset.coincideFiltro === "true");

      const renderizarMiniaturas = () => {
        if (!visorMiniaturas) return;

        const visibles = tarjetasVisibles();
        visorMiniaturas.replaceChildren();

        if (visibles.length <= 1) {
          visorMiniaturas.hidden = true;
          return;
        }

        const fragmento = document.createDocumentFragment();

        visibles.forEach((tarjeta, indice) => {
          const boton = document.createElement("button");
          boton.type = "button";
          boton.className = "visor-miniatura";
          boton.classList.toggle("activa", indice === indiceActual);
          boton.setAttribute(
            "aria-label",
            `Abrir ${tarjeta.dataset.titulo ?? "camiseta"}`
          );

          const imagen = document.createElement("img");
          imagen.src =
            tarjeta.querySelector<HTMLImageElement>(".foto-imagen img")
              ?.currentSrc ||
            tarjeta.dataset.src ||
            tarjeta.dataset.fullSrc ||
            "";
          imagen.alt = "";
          imagen.width = 54;
          imagen.height = 68;
          imagen.loading = "lazy";
          imagen.decoding = "async";

          boton.append(imagen);
          boton.addEventListener("click", () => {
            mostrarEnVisor(tarjeta, true);
          });

          fragmento.append(boton);
        });

        visorMiniaturas.append(fragmento);
        visorMiniaturas.hidden = false;
      };

      const precargarVecinas = () => {
        const visibles = tarjetasVisibles();
        if (visibles.length < 2) return;

        [-1, 1].forEach((direccion) => {
          const indice =
            (indiceActual + direccion + visibles.length) %
            visibles.length;

          const src = visibles[indice]?.dataset.fullSrc;
          if (!src) return;

          const imagen = new Image();
          imagen.decoding = "async";
          imagen.src = src;
        });
      };

      const actualizarNavegacionVisor = () => {
        const visibles = tarjetasVisibles();
        const hayVarias = visibles.length > 1;
        if (botonAnterior) {
          botonAnterior.hidden = !hayVarias;
          botonAnterior.classList.toggle("sin-navegacion", !hayVarias);
          if (hayVarias) botonAnterior.removeAttribute("hidden");
        }
        if (botonSiguiente) {
          botonSiguiente.hidden = !hayVarias;
          botonSiguiente.classList.toggle("sin-navegacion", !hayVarias);
          if (hayVarias) botonSiguiente.removeAttribute("hidden");
        }
        if (visorContador) visorContador.textContent = `${indiceActual + 1} / ${Math.max(1, visibles.length)}`;
        requestAnimationFrame(() => visorMiniaturas?.querySelector<HTMLElement>(".visor-miniatura.activa")?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" }));
      };

      const mostrarEnVisor = (
        tarjeta: HTMLButtonElement,
        conservarDisparador = false
      ) => {
        if (!visor || !visorImagen || !visorTitulo) return;

        const visibles = tarjetasVisibles();
        const nuevoIndice = visibles.indexOf(tarjeta);
        if (nuevoIndice < 0) return;

        indiceActual = nuevoIndice;

        if (!conservarDisparador) {
          disparadorVisor = tarjeta;
        }

        visorImagen.style.opacity = "0";
        visorImagen.src =
          tarjeta.dataset.fullSrc ??
          tarjeta.dataset.src ??
          "";
        visorImagen.alt = tarjeta.dataset.titulo ?? "";
        visorTitulo.textContent = tarjeta.dataset.titulo ?? "";

        restablecerZoom();
        actualizarNavegacionVisor();
        renderizarMiniaturas();
        visor.classList.add("abierto");
        visor.setAttribute("aria-hidden", "false");
        document.body.classList.add("sin-scroll");

        requestAnimationFrame(() => {
          visor.focus({ preventScroll: true });
        });

        precargarVecinas();
      };

      visorImagen?.addEventListener("load", () => {
        visorImagen.style.opacity = "1";
      });

      const cerrarVisor = () => {
        if (!visor?.classList.contains("abierto")) return;

        visor.classList.remove("abierto");
        visor.setAttribute("aria-hidden", "true");
        document.body.classList.remove("sin-scroll");
        restablecerZoom();

        if (visorImagen) {
          visorImagen.removeAttribute("src");
          visorImagen.alt = "";
        }

        disparadorVisor?.focus({ preventScroll: true });
      };

      const cambiarImagen = (direccion: number) => {
        const visibles = tarjetasVisibles();
        if (visibles.length === 0) return;

        indiceActual =
          (indiceActual + direccion + visibles.length) %
          visibles.length;

        const tarjeta = visibles[indiceActual];
        if (tarjeta) {
          mostrarEnVisor(tarjeta, true);
        }
      };

      tarjetas.forEach((tarjeta) => {
        tarjeta.addEventListener("click", () =>
          mostrarEnVisor(tarjeta)
        );
      });

      $$<HTMLElement>("[data-cerrar-visor]").forEach((elemento) => {
        elemento.addEventListener("click", cerrarVisor);
      });

      botonAnterior?.addEventListener("click", () =>
        cambiarImagen(-1)
      );

      botonSiguiente?.addEventListener("click", () =>
        cambiarImagen(1)
      );

      zoomMas?.addEventListener("click", () => {
        nivelZoom = Math.min(2.5, nivelZoom + 0.25);
        actualizarZoom();
      });

      zoomMenos?.addEventListener("click", () => {
        nivelZoom = Math.max(0.75, nivelZoom - 0.25);
        actualizarZoom();
      });

      zoomRestablecer?.addEventListener(
        "click",
        restablecerZoom
      );

      visorImagen?.addEventListener("dblclick", () => {
        nivelZoom = nivelZoom === 1 ? 1.75 : 1;
        actualizarZoom();
      });

      visorImagen?.addEventListener(
        "wheel",
        (evento) => {
          if (!visor?.classList.contains("abierto")) return;
          evento.preventDefault();
          const anterior = nivelZoom;
          const siguiente = Math.min(3, Math.max(1, nivelZoom + (evento.deltaY < 0 ? 0.15 : -0.15)));
          if (siguiente === anterior) return;
          const rect = visorImagen.getBoundingClientRect();
          const cursorX = evento.clientX - (rect.left + rect.width / 2);
          const cursorY = evento.clientY - (rect.top + rect.height / 2);
          const proporcion = siguiente / anterior;
          desplazamientoX = cursorX - (cursorX - desplazamientoX) * proporcion;
          desplazamientoY = cursorY - (cursorY - desplazamientoY) * proporcion;
          nivelZoom = siguiente;
          actualizarZoom();
        },
        { passive: false }
      );

      visorImagen?.addEventListener("pointerdown", (evento) => {
        if (nivelZoom <= 1) return;

        arrastrandoImagen = true;
        origenArrastreX = evento.clientX;
        origenArrastreY = evento.clientY;
        origenDesplazamientoX = desplazamientoX;
        origenDesplazamientoY = desplazamientoY;

        visorImagen.setPointerCapture(evento.pointerId);
        visorImagen.classList.add("arrastrando");
        evento.preventDefault();
      });

      visorImagen?.addEventListener("pointermove", (evento) => {
        if (!arrastrandoImagen) return;

        desplazamientoX =
          origenDesplazamientoX +
          (evento.clientX - origenArrastreX);

        desplazamientoY =
          origenDesplazamientoY +
          (evento.clientY - origenArrastreY);

        actualizarTransformacionImagen();
      });

      const terminarArrastre = (evento?: PointerEvent) => {
        if (!arrastrandoImagen) return;

        arrastrandoImagen = false;
        visorImagen?.classList.remove("arrastrando");

        if (
          evento &&
          visorImagen?.hasPointerCapture(evento.pointerId)
        ) {
          visorImagen.releasePointerCapture(evento.pointerId);
        }
      };

      visorImagen?.addEventListener("pointerup", terminarArrastre);
      visorImagen?.addEventListener("pointercancel", terminarArrastre);
      visorImagen?.addEventListener("lostpointercapture", () => {
        arrastrandoImagen = false;
        visorImagen?.classList.remove("arrastrando");
      });

      botonPantallaCompleta?.addEventListener("click", async () => {
        try {
          if (document.fullscreenElement) await document.exitFullscreen();
          else await visor?.requestFullscreen();
        } catch {}
      });

      visor?.addEventListener(
        "touchstart",
        (evento) => {
          inicioDeslizamientoX =
            evento.touches[0]?.clientX ?? 0;
        },
        { passive: true }
      );

      visor?.addEventListener(
        "touchend",
        (evento) => {
          if (nivelZoom > 1) return;

          const finalX =
            evento.changedTouches[0]?.clientX ?? 0;
          const diferencia = finalX - inicioDeslizamientoX;

          if (Math.abs(diferencia) < 55) return;
          cambiarImagen(diferencia > 0 ? -1 : 1);
        },
        { passive: true }
      );

      document.addEventListener("keydown", (evento) => {
        const visorAbierto =
          visor?.classList.contains("abierto") ?? false;

        if (evento.key === "Escape") {
          cerrarInicio();
          cerrarLiga();
          cerrarVisor();
          return;
        }

        if (!visorAbierto) return;

        if (evento.key === "ArrowLeft") {
          evento.preventDefault();
          cambiarImagen(-1);
        }

        if (evento.key === "ArrowRight") { evento.preventDefault(); cambiarImagen(1); }
        if (evento.key === "Home") { evento.preventDefault(); const primera = tarjetasVisibles()[0]; if (primera) mostrarEnVisor(primera, true); }
        if (evento.key === "End") { evento.preventDefault(); const visibles = tarjetasVisibles(); const ultima = visibles[visibles.length - 1]; if (ultima) mostrarEnVisor(ultima, true); }
        if (evento.key.toLowerCase() === "f") { evento.preventDefault(); botonPantallaCompleta?.click(); }

        if (evento.key === "+" || evento.key === "=") {
          evento.preventDefault();
          nivelZoom = Math.min(2.5, nivelZoom + 0.25);
          actualizarZoom();
        }

        if (evento.key === "-") {
          evento.preventDefault();
          nivelZoom = Math.max(0.75, nivelZoom - 0.25);
          actualizarZoom();
        }

        if (evento.key === "0") {
          evento.preventDefault();
          restablecerZoom();
        }

        if (evento.key === "Tab" && visor) {
          const enfocables = $$<HTMLElement>(
            "#visor button:not([hidden]), #visor [href], #visor [tabindex]:not([tabindex='-1'])"
          ).filter(
            (elemento) =>
              !elemento.hasAttribute("disabled") &&
              elemento.offsetParent !== null
          );

          if (enfocables.length === 0) return;

          const primero = enfocables[0];
          const ultimo = enfocables[enfocables.length - 1];

          if (evento.shiftKey && document.activeElement === primero) {
            evento.preventDefault();
            ultimo?.focus();
          } else if (
            !evento.shiftKey &&
            document.activeElement === ultimo
          ) {
            evento.preventDefault();
            primero?.focus();
          }
        }
      });

      const claveScroll = `elite-scroll:${location.pathname}`;
      window.addEventListener("pagehide", () => sessionStorage.setItem(claveScroll, String(window.scrollY)));
      window.addEventListener("pageshow", (evento) => {
        document.body.classList.remove("sin-scroll");
        cerrarInicio();
        cerrarLiga();
        const posicion = Number(sessionStorage.getItem(claveScroll) ?? "0");
        if (evento.persisted || posicion > 0) requestAnimationFrame(() => window.scrollTo({ top: posicion, behavior: "instant" }));
        document.documentElement.classList.add("pagina-lista");
      });
      document.querySelectorAll<HTMLAnchorElement>("a[href^='/equipos/']").forEach((enlace) => enlace.addEventListener("click", () => {
        sessionStorage.setItem(claveScroll, String(window.scrollY));
        document.documentElement.classList.add("pagina-saliendo");
      }));
    </script>
  

