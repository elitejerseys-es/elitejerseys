  .categoria {
    position: relative;
    isolation: isolate;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 220ms ease,
      transform 220ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .categoria::before {
    content: "";
    position: absolute;
    inset: -30% auto auto -10%;
    z-index: -1;
    width: 280px;
    height: 180px;
    border-radius: 50%;
    pointer-events: none;
    background: color-mix(
      in srgb,
      var(--categoria-color) 10%,
      transparent
    );
    filter: blur(42px);
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .categoria-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .categoria:hover::before,
  .categoria:focus-within::before {
    opacity: 1;
  }

  .categoria-cabecera {
    min-height: 88px !important;
  }

  .categoria-textos strong {
    font-size: 19px !important;
  }

  .categoria-derecha {
    gap: 0 !important;
  }

  .flecha {
    width: 36px !important;
    height: 36px !important;
    background: #edf2ef !important;
  }

