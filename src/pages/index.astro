---
import fs from "node:fs";
import path from "node:path";

import {
  categorias,
  crearSlug,
  obtenerEscudo
} from "../data/catalogo";

const totalEquipos = categorias.reduce(
  (total, categoria) => total + categoria.equipos.length,
  0
);

const carpetaCamisetas = path.join(
  process.cwd(),
  "public",
  "camisetas"
);

let totalCamisetas = 0;

if (fs.existsSync(carpetaCamisetas)) {
  const carpetasEquipos = fs
    .readdirSync(carpetaCamisetas, { withFileTypes: true })
    .filter((entrada) => entrada.isDirectory());

  for (const carpeta of carpetasEquipos) {
    const rutaEquipo = path.join(carpetaCamisetas, carpeta.name);

    totalCamisetas += fs
      .readdirSync(rutaEquipo)
      .filter((archivo) =>
        /\.(jpg|jpeg|png|webp)$/i.test(archivo)
      ).length;
  }
}

const categoriasOrdenadas = categorias.map((categoria) => ({
  ...categoria,
  equipos: categoria.equipos
    .slice()
    .sort((a, b) => a.localeCompare(b, "es"))
}));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Catálogo online de camisetas de fútbol Elite Jerseys"
    />

    <meta name="theme-color" content="#111713" />

    <title>Elite Jerseys | Catálogo de camisetas de fútbol</title>
  </head>

  <body>
    <header class="cabecera">
      <div class="contenedor cabecera-interior">
        <a href="/" class="marca" aria-label="Página de inicio">
          <span class="marca-icono">EJ</span>

          <span class="marca-texto">
            <strong>Elite Jerseys</strong>
            <small>Catálogo de camisetas de fútbol</small>
          </span>
        </a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="contenedor hero-interior">
          <div class="hero-contenido">
            <span class="etiqueta-superior">
              CATÁLOGO INDEPENDIENTE
            </span>

            <h1>
              Camisetas de fútbol,
              <span>organizadas para explorar.</span>
            </h1>

            <p>
              Descubre clubes y selecciones por liga, equipo,
              temporada y tipo de equipación.
            </p>

            <div class="hero-acciones">
              <a href="#catalogo" class="boton boton-principal">
                Explorar catálogo
              </a>

              <a href="#buscar" class="boton boton-secundario">
                Buscar equipo
              </a>
            </div>

            <div class="estadisticas" aria-label="Estadísticas del catálogo">
              <div class="estadistica">
                <strong>{categorias.length}</strong>
                <span>Categorías</span>
              </div>

              <div class="estadistica">
                <strong>{totalEquipos}</strong>
                <span>Equipos</span>
              </div>

              <div class="estadistica">
                <strong>{totalCamisetas}</strong>
                <span>Camisetas</span>
              </div>
            </div>
          </div>

          <div class="hero-visual" aria-hidden="true">
            <div class="hero-tarjeta">
              <div class="hero-marca">
                <span class="corona">♛</span>
                <strong>EJ</strong>
                <span>ELITE</span>
                <small>JERSEYS</small>
              </div>

              <div class="hero-categorias">
                {
                  categoriasOrdenadas.slice(0, 5).map((categoria) => (
                    <div class="hero-categoria">
                      <img src={categoria.logo} alt="" />
                      <span>{categoria.nombre}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="catalogo" class="catalogo contenedor">
        <div class="seccion-cabecera">
          <div>
            <span class="etiqueta-seccion">CATÁLOGO</span>
            <h2>Ligas y selecciones</h2>

            <p>
              Abre una categoría para consultar todos sus equipos.
            </p>
          </div>

          <span class="contador-categorias">
            {categorias.length} categorías
          </span>
        </div>

        <div id="buscar" class="buscador-contenedor">
          <div class="buscador-cabecera">
            <div>
              <span class="etiqueta-busqueda">BUSCADOR</span>
              <h3>Encuentra tu equipo</h3>
            </div>

            <span class="atajo-teclado">Escribe para buscar</span>
          </div>

          <div class="buscador">
            <span class="icono-busqueda" aria-hidden="true">⌕</span>

            <input
              id="buscador-equipos"
              type="search"
              placeholder="Real Madrid, Arsenal, Milan, España..."
              autocomplete="off"
              aria-label="Buscar equipo"
            />

            <button
              id="limpiar-buscador"
              type="button"
              aria-label="Borrar búsqueda"
              hidden
            >
              ×
            </button>
          </div>

          <p id="resultado-busqueda" class="resultado-busqueda">
            Escribe el nombre de un equipo para encontrarlo rápidamente.
          </p>

          <div
            id="resultados-directos"
            class="resultados-directos"
            hidden
          ></div>
        </div>

        <section class="categorias">
          {
            categoriasOrdenadas.map((categoria, indice) => (
              <article
                class="categoria"
                data-categoria={categoria.nombre.toLowerCase()}
                style={`--indice:${indice}`}
              >
                <button
                  class="categoria-cabecera"
                  type="button"
                  aria-expanded="false"
                >
                  <div class="categoria-info">
                    <div class="logo-liga">
                      <img
                        src={categoria.logo}
                        alt={`Logotipo de ${categoria.nombre}`}
                        loading="lazy"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                      />

                      <span class="logo-provisional">⚽</span>
                    </div>

                    <span class="categoria-textos">
                      <strong>{categoria.nombre}</strong>

                      <small>
                        {categoria.equipos.length} equipos
                      </small>
                    </span>
                  </div>

                  <div class="categoria-vista-previa" aria-hidden="true">
                    {
                      categoria.equipos.slice(0, 6).map((equipo) => (
                        <span class="mini-escudo">
                          <img
                            src={obtenerEscudo(equipo)}
                            alt=""
                            loading="lazy"
                            onerror="this.style.display='none'"
                          />
                        </span>
                      ))
                    }
                  </div>

                  <span class="categoria-derecha">
                    <span class="ver-equipos">Ver equipos</span>
                    <span class="flecha">⌄</span>
                  </span>
                </button>

                <div class="equipos" hidden>
                  {
                    categoria.equipos.map((equipo) => (
                      <a
                        class="equipo"
                        href={`/equipos/${crearSlug(equipo)}`}
                        data-equipo={equipo.toLowerCase()}
                      >
                        <div class="escudo">
                          <img
                            src={obtenerEscudo(equipo)}
                            alt={`Escudo de ${equipo}`}
                            loading="lazy"
                            onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                          />

                          <span class="escudo-provisional">
                            {equipo.charAt(0)}
                          </span>
                        </div>

                        <span class="nombre-equipo">{equipo}</span>
                        <span class="flecha-equipo">›</span>
                      </a>
                    ))
                  }
                </div>
              </article>
            ))
          }
        </section>

        <div id="sin-resultados" class="sin-resultados" hidden>
          <span>⚽</span>
          <h3>No se encontraron equipos</h3>
          <p>Prueba con otro nombre o elimina la búsqueda.</p>
        </div>
      </section>
    </main>

    <footer class="pie">
      <div class="contenedor pie-interior">
        <div>
          <strong>Elite Jerseys</strong>
          <p>Catálogo independiente de camisetas de fútbol.</p>
        </div>

        <a href="#">Volver arriba ↑</a>
      </div>
    </footer>

    <script>
      const botonesCategoria =
        document.querySelectorAll<HTMLButtonElement>(
          ".categoria-cabecera"
        );

      const categoriasElementos =
        document.querySelectorAll<HTMLElement>(".categoria");

      const buscador =
        document.querySelector<HTMLInputElement>("#buscador-equipos");

      const botonLimpiar =
        document.querySelector<HTMLButtonElement>("#limpiar-buscador");

      const textoResultado =
        document.querySelector<HTMLElement>("#resultado-busqueda");

      const sinResultados =
        document.querySelector<HTMLElement>("#sin-resultados");

      const resultadosDirectos =
        document.querySelector<HTMLElement>("#resultados-directos");

      const cerrarCategorias = (
        excepcion?: HTMLButtonElement
      ) => {
        botonesCategoria.forEach((otroBoton) => {
          if (otroBoton === excepcion) return;

          otroBoton.setAttribute("aria-expanded", "false");

          const otroContenido = otroBoton.nextElementSibling;

          if (otroContenido instanceof HTMLElement) {
            otroContenido.hidden = true;
          }
        });
      };

      botonesCategoria.forEach((boton) => {
        boton.addEventListener("click", () => {
          const contenido = boton.nextElementSibling;
          const abierto =
            boton.getAttribute("aria-expanded") === "true";

          cerrarCategorias(boton);

          boton.setAttribute(
            "aria-expanded",
            String(!abierto)
          );

          if (contenido instanceof HTMLElement) {
            contenido.hidden = abierto;
          }
        });
      });

      const normalizarTexto = (texto: string) =>
        texto
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .trim();

      const filtrarEquipos = () => {
        const busqueda = normalizarTexto(
          buscador?.value ?? ""
        );

        let totalCoincidencias = 0;

        const coincidencias: {
          nombre: string;
          href: string;
          escudo: string;
          categoria: string;
        }[] = [];

        categoriasElementos.forEach((categoria) => {
          const botonesEquipos =
            categoria.querySelectorAll<HTMLAnchorElement>(".equipo");

          const botonCategoria =
            categoria.querySelector<HTMLButtonElement>(
              ".categoria-cabecera"
            );

          const contenidoEquipos =
            categoria.querySelector<HTMLElement>(".equipos");

          const nombreCategoria =
            categoria
              .querySelector<HTMLElement>(".categoria-textos strong")
              ?.textContent?.trim() ?? "";

          let coincidenciasCategoria = 0;

          botonesEquipos.forEach((equipo) => {
            const nombreOriginal =
              equipo
                .querySelector<HTMLElement>(".nombre-equipo")
                ?.textContent?.trim() ?? "";

            const nombreNormalizado =
              normalizarTexto(nombreOriginal);

            const coincide =
              busqueda === "" ||
              nombreNormalizado.includes(busqueda);

            equipo.hidden = !coincide;

            if (coincide && busqueda !== "") {
              coincidenciasCategoria += 1;
              totalCoincidencias += 1;

              coincidencias.push({
                nombre: nombreOriginal,
                href: equipo.getAttribute("href") ?? "#",
                escudo:
                  equipo
                    .querySelector<HTMLImageElement>(".escudo img")
                    ?.getAttribute("src") ?? "",
                categoria: nombreCategoria
              });
            }
          });

          const mostrarCategoria =
            busqueda === "" || coincidenciasCategoria > 0;

          categoria.hidden = !mostrarCategoria;

          if (
            busqueda !== "" &&
            coincidenciasCategoria > 0 &&
            botonCategoria &&
            contenidoEquipos
          ) {
            botonCategoria.setAttribute(
              "aria-expanded",
              "true"
            );

            contenidoEquipos.hidden = false;
          }

          if (
            busqueda === "" &&
            botonCategoria &&
            contenidoEquipos
          ) {
            botonCategoria.setAttribute(
              "aria-expanded",
              "false"
            );

            contenidoEquipos.hidden = true;
          }
        });

        if (resultadosDirectos) {
          resultadosDirectos.innerHTML = "";

          if (busqueda !== "" && coincidencias.length > 0) {
            coincidencias.slice(0, 8).forEach((resultado) => {
              const enlace = document.createElement("a");
              enlace.className = "resultado-directo";
              enlace.href = resultado.href;

              const imagen = document.createElement("img");
              imagen.src = resultado.escudo;
              imagen.alt = "";
              imagen.loading = "lazy";

              const textos = document.createElement("span");
              textos.className = "resultado-directo-textos";

              const nombre = document.createElement("strong");
              nombre.textContent = resultado.nombre;

              const categoria = document.createElement("small");
              categoria.textContent = resultado.categoria;

              const flecha = document.createElement("span");
              flecha.className = "resultado-directo-flecha";
              flecha.textContent = "›";

              textos.append(nombre, categoria);
              enlace.append(imagen, textos, flecha);
              resultadosDirectos.appendChild(enlace);
            });

            resultadosDirectos.hidden = false;
          } else {
            resultadosDirectos.hidden = true;
          }
        }

        if (botonLimpiar) {
          botonLimpiar.hidden = busqueda === "";
        }

        if (textoResultado) {
          if (busqueda === "") {
            textoResultado.textContent =
              "Escribe el nombre de un equipo para encontrarlo rápidamente.";
          } else if (totalCoincidencias === 1) {
            textoResultado.textContent =
              "Se ha encontrado 1 equipo. Pulsa el resultado para abrirlo.";
          } else {
            textoResultado.textContent =
              `Se han encontrado ${totalCoincidencias} equipos.`;
          }
        }

        if (sinResultados) {
          sinResultados.hidden =
            busqueda === "" || totalCoincidencias > 0;
        }
      };

      buscador?.addEventListener("input", filtrarEquipos);

      botonLimpiar?.addEventListener("click", () => {
        if (!buscador) return;

        buscador.value = "";
        filtrarEquipos();
        buscador.focus();
      });
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    color: #172019;
    background:
      radial-gradient(circle at 50% 0%, rgba(213, 168, 61, 0.05), transparent 28rem),
      #f2f5f3;
  }

  :global(button),
  :global(input) {
    font: inherit;
  }

  :global(button:focus-visible),
  :global(a:focus-visible),
  :global(input:focus-visible) {
    outline: 3px solid rgba(22, 128, 90, 0.22);
    outline-offset: 3px;
  }

  .contenedor {
    width: min(1320px, calc(100% - 40px));
    margin: 0 auto;
  }

  .cabecera {
    position: sticky;
    top: 0;
    z-index: 1000;
    border-bottom: 1px solid rgba(20, 30, 25, 0.08);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(18px);
  }

  .cabecera-interior {
    min-height: 74px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }

  .marca-icono {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(213, 168, 61, 0.2);
    border-radius: 14px;
    color: #d7ad4d;
    font-size: 17px;
    font-weight: 950;
    letter-spacing: -1px;
    background: linear-gradient(145deg, #17231c, #080c0a);
    box-shadow:
      0 10px 25px rgba(9, 16, 12, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .marca-texto strong {
    display: block;
    color: #111713;
    font-size: 18px;
    line-height: 1.1;
  }

  .marca-texto small {
    display: block;
    margin-top: 4px;
    color: #748078;
    font-size: 11px;
  }

  .hero {
    position: relative;
    overflow: hidden;
    color: white;
    background:
      radial-gradient(circle at 84% 16%, rgba(213, 168, 61, 0.2), transparent 30%),
      radial-gradient(circle at 8% 100%, rgba(23, 132, 92, 0.23), transparent 40%),
      linear-gradient(135deg, #111914 0%, #1a2a21 100%);
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.055;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.5) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.5) 1px, transparent 1px);
    background-size: 46px 46px;
  }

  .hero-interior {
    position: relative;
    min-height: 520px;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(340px, 0.8fr);
    align-items: center;
    gap: 70px;
    padding-top: 64px;
    padding-bottom: 64px;
  }

  .hero-contenido {
    max-width: 760px;
  }

  .etiqueta-superior {
    color: #dfbd68;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 2.4px;
  }

  .hero h1 {
    max-width: 760px;
    margin: 18px 0;
    font-size: clamp(44px, 6vw, 76px);
    line-height: 0.98;
    letter-spacing: -3.4px;
  }

  .hero h1 span {
    display: block;
    color: #dfbd68;
  }

  .hero-contenido > p {
    max-width: 650px;
    margin: 0;
    color: #c7d0ca;
    font-size: 17px;
    line-height: 1.7;
  }

  .hero-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .boton {
    min-height: 47px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border-radius: 11px;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      background 0.18s ease;
  }

  .boton:hover {
    transform: translateY(-2px);
  }

  .boton-principal {
    color: #132019;
    background: #dfbd68;
  }

  .boton-principal:hover {
    background: #edca74;
  }

  .boton-secundario {
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: white;
    background: rgba(255, 255, 255, 0.07);
  }

  .estadisticas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .estadistica {
    min-width: 120px;
    padding: 13px 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(8px);
  }

  .estadistica strong {
    display: block;
    color: #dfbd68;
    font-size: 20px;
  }

  .estadistica span {
    display: block;
    margin-top: 4px;
    color: #aebbb3;
    font-size: 11px;
  }

  .hero-visual {
    display: grid;
    place-items: center;
  }

  .hero-tarjeta {
    width: min(390px, 100%);
    padding: 25px;
    border: 1px solid rgba(223, 189, 104, 0.24);
    border-radius: 28px;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.09),
        rgba(255, 255, 255, 0.025)
      );
    box-shadow:
      0 30px 70px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    transform: rotate(2deg);
  }

  .hero-marca {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 18px 0 24px;
  }

  .hero-marca .corona {
    color: #dfbd68;
    font-size: 26px;
  }

  .hero-marca strong {
    margin-top: -5px;
    color: #dfbd68;
    font-size: 67px;
    font-style: italic;
    line-height: 1;
    letter-spacing: -8px;
  }

  .hero-marca > span:not(.corona) {
    margin-top: 4px;
    color: #dfbd68;
    font-size: 22px;
    letter-spacing: 8px;
  }

  .hero-marca small {
    margin-top: 7px;
    color: #dfbd68;
    font-size: 9px;
    letter-spacing: 5px;
  }

  .hero-categorias {
    display: grid;
    gap: 7px;
  }

  .hero-categoria {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 11px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    color: #d3dbd6;
    font-size: 11px;
    background: rgba(255, 255, 255, 0.04);
  }

  .hero-categoria img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .catalogo {
    padding-top: 68px;
    padding-bottom: 92px;
  }

  .seccion-cabecera {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 25px;
    margin-bottom: 28px;
  }

  .etiqueta-seccion,
  .etiqueta-busqueda {
    color: #16805a;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 2.2px;
  }

  .seccion-cabecera h2 {
    margin: 9px 0 7px;
    color: #141a16;
    font-size: clamp(31px, 5vw, 44px);
    letter-spacing: -1.4px;
  }

  .seccion-cabecera p {
    margin: 0;
    color: #748078;
  }

  .contador-categorias {
    flex: 0 0 auto;
    padding: 8px 12px;
    border: 1px solid #dce3df;
    border-radius: 999px;
    color: #607068;
    font-size: 11px;
    font-weight: 750;
    background: white;
  }

  .buscador-contenedor {
    margin-bottom: 28px;
    padding: 20px;
    border: 1px solid #e0e5e2;
    border-radius: 17px;
    background: white;
    box-shadow:
      0 10px 30px rgba(19, 31, 24, 0.05),
      inset 0 1px 0 white;
  }

  .buscador-cabecera {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 13px;
  }

  .buscador-cabecera h3 {
    margin: 5px 0 0;
