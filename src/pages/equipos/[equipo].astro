---
import fs from "node:fs";
import path from "node:path";

import {
  categorias,
  crearSlug,
  obtenerEscudo
} from "../../data/catalogo";

export function getStaticPaths() {
  return categorias.flatMap((categoria) =>
    categoria.equipos.map((equipo) => ({
      params: {
        equipo: crearSlug(equipo)
      },
      props: {
        equipo,
        categoria: categoria.nombre
      }
    }))
  );
}

interface Props {
  equipo: string;
  categoria: string;
}

interface Camiseta {
  src: string;
  temporada: string;
  tipo: string;
  tipoSlug: string;
  ordenTemporada: number;
  ordenTipo: number;
}

const { equipo, categoria } = Astro.props;

const equipoSlug = crearSlug(equipo);

const categoriaActual = categorias.find(
  (item) => item.nombre === categoria
);

const equiposCategoria = categoriaActual
  ? categoriaActual.equipos
      .slice()
      .sort((a, b) => a.localeCompare(b, "es"))
  : [];

const categoriasOrdenadas = categorias.map((item) => ({
  ...item,
  equipos: item.equipos
    .slice()
    .sort((a, b) => a.localeCompare(b, "es"))
}));

const indiceEquipoActual = equiposCategoria.indexOf(equipo);

const equipoAnterior =
  indiceEquipoActual > 0
    ? equiposCategoria[indiceEquipoActual - 1]
    : equiposCategoria[equiposCategoria.length - 1];

const equipoSiguiente =
  indiceEquipoActual >= 0 && indiceEquipoActual < equiposCategoria.length - 1
    ? equiposCategoria[indiceEquipoActual + 1]
    : equiposCategoria[0];

const carpetaEquipo = path.join(
  process.cwd(),
  "public",
  "camisetas",
  equipoSlug
);

const ordenTipos: Record<string, number> = {
  local: 1,
  visitante: 2,
  tercera: 3,
  cuarta: 4,
  portero: 5,
  entrenamiento: 6
};

const convertirTipo = (tipo: string) =>
  tipo
    .split("-")
    .map((parte) => parte.charAt(0).toUpperCase() + parte.slice(1))
    .join(" ");

const camisetas: Camiseta[] = [];

if (fs.existsSync(carpetaEquipo)) {
  const archivos = fs
    .readdirSync(carpetaEquipo)
    .filter((archivo) =>
      /^\d{4}-\d{4}-.+\.(jpg|jpeg|png|webp)$/i.test(archivo)
    );

  for (const archivo of archivos) {
    const sinExtension = archivo.replace(
      /\.(jpg|jpeg|png|webp)$/i,
      ""
    );

    const partes = sinExtension.split("-");

    const inicio = partes[0];
    const fin = partes[1];
    const tipoSlug = partes.slice(2).join("-");

    if (!inicio || !fin || !tipoSlug) continue;

    camisetas.push({
      src: `/camisetas/${equipoSlug}/${archivo}`,
      temporada: `${inicio}/${fin}`,
      tipo: convertirTipo(tipoSlug),
      tipoSlug,
      ordenTemporada: Number(inicio),
      ordenTipo: ordenTipos[tipoSlug] ?? 99
    });
  }
}

camisetas.sort((a, b) => {
  if (a.ordenTemporada !== b.ordenTemporada) {
    return b.ordenTemporada - a.ordenTemporada;
  }

  return a.ordenTipo - b.ordenTipo;
});

const temporadas = [...new Set(camisetas.map((camiseta) => camiseta.temporada))];
const tipos = [...new Set(camisetas.map((camiseta) => camiseta.tipoSlug))]
  .sort((a, b) => (ordenTipos[a] ?? 99) - (ordenTipos[b] ?? 99));

