<!-- =========================================================
     ELITE JERSEYS · VISOR V11
     Visor independiente. Este bloque debe permanecer al FINAL.
     ========================================================= -->
<div id="ej-v11" class="ej-v11" aria-hidden="true">
  <button id="ej-v11-close" class="ej-v11-close" type="button" aria-label="Cerrar">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
  </button>

  <button id="ej-v11-prev" class="ej-v11-arrow ej-v11-prev" type="button" aria-label="Anterior">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4 7 12l8 8"/></svg>
  </button>

  <div class="ej-v11-stage">
    <img id="ej-v11-img" alt="" />
  </div>

  <button id="ej-v11-next" class="ej-v11-arrow ej-v11-next" type="button" aria-label="Siguiente">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 4 8 8-8 8"/></svg>
  </button>
</div>

<script>
  (() => {
    const visor = document.getElementById("ej-v11");
    const imagen = document.getElementById("ej-v11-img");
    const anterior = document.getElementById("ej-v11-prev");
    const siguiente = document.getElementById("ej-v11-next");
    const cerrar = document.getElementById("ej-v11-close");
    if (!visor || !imagen || !anterior || !siguiente || !cerrar) return;

    let tarjetas = [];
    let indice = 0;
    let inicioX = 0;

    const tarjetasVisibles = () =>
      Array.from(document.querySelectorAll(".foto")).filter((el) => {
        const estilo = getComputedStyle(el);
        return estilo.display !== "none" && estilo.visibility !== "hidden";
      });

    const srcDe = (tarjeta) => {
      const img = tarjeta?.querySelector?.(".foto-imagen img") || tarjeta?.querySelector?.("img");
      return (
        tarjeta?.dataset?.fullSrc ||
        tarjeta?.dataset?.src ||
        img?.currentSrc ||
        img?.src ||
        ""
      );
    };

    const tituloDe = (tarjeta) =>
      tarjeta?.dataset?.titulo ||
      tarjeta?.querySelector?.("img")?.alt ||
      "Camiseta";

    const pintar = () => {
      if (!tarjetas.length) return;
      indice = (indice + tarjetas.length) % tarjetas.length;
      const tarjeta = tarjetas[indice];
      imagen.src = srcDe(tarjeta);
      imagen.alt = tituloDe(tarjeta);

      const hayVarias = tarjetas.length > 1;
      anterior.hidden = !hayVarias;
      siguiente.hidden = !hayVarias;
    };

    const abrir = (tarjeta) => {
      tarjetas = tarjetasVisibles();
      indice = Math.max(0, tarjetas.indexOf(tarjeta));
      pintar();

      // Neutraliza por completo el visor antiguo.
      const viejo = document.getElementById("visor");
      if (viejo) {
        viejo.classList.remove("abierto");
        viejo.setAttribute("aria-hidden", "true");
      }

      visor.classList.add("ej-v11-open");
      visor.setAttribute("aria-hidden", "false");
      document.documentElement.classList.add("ej-v11-lock");
      document.body.classList.add("ej-v11-lock");
    };

    const salir = () => {
      visor.classList.remove("ej-v11-open");
      visor.setAttribute("aria-hidden", "true");
      imagen.removeAttribute("src");
      document.documentElement.classList.remove("ej-v11-lock");
      document.body.classList.remove("ej-v11-lock", "sin-scroll");
    };

    // Captura el clic ANTES que el visor anterior.
    document.addEventListener("click", (e) => {
      // El botón del pedido vive dentro de .foto. Debe pasar al
      // manejador del carrito sin activar el visor de la camiseta.
      if (e.target.closest?.(".ej-order-add")) return;

      const tarjeta = e.target.closest?.(".foto");
      if (!tarjeta) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      abrir(tarjeta);
    }, true);

    anterior.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      indice -= 1;
      pintar();
    });

    siguiente.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      indice += 1;
      pintar();
    });

    cerrar.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      salir();
    });

    document.addEventListener("keydown", (e) => {
      if (!visor.classList.contains("ej-v11-open")) return;
      if (e.key === "Escape") salir();
      if (e.key === "ArrowLeft" && tarjetas.length > 1) {
        indice -= 1; pintar();
      }
      if (e.key === "ArrowRight" && tarjetas.length > 1) {
        indice += 1; pintar();
      }
    });

    visor.addEventListener("touchstart", (e) => {
      inicioX = e.changedTouches[0]?.clientX || 0;
    }, { passive: true });

    visor.addEventListener("touchend", (e) => {
      if (tarjetas.length < 2) return;
      const finX = e.changedTouches[0]?.clientX || 0;
      const distancia = finX - inicioX;
      if (Math.abs(distancia) < 45) return;
      indice += distancia < 0 ? 1 : -1;
      pintar();
    }, { passive: true });
  })();
</script>

