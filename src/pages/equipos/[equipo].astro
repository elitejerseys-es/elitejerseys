<script>
import { createClient } from "@supabase/supabase-js";

(() => {
  const RECEIVER = "34689733097";
  const FORMSPREE_ENDPOINT = "https://formspree.io/f/xvkzkkao";
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const supabase = SUPABASE_URL && SUPABASE_KEY
    ? createClient(SUPABASE_URL, SUPABASE_KEY)
    : null;

  const STORE = "eliteJerseysPedidoV1";
  const ORDER_ID_STORE = "eliteJerseysPendingOrderIdV1";
  const DB_SAVED_STORE = "eliteJerseysSupabaseSavedOrderV1";
  const $ = s => document.querySelector(s);
  const TEAM_CATEGORY = $("#ej-order-panel")?.dataset.category || "";
  const IS_NATIONAL_LEAGUE = TEAM_CATEGORY !== "Selecciones";
  const $$ = s => [...document.querySelectorAll(s)];
  let current = null;
  let cart = [];
  try { cart = JSON.parse(localStorage.getItem(STORE) || "[]"); } catch {}

  const adultSizes = ["S","M","L","XL","2XL","3XL"];
  const childSizes = ["16","18","20","22","24","26","28"];

  const overlay=$("#ej-order-overlay"), config=$("#ej-config-view"), cartView=$("#ej-cart-view");
  const productType=$("#ej-product-type"), version=$("#ej-version"), size=$("#ej-size"), qty=$("#ej-qty");
  const qtyMinus=$("#ej-qty-minus"), qtyPlus=$("#ej-qty-plus");
  const personalize=$("#ej-personalize"), patches=$("#ej-patches");
  const patchType=$("#ej-patch-type"), patchTypeWrap=$("#ej-patch-type-wrap");

  function money(n){ return `${n.toFixed(2).replace(".00","")} €`; }
  function save(){ localStorage.setItem(STORE, JSON.stringify(cart)); renderCart(); }
  function show(view){
    overlay.classList.add("is-open"); overlay.setAttribute("aria-hidden","false");
    config.classList.toggle("is-active",view==="config");
    cartView.classList.toggle("is-active",view==="cart");
    $("#ej-order-title").textContent=view==="config"?"Configurar camiseta":"Mi pedido";
    document.documentElement.style.overflow="hidden";
  }
  function close(){overlay.classList.remove("is-open");overlay.setAttribute("aria-hidden","true");document.documentElement.style.overflow="";}
  function fillSizes(){
    const arr=productType.value==="nino"?childSizes:adultSizes;
    size.innerHTML=arr.map(x=>`<option>${x}</option>`).join("");
    $("#ej-version-wrap").classList.toggle("ej-order-hidden",productType.value==="nino");
    calc();
  }
  function unitPrice(){
    let p=productType.value==="nino"?12:(version.value==="jugador"?12:9);
    if(personalize.checked)p+=3;
    if(patches.checked)p+=1;
    return p;
  }
  function calc(){
    const q=Math.min(20,Math.max(1,parseInt(qty.value)||1));
    qty.value=String(q);
    $("#ej-line-price").textContent=money(unitPrice()*q);
  }
  if(qtyMinus) qtyMinus.onclick=()=>{
    qty.value=String(Math.max(1,(parseInt(qty.value,10)||1)-1));
    calc();
  };
  if(qtyPlus) qtyPlus.onclick=()=>{
    qty.value=String(Math.min(20,(parseInt(qty.value,10)||1)+1));
    calc();
  };

  function detectCard(btn){
    const card=btn.closest("article, .camiseta-card, .card, li, div");
    const img=card?.querySelector("img");
    const text=(card?.innerText||"").replace(/Añadir al pedido/gi,"").trim();
    return {card,img,text};
  }
  function addButtons(){
    const imgs=$$("img").filter(img=>{
      const src=img.getAttribute("src")||"";
      return /\/camisetas\//i.test(src) && !img.closest("#ej-order-overlay");
    });
    imgs.forEach(img=>{
      const card=img.closest("article, .camiseta-card, .card") || img.parentElement?.parentElement;
      if(!card || card.querySelector(".ej-order-add")) return;
      const b=document.createElement("button");
      b.type="button"; b.className="ej-order-add"; b.textContent="Añadir al pedido";
      b.setAttribute("aria-label","Añadir esta camiseta al pedido");
      b.dataset.image=card.dataset?.fullSrc || img.currentSrc || img.src;
      b.dataset.temporada=card.dataset?.temporada || "";
      b.dataset.tipo=card.dataset?.tipo || "";
      card.appendChild(b);
    });
  }
  function openConfig(btn){
    const send=$("#ej-send-order");
    const status=$("#ej-order-status");
    if(send && send.textContent.includes("Pedido enviado")){
      cart=[];
      localStorage.removeItem(STORE);
      send.disabled=false;
      send.textContent="Enviar pedido";
      if(status){status.className="ej-order-status";status.textContent="";}
      $("#ej-new-order")?.classList.add("ej-order-hidden");
      renderCart();
    }
    const {card,img,text}=detectCard(btn);
    current={
      image:btn.dataset.image || card?.dataset?.fullSrc || img?.currentSrc || img?.src || "",
      name:(document.querySelector("h1")?.textContent||document.title.split("|")[0]||"Camiseta").trim(),
      detail:text || "Camiseta",
      temporada:btn.dataset.temporada || card?.dataset?.temporada || "",
      tipo:btn.dataset.tipo || card?.dataset?.tipo || ""
    };
    $("#ej-order-img").src=current.image;
    $("#ej-order-name").textContent=current.name;
    $("#ej-order-detail").textContent=current.detail.slice(0,120);
    productType.value="adulto"; version.value="aficionado"; qty.value="1";
    personalize.checked=false; patches.checked=false;
    if(patchType) patchType.value="LIGA";
    patchTypeWrap?.classList.add("ej-order-hidden");
    $("#ej-player-name").value=""; $("#ej-player-number").value="";
    $("#ej-personal-fields").classList.add("ej-order-hidden");
    fillSizes(); show("config");
  }
  function renderCart(){
    $("#ej-order-count").textContent=cart.reduce((a,x)=>a+x.qty,0);
    const box=$("#ej-cart-items"), checkout=$("#ej-cart-checkout");
    const summary=$("#ej-cart-summary");
    if(!cart.length){
      box.innerHTML='<div class="ej-cart-empty"><b>Tu pedido está vacío</b><br><br>Añade una camiseta desde el catálogo.</div>';
      if(summary){ summary.textContent=""; summary.classList.add("ej-order-hidden"); }
      checkout.classList.add("ej-order-hidden"); return;
    }
    if(summary){
      const units=cart.reduce((a,x)=>a+safeQty(x.qty),0);
      summary.innerHTML=`<strong>${units}</strong> ${units===1?"artículo":"artículos"} en tu pedido`;
      summary.classList.remove("ej-order-hidden");
    }
    checkout.classList.remove("ej-order-hidden");
    box.innerHTML=cart.map((x,i)=>{
      const isChild=x.product==="Conjunto niño";
      const productText=isChild?"Conjunto niño":"Camiseta adulto";
      const versionText=isChild?"Única":(/Jugador/i.test(x.product||"")?"Jugador":"Aficionado");
      const personalization=x.personalize?`${x.playerName || "—"} ${x.playerNumber || ""}`:"No";
      return `
      <article class="ej-v29-item ej-v31-item">
        <div class="ej-v31-article-head">
          <div>
            <span class="ej-v31-kicker">ARTÍCULO ${i+1}</span>
            <strong>Detalle de la camiseta</strong>
          </div>
        </div>
        <div class="ej-v29-row ej-v29-team">
          <span>Equipo</span>
          <strong>${x.name}</strong>
        </div>
        <div class="ej-v29-row">
          <span>Producto</span>
          <strong>${productText}</strong>
        </div>
        <div class="ej-v29-row">
          <span>Versión</span>
          <strong>${versionText}</strong>
        </div>
        <div class="ej-v29-row">
          <span>Talla</span>
          <strong>${x.size}</strong>
        </div>
        <div class="ej-v29-row">
          <span>Cantidad</span>
          <strong>${x.qty}</strong>
        </div>
        <div class="ej-v29-row">
          <span>Nombre + dorsal</span>
          <strong>${personalization}</strong>
        </div>
        <div class="ej-v29-row">
          <span>Parches</span>
          <strong>${x.patches?(x.patchType || "Sí"):"No"}</strong>
        </div>
        <div class="ej-v29-row ej-v29-price">
          <span>Importe del artículo</span>
          <strong>${money(x.total)}</strong>
        </div>
        <button class="ej-v29-remove" data-remove="${i}" type="button" aria-label="Eliminar ${x.name} del pedido">
          <span aria-hidden="true">×</span> Eliminar artículo
        </button>
      </article>`;
    }).join("");
    $("#ej-cart-total").textContent=money(cart.reduce((a,x)=>a+x.total,0));
  }

  document.addEventListener("click",e=>{
    const add=e.target.closest(".ej-order-add");
    if(add){
      e.preventDefault();
      e.stopPropagation();
      if (typeof e.stopImmediatePropagation === "function") e.stopImmediatePropagation();
      openConfig(add);
      return;
    }
    const rem=e.target.closest("[data-remove]");
    if(rem){cart.splice(+rem.dataset.remove,1);save();}
  }, true);
  $("#ej-order-fab").onclick=()=>show("cart");
  $("#ej-order-close").onclick=close;
  overlay.addEventListener("click",e=>{if(e.target===overlay)close();});
  document.addEventListener("keydown",e=>{if(e.key==="Escape"&&overlay.classList.contains("is-open"))close();});
  productType.onchange=fillSizes; version.onchange=calc; qty.oninput=calc;
  personalize.onchange=()=>{$("#ej-personal-fields").classList.toggle("ej-order-hidden",!personalize.checked);calc();};
  patches.onchange=()=>{
    patchTypeWrap?.classList.toggle("ej-order-hidden", !(patches.checked && IS_NATIONAL_LEAGUE));
    calc();
  };
  if(patchType) patchType.onchange=calc;

  $("#ej-add-cart").onclick=()=>{
    if(!current)return;
    if(personalize.checked){
      const pName=$("#ej-player-name").value.trim();
      const pNumber=$("#ej-player-number").value.trim();
      if(!pName || pName.length>20 || !/^\d{1,2}$/.test(pNumber) || Number(pNumber)<0 || Number(pNumber)>99){
        alert("Indica un nombre de hasta 20 caracteres y un dorsal entre 0 y 99."); return;
      }
    }
    const q=Math.min(20,Math.max(1,parseInt(qty.value)||1));
    qty.value=String(q);
    const prod=productType.value==="nino"?"Conjunto niño":`Camiseta adulto · ${version.value==="jugador"?"Jugador":"Aficionado"}`;
    cart.push({...current,product:prod,size:size.value,qty:q,personalize:personalize.checked,
      playerName:$("#ej-player-name").value.trim(),playerNumber:$("#ej-player-number").value.trim(),
      patches:patches.checked,
      patchType:(patches.checked && IS_NATIONAL_LEAGUE ? (patchType?.value || "LIGA") : ""),
      total:unitPrice()*q});
    save(); show("cart");
  };

  function generateOrderId(){
    const d=new Date();
    const pad=n=>String(n).padStart(2,"0");
    return `EJ-${pad(d.getDate())}${pad(d.getMonth()+1)}${String(d.getFullYear()).slice(-2)}-${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`;
  }

  function getPendingOrderId(){
    let id=sessionStorage.getItem(ORDER_ID_STORE);
    if(!id){
      id=generateOrderId();
      sessionStorage.setItem(ORDER_ID_STORE,id);
    }
    return id;
  }

  function customerData(){
    return {
      name: ($("#ej-customer-name")?.value||"").trim(),
      phone: ($("#ej-customer-phone")?.value||"").trim()
    };
  }

  function cleanPhone(value){
    return String(value||"").replace(/[^\d+]/g,"");
  }

  function safeQty(value){
    return Math.min(20,Math.max(1,parseInt(value,10)||1));
  }

  function recalcItem(x){
    const q=safeQty(x.qty);
    const isChild=x.product==="Conjunto niño";
    const isPlayer=!isChild && /Jugador/i.test(x.product||"");
    let unit=isChild?12:(isPlayer?12:9);
    if(x.personalize) unit+=3;
    if(x.patches) unit+=1;
    return {...x,qty:q,total:unit*q};
  }

  function normalizedCart(){
    return cart.map(recalcItem);
  }

  function buildOrderText(){
    const safeCart=normalizedCart();
    const total=safeCart.reduce((a,x)=>a+x.total,0);
    let msg="";

    safeCart.forEach((x,i)=>{
      const isChild=x.product==="Conjunto niño";
      const versionText=isChild?"Única":(/Jugador/i.test(x.product||"")?"Jugador":"Aficionado");

      msg+=`CAMISETA ${i+1}\n`;
      msg+=`Equipo: ${x.name}\n`;
      msg+=`Producto: ${isChild?"Conjunto niño":"Camiseta adulto"}\n`;
      msg+=`Versión: ${versionText}\n`;
      msg+=`Talla: ${x.size}\n`;
      msg+=`Cantidad: ${x.qty}\n`;
      msg+=`Nombre + dorsal: ${x.personalize?`${x.playerName} ${x.playerNumber}`:"No"}\n`;
      msg+=`Parches: ${x.patches?(x.patchType || "Sí"):"No"}\n`;
      msg+=`Importe: ${money(x.total)}\n`;

      if(i<safeCart.length-1) msg+="\n------------------------------\n\n";
    });

    return { text: msg.trim(), total, safeCart };
  }

  function validationError(message,selector){
    const status=$("#ej-order-status");
    if(status){
      status.className="ej-order-status error";
      status.innerHTML=`<b>Revisa el pedido.</b><br>${message}`;
    }
    if(selector) $(selector)?.focus();
    return null;
  }

  function validateCustomer(){
    if(!cart.length) return validationError("Añade al menos una camiseta al pedido.");

    // Honeypot: una persona no puede rellenar este campo invisible.
    if(($("#ej-order-website")?.value||"").trim()){
      return validationError("No se ha podido validar el envío. Recarga la página e inténtalo de nuevo.");
    }

    const c=customerData();
    if(c.name.length<2 || c.name.length>60){
      return validationError("Indica un nombre válido (entre 2 y 60 caracteres).","#ej-customer-name");
    }

    const phone=cleanPhone(c.phone);
    const digits=phone.replace(/\D/g,"");
    if(digits.length<9 || digits.length>15){
      return validationError("Indica un teléfono válido de entre 9 y 15 dígitos.","#ej-customer-phone");
    }

    // Validamos también los artículos almacenados antes de enviarlos.
    const allowedAdult=["S","M","L","XL","2XL","3XL"];
    const allowedChild=["16","18","20","22","24","26","28"];
    for(const x of cart){
      const isChild=x.product==="Conjunto niño";
      const allowedSizes=isChild?allowedChild:allowedAdult;
      if(!allowedSizes.includes(String(x.size||""))){
        return validationError("Hay una talla no válida en el pedido. Elimina ese artículo y vuelve a añadirlo.");
      }
      if(!Number.isFinite(Number(x.qty)) || Number(x.qty)<1 || Number(x.qty)>20){
        return validationError("La cantidad por artículo debe estar entre 1 y 20.");
      }
      if(x.personalize){
        const pn=String(x.playerName||"").trim();
        const num=String(x.playerNumber||"").trim();
        if(!pn || pn.length>20 || !/^\d{1,2}$/.test(num) || Number(num)<0 || Number(num)>99){
          return validationError("Revisa la personalización: nombre de hasta 20 caracteres y dorsal entre 0 y 99.");
        }
      }
    }

    return {...c,phone};
  }

  async function saveOrderToSupabase({orderId, customer, total, safeCart}){
    if(!supabase){
      throw new Error("Supabase no está configurado.");
    }

    // Si Supabase ya confirmó este mismo número durante esta sesión,
    // un reintento de Formspree no vuelve a duplicar el pedido.
    if(sessionStorage.getItem(DB_SAVED_STORE) === orderId){
      return;
    }

    // Generamos el UUID del pedido en el navegador. Así el visitante solo
    // necesita permiso INSERT y no necesita SELECT sobre la tabla pedidos.
    // Esto mantiene privados todos los pedidos para usuarios anónimos.
    const pedidoId = crypto.randomUUID();

    const { error: pedidoError } = await supabase
      .from("pedidos")
      .insert({
        id: pedidoId,
        numero_pedido: orderId,
        nombre_cliente: customer.name,
        telefono: customer.phone,
        total,
        estado: "Nuevo",
        notas: null
      });

    if(pedidoError){
      throw pedidoError;
    }

    const articulos = safeCart.map((x) => {
      const isChild = x.product === "Conjunto niño";
      const versionText = isChild ? "Única" : (/Jugador/i.test(x.product || "") ? "Jugador" : "Aficionado");
      const productoText = isChild ? "Conjunto niño" : "Camiseta adulto";
      const cantidad = safeQty(x.qty);
      const importe = Number(x.total) || 0;
      const precioUnitario = cantidad > 0 ? importe / cantidad : importe;
      // Guardamos una ruta pública relativa, nunca localhost ni el dominio actual.
      // Así la misma referencia funciona en desarrollo y en Netlify.
      let imagenUrl = String(x.image || "").trim();
      try {
        const parsedImageUrl = new URL(imagenUrl, window.location.origin);
        imagenUrl = `${parsedImageUrl.pathname}${parsedImageUrl.search}${parsedImageUrl.hash}`;
      } catch {
        if (imagenUrl && !imagenUrl.startsWith("/")) imagenUrl = `/${imagenUrl}`;
      }

      return {
        pedido_id: pedidoId,
        equipo: String(x.name || ""),
        temporada: String(x.temporada || ""),
        tipo_camiseta: String(x.tipo || ""),
        producto: productoText,
        version: versionText,
        talla: String(x.size || ""),
        cantidad,
        nombre_dorsal: Boolean(x.personalize),
        nombre_personalizado: x.personalize ? String(x.playerName || "") : null,
        dorsal: x.personalize ? String(x.playerNumber || "") : null,
        parches: Boolean(x.patches),
        tipo_parche: x.patches ? (String(x.patchType || "") || null) : null,
        precio_unitario: precioUnitario,
        importe,
        imagen_url: imagenUrl
      };
    });

    const { error: articulosError } = await supabase
      .from("articulos_pedido")
      .insert(articulos);

    if(articulosError){
      // El usuario anónimo no tiene permiso DELETE (intencionadamente).
      // Mostramos el error sin abrir permisos de lectura/borrado públicos.
      throw articulosError;
    }

    sessionStorage.setItem(DB_SAVED_STORE, orderId);
  }

  let orderSending=false;

  $("#ej-send-order").onclick=async()=>{
    if(orderSending) return;

    const c=validateCustomer();
    if(!c) return;

    const {text:orderText,total,safeCart}=buildOrderText();
    const orderId=getPendingOrderId();
    const btn=$("#ej-send-order");
    const status=$("#ej-order-status");

    // Sustituimos cualquier total guardado por el calculado desde las opciones reales.
    cart=safeCart;
    localStorage.setItem(STORE,JSON.stringify(cart));
    renderCart();

    orderSending=true;
    btn.disabled=true;
    btn.textContent="Enviando pedido…";
    status.className="ej-order-status";
    status.textContent="";

    const payload=new FormData();
    payload.append("Número de pedido",orderId);
    payload.append("Nombre del solicitante",c.name);
    payload.append("Teléfono",c.phone);
    payload.append("Detalle del pedido",orderText);
    payload.append("TOTAL DEL PEDIDO",money(total));
    payload.append("_subject",`Nuevo pedido ${orderId} · ${c.name} · ${money(total)}`);

    try{
      await saveOrderToSupabase({
        orderId,
        customer:c,
        total,
        safeCart
      });

      const response=await fetch(FORMSPREE_ENDPOINT,{
        method:"POST",
        body:payload,
        headers:{"Accept":"application/json"}
      });

      let result=null;
      try{ result=await response.json(); }catch{}
      if(!response.ok || (result && result.ok===false)){
        throw new Error("El servicio de pedidos no confirmó el envío");
      }

      status.className="ej-order-status ok";
      status.innerHTML=`<b>✓ Pedido enviado correctamente.</b><br>N.º de pedido: <strong>${orderId}</strong><br>Hemos recibido tu solicitud.`;
      btn.textContent="Pedido enviado ✓";
      btn.disabled=true;
      $("#ej-new-order").classList.remove("ej-order-hidden");

      // Evita que el mismo pedido reaparezca al recargar después de enviarlo.
      localStorage.removeItem(STORE);
      sessionStorage.removeItem(ORDER_ID_STORE);
      sessionStorage.removeItem(DB_SAVED_STORE);
    }catch(err){
      status.className="ej-order-status error";
      console.error("[Elite Jerseys] Error al guardar/enviar pedido:", err);
      status.innerHTML="<b>No se ha podido completar el pedido.</b><br>No se ha confirmado el guardado y envío. Inténtalo de nuevo o utiliza WhatsApp.";
      btn.disabled=false;
      btn.textContent="Reintentar envío";
    }finally{
      orderSending=false;
    }
  };

  $("#ej-new-order").onclick=()=>{
    cart=[];
    localStorage.removeItem(STORE);
    sessionStorage.removeItem(ORDER_ID_STORE);

    const name=$("#ej-customer-name");
    const phone=$("#ej-customer-phone");
    const status=$("#ej-order-status");
    const send=$("#ej-send-order");

    if(name) name.value="";
    if(phone) phone.value="";
    const hp=$("#ej-order-website");
    if(hp) hp.value="";
    status.className="ej-order-status";
    status.textContent="";
    $("#ej-new-order").classList.add("ej-order-hidden");

    send.disabled=false;
    send.textContent="Enviar pedido";

    renderCart();
    close();
  };

  $("#ej-whatsapp").onclick=()=>{
    const c=validateCustomer();
    if(!c) return;

    const {text:orderText,total}=buildOrderText();
    const orderId=getPendingOrderId();
    let msg="*PEDIDO ELITE JERSEYS*\n";
    msg+=`*N.º de pedido:* ${orderId}\n\n`;
    msg+=`*Solicitante:* ${c.name}\n`;
    msg+=`*Teléfono:* ${c.phone}\n\n`;
    msg+=orderText;

    const encoded=encodeURIComponent(msg);
    const mobile=/Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    if(mobile){
      window.location.href=`whatsapp://send?phone=${RECEIVER}&text=${encoded}`;
      setTimeout(()=>{ window.location.href=`https://wa.me/${RECEIVER}?text=${encoded}`; },1200);
    }else{
      window.open(`https://web.whatsapp.com/send?phone=${RECEIVER}&text=${encoded}`,"_blank","noopener");
    }
  };

  fillSizes(); renderCart(); addButtons();
  new MutationObserver(addButtons).observe(document.body,{childList:true,subtree:true});
})();
</script>


