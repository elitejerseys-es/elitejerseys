---
import fs from "node:fs";
import path from "node:path";

import {
  categorias,
  crearSlug,
  obtenerEscudo
} from "../data/catalogo";

const totalEquipos = categorias.reduce(
  (total, categoria) => total + categoria.equipos.length,
  0
);

const carpetaCamisetas = path.join(
  process.cwd(),
  "public",
  "camisetas"
);

const extensionesCompatibles = /\.(jpg|jpeg|png|webp)$/i;
const patronCamiseta = /^\d{4}-\d{4}-.+\.(jpg|jpeg|png|webp)$/i;

const obtenerNombresBaseUnicos = (rutaEquipo: string) => {
  if (!fs.existsSync(rutaEquipo)) return new Set<string>();

  const nombresBase = new Set<string>();

  for (const entrada of fs.readdirSync(rutaEquipo, { withFileTypes: true })) {
    if (!entrada.isFile() || !patronCamiseta.test(entrada.name)) continue;

    nombresBase.add(
      entrada.name
        .replace(extensionesCompatibles, "")
        .toLowerCase()
    );
  }

  return nombresBase;
};

const camisetasPorEquipo = new Map<string, number>();

for (const categoria of categorias) {
  for (const equipo of categoria.equipos) {
    const slug = crearSlug(equipo);
    const rutaEquipo = path.join(carpetaCamisetas, slug);
    camisetasPorEquipo.set(slug, obtenerNombresBaseUnicos(rutaEquipo).size);
  }
}

const totalCamisetas = [...camisetasPorEquipo.values()].reduce(
  (total, cantidad) => total + cantidad,
  0
);

const categoriasConMetricas = categorias.map((categoria) => {
  const camisetas = categoria.equipos.reduce(
    (total, equipo) =>
      total + (camisetasPorEquipo.get(crearSlug(equipo)) ?? 0),
    0
  );

  return {
    ...categoria,
    camisetas
  };
});

const categoriasOrdenadas = categoriasConMetricas.map((categoria) => ({
  ...categoria,
  equipos: categoria.equipos
    .slice()
    .sort((a, b) => {
      if (categoria.slug === "liga-espanola") {
        if (a === "Otros clubes") return 1;
        if (b === "Otros clubes") return -1;
      }
      return a.localeCompare(b, "es");
    })
}));

const aliasEquipos: Record<string, string[]> = {
  "paris-saint-germain": ["psg", "paris sg"],
  "olympique-de-marseille": ["om", "marseille"],
  "olympique-lyonnais": ["lyon", "ol"],
  "manchester-united": ["man united", "man utd", "united"],
  "manchester-city": ["man city", "city"],
  "tottenham-hotspur": ["tottenham", "spurs"],
  "wolverhampton-wanderers": ["wolves"],
  "brighton-and-hove-albion": ["brighton"],
  "bayern-munich": ["bayern", "bayern munchen"],
  "borussia-monchengladbach": ["gladbach"],
  "inter": ["inter milan", "internazionale"],
  "ac-milan": ["milan"],
  "juventus": ["juve"],
  "fc-barcelona": ["barca", "barcelona"],
  "real-madrid": ["madrid"],
  "atletico-de-madrid": ["atleti", "atletico"],
  "athletic-club": ["athletic", "bilbao"]
};

const indiceEquipos = categoriasOrdenadas.flatMap((categoria) =>
  categoria.equipos.map((equipo) => {
    const slug = crearSlug(equipo);
    const alias = aliasEquipos[slug] ?? [];

    return {
      nombre: equipo,
      nombreNormalizado: [equipo, ...alias]
        .join(" ")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, ""),
      slug,
      href: `/equipos/${slug}`,
      escudo: obtenerEscudo(equipo),
      categoria: categoria.nombre,
      camisetas: camisetasPorEquipo.get(slug) ?? 0
    };
  })
);

// Descubrir las fotografías en una única exploración del catálogo.
// Conserva todas las fotos 01.webp y sus equipos, sin repetir búsquedas por equipo.
const productosPortada: { nombre: string; slug: string; foto: string; fecha: number }[] = [];
const equipoPorSlug = new Map(indiceEquipos.map((item) => [item.slug, item]));
if (fs.existsSync(carpetaCamisetas)) {
  const pendientes: { ruta: string; profundidad: number; equipo: (typeof indiceEquipos)[number] | null }[] = [
    { ruta: carpetaCamisetas, profundidad: 0, equipo: null }
  ];
  while (pendientes.length > 0) {
    const { ruta, profundidad, equipo } = pendientes.pop()!;
    for (const entrada of fs.readdirSync(ruta, { withFileTypes: true })) {
      const rutaEntrada = path.join(ruta, entrada.name);
      if (entrada.isDirectory()) {
        // Igual que antes: localizar equipos en el primer o segundo nivel.
        const equipoEncontrado = !equipo && profundidad < 2
          ? equipoPorSlug.get(entrada.name.toLowerCase()) ?? null
          : null;
        if (equipo || equipoEncontrado || profundidad < 2) {
          pendientes.push({
            ruta: rutaEntrada,
            profundidad: profundidad + 1,
            equipo: equipo ?? equipoEncontrado
          });
        }
        continue;
      }
      if (!equipo || !entrada.isFile() || entrada.name.toLowerCase() !== "01.webp") continue;
      const relativa = path.relative(carpetaCamisetas, rutaEntrada)
        .split(path.sep).map(encodeURIComponent).join("/");
      productosPortada.push({
        nombre: equipo.nombre,
        slug: equipo.slug,
        foto: `/camisetas/${relativa}`,
        fecha: fs.statSync(rutaEntrada).mtimeMs
      });
    }
  }
}
// Cada carpeta aporta exclusivamente su 01.webp; se ordenan por fecha del archivo.
const novedadesPortada = productosPortada.sort((a,b) => b.fecha - a.fecha).slice(0, 12);
// Todas las fotos 01.webp de todas las carpetas, no solo seis.
const carruselPortada = [...productosPortada];

const tituloPagina = "Elite Jerseys | Catálogo de camisetas de fútbol";
const descripcionPagina =
  `Explora ${totalCamisetas} camisetas de ${totalEquipos} equipos, organizadas por liga, temporada y tipo de equipación.`;

const canonicalUrl = new URL("/", Astro.site).href;
const imagenSocial = new URL(
  "/images/logo-elite-jerseys.png",
  Astro.site
).href;

const datosEstructurados = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Elite Jerseys",
  description: descripcionPagina,
  url: canonicalUrl,
  primaryImageOfPage: imagenSocial,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: totalEquipos,
    itemListElement: indiceEquipos.map((item, indice) => ({
      "@type": "ListItem",
      position: indice + 1,
      name: item.nombre,
      url: new URL(item.href, Astro.site).href
    }))
  }
};

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="description" content={descripcionPagina} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#111713" />

    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="preload"
      href="/images/logo-elite-jerseys.png"
      as="image"
      fetchpriority="high"
    />
    <link rel="dns-prefetch" href="//fonts.googleapis.com" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Elite Jerseys" />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descripcionPagina} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imagenSocial} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloPagina} />
    <meta name="twitter:description" content={descripcionPagina} />
    <meta name="twitter:image" content={imagenSocial} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(datosEstructurados)}
    />

    <title>{tituloPagina}</title>
  </head>

  <body>
    <a class="saltar-contenido" href="#contenido-principal">
      Saltar al contenido
    </a>

    <header class="cabecera">
      <div class="contenedor cabecera-interior">
        <a href="/" class="marca" aria-label="Página de inicio">
          <span class="marca-icono"><img src="/images/logo-elite-jerseys.png" alt="" width="46" height="46" decoding="async" onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" /><span class="marca-icono-fallback">EJ</span></span>
          <span class="marca-texto"><strong>Elite Jerseys</strong><small>Catálogo independiente de camisetas de fútbol</small></span>
        </a>
        <button type="button" class="boton-menu-movil" id="boton-menu-movil" aria-controls="navegacion-principal" aria-expanded="false" aria-label="Abrir menú de navegación">☰ <span>Menú</span></button>
        <div class="guia-cabecera">
          <button type="button" class="boton-guia-tallas" id="abrir-guia-tallas" aria-haspopup="dialog" aria-controls="modal-guia-tallas">
            <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.3 8.7 15.3 2.7a2 2 0 0 0-2.8 0L2.7 12.5a2 2 0 0 0 0 2.8l6 6a2 2 0 0 0 2.8 0l9.8-9.8a2 2 0 0 0 0-2.8Z"/><path d="m7.5 10.5 2 2m1-5 2 2m1-5 2 2m-9 7 2 2"/></svg>
            GUÍA DE TALLAS
          </button>
        </div>
        <nav id="navegacion-principal" class="nav-principal" aria-label="Navegación principal">
          <a class="nav-activo" href="/">⌂ Inicio</a>
          <details class="nav-desplegable">
            <summary>⚽ Ligas <span aria-hidden="true">⌄</span></summary>
            <div class="nav-menu">
              {categoriasOrdenadas.filter(c => c.slug !== "selecciones").map(c => (
                <details class="nav-subcategoria">
                  <summary><img src={c.logo} alt="" width="25" height="25" /><span>{c.nombre}</span><span class="nav-subflecha" aria-hidden="true">⌄</span></summary>
                  <div class="nav-submenu">
                    {c.equipos.map(equipo => (
                      <a href={`/equipos/${crearSlug(equipo)}`}><img src={obtenerEscudo(equipo)} alt="" width="25" height="25" loading="lazy" decoding="async" /><span>{equipo}</span></a>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </details>
          <details class="nav-desplegable">
            <summary>◉ Selecciones <span aria-hidden="true">⌄</span></summary>
            <div class="nav-menu nav-menu-selecciones">
              {categoriasOrdenadas.find(c => c.slug === "selecciones")?.equipos.map(equipo => (
                <a href={`/equipos/${crearSlug(equipo)}`}><img src={obtenerEscudo(equipo)} alt="" width="25" height="25" loading="lazy" />{equipo}</a>
              ))}
            </div>
          </details>
          <a href="#novedades">☆ Novedades</a>
        </nav>
        <div class="nav-busqueda">
          <input id="buscador-superior" type="search" placeholder="⌕ Buscar equipos..." autocomplete="off" aria-label="Buscar equipos desde la cabecera" aria-controls="sugerencias-superiores" aria-expanded="false" />
          <div id="sugerencias-superiores" class="sugerencias-superiores" hidden></div>
        </div>
      </div>
    </header>

    <main id="contenido-principal">
      <section class="hero">
        <div class="contenedor hero-interior">
          <div class="hero-contenido">
            <span class="etiqueta-superior">CATÁLOGO DE CAMISETAS</span>
            <h1><em>Elite</em> <span>Jerseys</span></h1>
            <p class="hero-subtitulo">Tu catálogo de camisetas de fútbol</p>
            <ul class="hero-ventajas"><li>Todas las ligas y selecciones</li><li>Diferentes versiones y precios</li><li>Personalización y parches disponibles</li></ul>
            
          </div>
          <div class="hero-visual" aria-label="Presentación automática de camisetas">
            {carruselPortada.length > 0 && (
              <div class="hero-diapositiva activa" aria-hidden="false">
                <img id="foto-carrusel-portada" src={carruselPortada[0].foto} alt={`Camiseta de ${carruselPortada[0].nombre}`} loading="eager" decoding="async" fetchpriority="high" />
              </div>
            )}
            {carruselPortada.length === 0 && <div class="hero-sin-fotos">Elite Jerseys</div>}
          </div>
        </div>
      </section>

      <div class="contenedor accesos-categorias" aria-label="Ligas y selecciones del catálogo">
        {categoriasOrdenadas.map((categoria) => (
          <div class="acceso-categoria">
            <img src={categoria.logo} alt="" width="55" height="55" loading="lazy" decoding="async" />
            <strong>{categoria.nombre}</strong>
          </div>
        ))}
      </div>

      <section id="catalogo" class="catalogo contenedor">
        <div class="seccion-cabecera">
          <div>
            <span class="etiqueta-seccion">CATÁLOGO</span>
            <h2>Ligas y selecciones</h2>

            <p>
              Abre una categoría para consultar todos sus equipos.
            </p>
          </div>

        </div>


         <section id="novedades" class="novedades-portada" aria-labelledby="titulo-novedades">
           <div class="novedades-cabecera"><div><span class="novedades-etiqueta">NEW</span><h2 id="titulo-novedades">Novedades</h2><p>Una selección de camisetas del catálogo</p></div></div>
           <div class="novedades-rejilla">
             {novedadesPortada.slice(0, 8).map((producto) => (
               <a class="novedad-producto" href={`/equipos/${producto.slug}`}>
                 <div class="novedad-imagen"><img src={producto.foto} alt={`Camiseta de ${producto.nombre}`} loading="lazy" decoding="async" /></div>
                 <strong>{producto.nombre}</strong>
               </a>
             ))}
           </div>
         </section>
<section class="categorias">
          {
            categoriasOrdenadas.map((categoria, indice) => (
              <article
                class="categoria"
                data-categoria={categoria.nombre.toLowerCase()}
                data-slug={categoria.slug}
                style={`--indice:${indice}; --categoria-color:${["#ef4444","#6b21a8","#2563eb","#111827","#dc2626","#0f766e"][indice] ?? "#16805a"}`}
              >
                <button
                  class="categoria-cabecera"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`equipos-${categoria.slug}`}
                  id={`boton-${categoria.slug}`}
                >
                  <div class="categoria-info">
                    <div class="logo-liga">
                      <img
                        src={categoria.logo}
                        alt={`Logotipo de ${categoria.nombre}`}
                        width="46"
                        height="46"
                        loading="lazy"
                        decoding="async"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                      />

                      <span class="logo-provisional">⚽</span>
                    </div>

                    <span class="categoria-textos">
                      <strong>{categoria.nombre}</strong>

                      <small>
                        {categoria.equipos.length} equipos · {categoria.camisetas} camisetas
                      </small>
                    </span>
                  </div>

                  <div class="categoria-vista-previa" aria-hidden="true">
                    {
                      categoria.equipos.slice(0, 6).map((equipo) => (
                        <span class="mini-escudo">
                          <img
                            src={obtenerEscudo(equipo)}
                            alt=""
                            width="27"
                            height="27"
                            loading="lazy"
                            decoding="async"
                            onerror="this.style.display='none'"
                          />
                        </span>
                      ))
                    }
                  </div>

                  <span class="categoria-derecha">
                                        <span class="flecha">⌄</span>
                  </span>
                </button>

                <div
                  id={`equipos-${categoria.slug}`}
                  class="equipos"
                  role="region"
                  aria-labelledby={`boton-${categoria.slug}`}
                  hidden
                >
                  {
                    categoria.equipos.map((equipo) => (
                      <a
                        class="equipo"
                        href={`/equipos/${crearSlug(equipo)}`}
                        data-equipo={equipo.toLowerCase()}
                      >
                        <div class="escudo">
                          <img
                            src={obtenerEscudo(equipo)}
                            alt={`Escudo de ${equipo}`}
                            width="36"
                            height="36"
                            loading="lazy"
                            decoding="async"
                            onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                          />

                          <span class="escudo-provisional">
                            {equipo.charAt(0)}
                          </span>
                        </div>

                        <span class="nombre-equipo">{equipo}</span>
                        <span class="flecha-equipo">›</span>
                      </a>
                    ))
                  }
                </div>
              </article>
            ))
          }
        </section>

        <div id="sin-resultados" class="sin-resultados" hidden>
          <span>⚽</span>
          <h3>No se encontraron equipos</h3>
          <p>Prueba con otro nombre o elimina la búsqueda.</p>
        </div>
      </section>
    </main>

    <dialog id="modal-guia-tallas" class="modal-guia-tallas" aria-label="Guía de tallas de Elite Jerseys">
      <div class="modal-guia-interior">
        <button type="button" id="cerrar-guia-tallas" class="cerrar-guia-tallas" aria-label="Cerrar guía de tallas">×</button>
        <img src="/images/guia-tallas-elite-jerseys.png" alt="Guía de tallas de Elite Jerseys: versión aficionado y conjuntos de niño" width="1536" height="1024" loading="lazy" decoding="async" />
      </div>
    </dialog>

    <footer class="pie">
      <div class="contenedor pie-interior">
        <div>
          <strong>Elite Jerseys</strong>
          <p>Catálogo independiente de camisetas de fútbol.</p>
        </div>

        <a href="#">Volver arriba ↑</a>
      </div>
    </footer>

    <script
      id="indice-equipos"
      type="application/json"
      set:html={JSON.stringify(indiceEquipos)}
    />

    <script id="fotos-carrusel-portada" type="application/json" set:html={JSON.stringify(carruselPortada.map(({foto,nombre}) => ({foto,nombre})))} />

    <script>
       const fotosCarrusel = JSON.parse(document.getElementById("fotos-carrusel-portada")?.textContent || "[]") as Array<{foto:string; nombre:string}>;
       const imagenCarrusel = document.querySelector<HTMLImageElement>("#foto-carrusel-portada");
       if (imagenCarrusel && fotosCarrusel.length > 1 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
         // Barajar todas las fotos: cada 01.webp aparece una vez antes de repetir.
         const barajar = () => {
           const indices = fotosCarrusel.map((_, i) => i);
           for (let i = indices.length - 1; i > 0; i--) {
             const j = Math.floor(Math.random() * (i + 1));
             [indices[i], indices[j]] = [indices[j], indices[i]];
           }
           return indices;
         };
         let orden = barajar();
         let posicion = 0;
         let ultimaFoto = -1;
         const precargar = (indice: number) => {
           const siguiente = new Image();
           siguiente.src = fotosCarrusel[indice].foto;
         };
         const mostrar = (indice: number) => {
           imagenCarrusel.src = fotosCarrusel[indice].foto;
           imagenCarrusel.alt = `Camiseta de ${fotosCarrusel[indice].nombre}`;
           ultimaFoto = indice;
         };
         mostrar(orden[0]);
         precargar(orden[1]);
         window.setInterval(() => {
           if (document.hidden) return;
           posicion++;
           if (posicion >= orden.length) {
             orden = barajar();
             // Evitar que la última foto de una ronda se repita al empezar la siguiente.
             if (orden[0] === ultimaFoto) [orden[0], orden[1]] = [orden[1], orden[0]];
             posicion = 0;
           }
           mostrar(orden[posicion]);
           precargar(orden[(posicion + 1) % orden.length]);
         }, 5000);
       }
       // Menú compacto: solo se activa en pantallas de móvil.
       const botonMenuMovil = document.querySelector<HTMLButtonElement>("#boton-menu-movil");
       const navegacionMovil = document.querySelector<HTMLElement>("#navegacion-principal");
       const cerrarMenuMovil = () => {
         botonMenuMovil?.setAttribute("aria-expanded", "false");
         botonMenuMovil?.setAttribute("aria-label", "Abrir menú de navegación");
         navegacionMovil?.classList.remove("menu-movil-abierto");
         navegacionMovil?.querySelectorAll<HTMLDetailsElement>("details").forEach(d => d.open = false);
       };
       botonMenuMovil?.addEventListener("click", () => {
         const abrir = botonMenuMovil.getAttribute("aria-expanded") !== "true";
         if (!abrir) { cerrarMenuMovil(); return; }
         navegacionMovil?.classList.add("menu-movil-abierto");
         botonMenuMovil.setAttribute("aria-expanded", "true");
         botonMenuMovil.setAttribute("aria-label", "Cerrar menú de navegación");
       });
       navegacionMovil?.querySelectorAll<HTMLAnchorElement>("a").forEach(a => a.addEventListener("click", cerrarMenuMovil));
       document.addEventListener("keydown", e => { if (e.key === "Escape") cerrarMenuMovil(); });
       window.matchMedia("(min-width: 801px)").addEventListener("change", e => { if (e.matches) cerrarMenuMovil(); });
       // Desplegables de navegación y buscador de la cabecera: sin desplazamiento.
       const menuDetalles = [...document.querySelectorAll<HTMLDetailsElement>(".nav-desplegable")];
       menuDetalles.forEach(menu => {
         menu.addEventListener("toggle", () => {
           if (menu.open) menuDetalles.forEach(otro => { if (otro !== menu) otro.open = false; });
         });
       });
       document.querySelectorAll<HTMLDetailsElement>(".nav-subcategoria").forEach(submenu => {
         submenu.addEventListener("toggle", () => {
           if (!submenu.open) return;
           document.querySelectorAll<HTMLDetailsElement>(".nav-subcategoria").forEach(otro => {
             if (otro !== submenu) otro.open = false;
           });
         });
       });
       const buscarArriba = document.querySelector<HTMLInputElement>("#buscador-superior");
       const sugerenciasArriba = document.querySelector<HTMLElement>("#sugerencias-superiores");
       const datosArriba = JSON.parse(document.querySelector<HTMLScriptElement>("#indice-equipos")?.textContent || "[]") as Array<{nombre:string; nombreNormalizado:string; href:string; escudo:string; categoria:string}>;
       const normalizarArriba = (v:string) => v.toLowerCase().normalize("NFD").replace(/[\\u0300-\\u036f]/g, "").trim();
       const cerrarSugerencias = () => { if(sugerenciasArriba) sugerenciasArriba.hidden=true; buscarArriba?.setAttribute("aria-expanded","false"); };
       const mostrarSugerencias = () => {
         if (!buscarArriba || !sugerenciasArriba) return;
         const q = normalizarArriba(buscarArriba.value);
         sugerenciasArriba.replaceChildren();
         if (!q) { cerrarSugerencias(); return; }
         const resultados = datosArriba.filter(e => e.nombreNormalizado.includes(q)).slice(0, 8);
         for (const item of resultados) {
           const a = document.createElement("a"); a.href = item.href; a.className="sugerencia-superior";
           const img=document.createElement("img"); img.src=item.escudo; img.alt=""; img.width=28; img.height=28;
           const span=document.createElement("span"); span.textContent=item.nombre;
           a.append(img,span); sugerenciasArriba.append(a);
         }
         if (!resultados.length) { const aviso=document.createElement("p"); aviso.textContent="No se encontraron equipos"; sugerenciasArriba.append(aviso); }
         sugerenciasArriba.hidden=false;
         buscarArriba.setAttribute("aria-expanded","true");
       };
       buscarArriba?.addEventListener("input", mostrarSugerencias);
       buscarArriba?.addEventListener("focus", mostrarSugerencias);
       buscarArriba?.addEventListener("keydown", e => {
         if(e.key==="Escape") cerrarSugerencias();
         if(e.key==="Enter") { const primero=sugerenciasArriba?.querySelector<HTMLAnchorElement>("a"); if(primero) { e.preventDefault(); window.location.href=primero.href; } }
       });
       document.addEventListener("click", e => {
         if(!(e.target instanceof Node)) return;
         if(!e.target.parentElement?.closest(".nav-busqueda")) cerrarSugerencias();
         if(!e.target.parentElement?.closest(".nav-desplegable")) menuDetalles.forEach(menu=>menu.open=false);
       });
       const botonAbrirGuia = document.querySelector<HTMLButtonElement>("#abrir-guia-tallas");
       const botonCerrarGuia = document.querySelector<HTMLButtonElement>("#cerrar-guia-tallas");
       const modalGuia = document.querySelector<HTMLDialogElement>("#modal-guia-tallas");
       botonAbrirGuia?.addEventListener("click", () => modalGuia?.showModal());
       botonCerrarGuia?.addEventListener("click", () => modalGuia?.close());
       modalGuia?.addEventListener("click", (evento) => {
         if (evento.target === modalGuia) modalGuia.close();
       });

       interface EquipoIndice {
        nombre: string;
        nombreNormalizado: string;
        slug: string;
        href: string;
        escudo: string;
        categoria: string;
        camisetas: number;
      }

      const botonesCategoria =
        document.querySelectorAll<HTMLButtonElement>(
          ".categoria-cabecera"
        );

      const categoriasElementos =
        document.querySelectorAll<HTMLElement>(".categoria");

      const buscador =
        document.querySelector<HTMLInputElement>(
          "#buscador-equipos"
        );

      const botonLimpiar =
        document.querySelector<HTMLButtonElement>(
          "#limpiar-buscador"
        );

      const textoResultado =
        document.querySelector<HTMLElement>(
          "#resultado-busqueda"
        );

      const sinResultados =
        document.querySelector<HTMLElement>(
          "#sin-resultados"
        );

      const resultadosDirectos =
        document.querySelector<HTMLElement>(
          "#resultados-directos"
        );

      const indiceElemento =
        document.querySelector<HTMLScriptElement>(
          "#indice-equipos"
        );

      let indiceEquipos: EquipoIndice[] = [];
      let indiceResultadoActivo = -1;

      try {
        indiceEquipos = JSON.parse(
          indiceElemento?.textContent ?? "[]"
        );
      } catch {
        indiceEquipos = [];
      }

      const normalizarTexto = (texto: string) =>
        texto
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/\s+/g, " ")
          .trim();

      const claveCategorias =
        "elite-jerseys:categorias-abiertas";

      const obtenerCategoriasGuardadas = (): string[] => {
        try {
          return JSON.parse(
            localStorage.getItem(claveCategorias) ?? "[]"
          );
        } catch {
          return [];
        }
      };

      const guardarCategoriasAbiertas = () => {
        const abiertas = [...categoriasElementos]
          .filter((categoria) => {
            const boton =
              categoria.querySelector<HTMLButtonElement>(
                ".categoria-cabecera"
              );

            return boton?.getAttribute("aria-expanded") === "true";
          })
          .map((categoria) => categoria.dataset.slug ?? "")
          .filter(Boolean);

        localStorage.setItem(
          claveCategorias,
          JSON.stringify(abiertas)
        );
      };

      const establecerCategoria = (
        boton: HTMLButtonElement,
        abierta: boolean,
        guardar = true
      ) => {
        boton.setAttribute(
          "aria-expanded",
          String(abierta)
        );

        const idContenido =
          boton.getAttribute("aria-controls");

        const contenido = idContenido
          ? document.getElementById(idContenido)
          : boton.nextElementSibling;

        if (contenido instanceof HTMLElement) {
          contenido.hidden = !abierta;
        }

        if (guardar) guardarCategoriasAbiertas();
      };

      const cerrarCategorias = (
        excepcion?: HTMLButtonElement
      ) => {
        botonesCategoria.forEach((boton) => {
          if (boton !== excepcion) {
            establecerCategoria(boton, false, false);
          }
        });

        guardarCategoriasAbiertas();
      };

      botonesCategoria.forEach((boton) => {
        boton.addEventListener("click", () => {
          const abierta =
            boton.getAttribute("aria-expanded") === "true";

          establecerCategoria(boton, !abierta);
        });
      });


      const categoriasGuardadas = new Set<string>(); // Todas cerradas al cargar la página.

      categoriasElementos.forEach((categoria) => {
        const boton =
          categoria.querySelector<HTMLButtonElement>(
            ".categoria-cabecera"
          );

        if (!boton) return;

        establecerCategoria(
          boton,
          categoriasGuardadas.has(
            categoria.dataset.slug ?? ""
          ),
          false
        );
      });


      const actualizarUrl = (busqueda: string) => {
        const url = new URL(window.location.href);

        if (busqueda) {
          url.searchParams.set("q", busqueda);
        } else {
          url.searchParams.delete("q");
        }

        window.history.replaceState({}, "", url);
      };

      const renderizarResultados = (
        coincidencias: EquipoIndice[]
      ) => {
        if (!resultadosDirectos) return;

        resultadosDirectos.replaceChildren();
        indiceResultadoActivo = -1;

        if (coincidencias.length === 0) {
          resultadosDirectos.hidden = true;
          buscador?.removeAttribute("aria-activedescendant");
          return;
        }

        const fragmento = document.createDocumentFragment();

        coincidencias.slice(0, 10).forEach(
          (resultado, indice) => {
            const enlace = document.createElement("a");
            enlace.id = `resultado-${indice}`;
            enlace.className = "resultado-directo";
            enlace.href = resultado.href;
            enlace.setAttribute("role", "option");
            enlace.setAttribute("aria-selected", "false");

            const imagen = document.createElement("img");
            imagen.src = resultado.escudo;
            imagen.alt = "";
            imagen.width = 40;
            imagen.height = 40;
            imagen.loading = "lazy";
            imagen.decoding = "async";

            const textos = document.createElement("span");
            textos.className =
              "resultado-directo-textos";

            const nombre = document.createElement("strong");
            nombre.textContent = resultado.nombre;

            const detalle = document.createElement("small");
            detalle.textContent =
              `${resultado.categoria} · ${resultado.camisetas} camisetas`;

            const flecha = document.createElement("span");
            flecha.className =
              "resultado-directo-flecha";
            flecha.textContent = "›";
            flecha.setAttribute("aria-hidden", "true");

            textos.append(nombre, detalle);
            enlace.append(imagen, textos, flecha);
            fragmento.append(enlace);
          }
        );

        resultadosDirectos.append(fragmento);
        resultadosDirectos.hidden = false;
      };

      const resultadosRenderizados = () =>
        resultadosDirectos
          ? [
              ...resultadosDirectos.querySelectorAll<
                HTMLAnchorElement
              >(".resultado-directo")
            ]
          : [];

      const seleccionarResultado = (indice: number) => {
        const resultados = resultadosRenderizados();

        if (resultados.length === 0) return;

        indiceResultadoActivo =
          (indice + resultados.length) %
          resultados.length;

        resultados.forEach((resultado, posicion) => {
          const activo =
            posicion === indiceResultadoActivo;

          resultado.classList.toggle(
            "seleccionado",
            activo
          );

          resultado.setAttribute(
            "aria-selected",
            String(activo)
          );

          if (activo) {
            buscador?.setAttribute(
              "aria-activedescendant",
              resultado.id
            );

            resultado.scrollIntoView({
              block: "nearest"
            });
          }
        });
      };

      const filtrarEquipos = ({
        actualizarDireccion = true
      }: {
        actualizarDireccion?: boolean;
      } = {}) => {
        const valor = buscador?.value.trim() ?? "";
        const busqueda = normalizarTexto(valor);

        const coincidencias = busqueda
          ? indiceEquipos.filter((item) =>
              item.nombreNormalizado.includes(busqueda)
            )
          : [];

        categoriasElementos.forEach((categoria) => {
          const enlaces =
            categoria.querySelectorAll<HTMLAnchorElement>(
              ".equipo"
            );

          const botonCategoria =
            categoria.querySelector<HTMLButtonElement>(
              ".categoria-cabecera"
            );

          let coincidenciasCategoria = 0;

          enlaces.forEach((enlace) => {
            const nombre = normalizarTexto(
              enlace.dataset.equipo ?? ""
            );

            const coincide =
              busqueda === "" ||
              nombre.includes(busqueda);

            enlace.hidden = !coincide;

            if (coincide && busqueda) {
              coincidenciasCategoria++;
            }
          });

          categoria.hidden =
            busqueda !== "" &&
            coincidenciasCategoria === 0;

          if (botonCategoria) {
            if (busqueda) {
              establecerCategoria(
                botonCategoria,
                coincidenciasCategoria > 0,
                false
              );
            } else {
              establecerCategoria(
                botonCategoria,
                categoriasGuardadas.has(
                  categoria.dataset.slug ?? ""
                ),
                false
              );
            }
          }
        });

        renderizarResultados(coincidencias);

        if (busqueda && coincidencias.length === 1) {
          const objetivo = document.querySelector<HTMLElement>(
            `.equipo[href="${coincidencias[0].href}"]`
          );

          objetivo?.scrollIntoView({
            behavior: "smooth",
            block: "center"
          });
        }

        if (botonLimpiar) {
          botonLimpiar.hidden = valor === "";
        }

        if (textoResultado) {
          if (!busqueda) {
            textoResultado.textContent =
              "Escribe el nombre de un equipo para encontrarlo rápidamente.";
          } else if (coincidencias.length === 1) {
            textoResultado.textContent =
              "Se ha encontrado 1 equipo.";
          } else {
            textoResultado.textContent =
              `Se han encontrado ${coincidencias.length} equipos.`;
          }
        }

        if (sinResultados) {
          sinResultados.hidden =
            busqueda === "" ||
            coincidencias.length > 0;
        }

        if (actualizarDireccion) {
          actualizarUrl(valor);
        }

      };

      let temporizadorBusqueda: number | undefined;

      buscador?.addEventListener("input", () => {
        window.clearTimeout(temporizadorBusqueda);

        temporizadorBusqueda = window.setTimeout(
          () => filtrarEquipos(),
          70
        );
      });

      buscador?.addEventListener("keydown", (evento) => {
        const resultados = resultadosRenderizados();

        if (
          evento.key === "ArrowDown" &&
          resultados.length > 0
        ) {
          evento.preventDefault();
          seleccionarResultado(
            indiceResultadoActivo + 1
          );
        }

        if (
          evento.key === "ArrowUp" &&
          resultados.length > 0
        ) {
          evento.preventDefault();
          seleccionarResultado(
            indiceResultadoActivo - 1
          );
        }

        if (
          evento.key === "Enter" &&
          indiceResultadoActivo >= 0
        ) {
          evento.preventDefault();
          resultados[indiceResultadoActivo]?.click();
        }

        if (evento.key === "Escape") {
          buscador.value = "";
          filtrarEquipos();
          buscador.focus();
        }
      });

      botonLimpiar?.addEventListener("click", () => {
        if (!buscador) return;

        buscador.value = "";
        filtrarEquipos();
        buscador.focus();
      });

      document.addEventListener("keydown", (evento) => {
        const objetivo = evento.target;

        const escribiendo =
          objetivo instanceof HTMLInputElement ||
          objetivo instanceof HTMLTextAreaElement ||
          objetivo instanceof HTMLSelectElement ||
          (objetivo instanceof HTMLElement &&
            objetivo.isContentEditable);

        if (evento.key === "/" && !escribiendo) {
          evento.preventDefault();
          buscador?.focus();
          buscador?.select();
        }
      });

      window.addEventListener("popstate", () => {
        if (!buscador) return;

        buscador.value =
          new URL(window.location.href)
            .searchParams.get("q") ?? "";

        filtrarEquipos({
          actualizarDireccion: false
        });
      });

      if (buscador) {
        buscador.value =
          new URL(window.location.href)
            .searchParams.get("q") ?? "";

        if (buscador.value) {
          filtrarEquipos({
            actualizarDireccion: false
          });
        }
      }

      if ("IntersectionObserver" in window) {
        const observerCategorias = new IntersectionObserver(
          (entradas, observer) => {
            entradas.forEach((entrada) => {
              if (!entrada.isIntersecting) return;

              entrada.target.classList.add("categoria-visible");
              observer.unobserve(entrada.target);
            });
          },
          { rootMargin: "160px 0px" }
        );

        categoriasElementos.forEach((categoria) => {
          observerCategorias.observe(categoria);
        });
      } else {
        categoriasElementos.forEach((categoria) => {
          categoria.classList.add("categoria-visible");
        });
      }

      document.documentElement.classList.add(
        "pagina-cargada"
      );
    </script>
  </body>
</html>

