  "senegal": { primario: "#00853F", secundario: "#FDEF42", acento: "#E31B23", primarioRgb: "0, 133, 63", secundarioRgb: "253, 239, 66", acentoRgb: "227, 27, 35" },
  "sevilla-fc": { primario: "#FFFFFF", secundario: "#D71920", acento: "#111111", primarioRgb: "255, 255, 255", secundarioRgb: "215, 25, 32", acentoRgb: "17, 17, 17" },
  "sd-eibar": { primario: "#0057A8", secundario: "#D71920", acento: "#FFFFFF", primarioRgb: "0, 87, 168", secundarioRgb: "215, 25, 32", acentoRgb: "255, 255, 255" },
  "stade-brestois": { primario: "#D71920", secundario: "#FFFFFF", acento: "#111111", primarioRgb: "215, 25, 32", secundarioRgb: "255, 255, 255", acentoRgb: "17, 17, 17" },
  "stade-rennais": { primario: "#D71920", secundario: "#111111", acento: "#FFFFFF", primarioRgb: "215, 25, 32", secundarioRgb: "17, 17, 17", acentoRgb: "255, 255, 255" },
  "sunderland": { primario: "#EB172B", secundario: "#FFFFFF", acento: "#111111", primarioRgb: "235, 23, 43", secundarioRgb: "255, 255, 255", acentoRgb: "17, 17, 17" },
  "sv-elversberg": { primario: "#111111", secundario: "#FFFFFF", acento: "#F7D117", primarioRgb: "17, 17, 17", secundarioRgb: "255, 255, 255", acentoRgb: "247, 209, 23" },
  "sc-paderborn": { primario: "#0057A8", secundario: "#111111", acento: "#FFFFFF", primarioRgb: "0, 87, 168", secundarioRgb: "17, 17, 17", acentoRgb: "255, 255, 255" },
  "torino": { primario: "#8B1E2D", secundario: "#FFFFFF", acento: "#111111", primarioRgb: "139, 30, 45", secundarioRgb: "255, 255, 255", acentoRgb: "17, 17, 17" },
  "tottenham-hotspur": { primario: "#FFFFFF", secundario: "#132257", acento: "#D4AF37", primarioRgb: "255, 255, 255", secundarioRgb: "19, 34, 87", acentoRgb: "212, 175, 55" },
  "toulouse-fc": { primario: "#5F259F", secundario: "#FFFFFF", acento: "#D4AF37", primarioRgb: "95, 37, 159", secundarioRgb: "255, 255, 255", acentoRgb: "212, 175, 55" },
  "tsg-hoffenheim": { primario: "#0057A8", secundario: "#FFFFFF", acento: "#111111", primarioRgb: "0, 87, 168", secundarioRgb: "255, 255, 255", acentoRgb: "17, 17, 17" },
  "ud-almeria": { primario: "#E30613", secundario: "#FFFFFF", acento: "#111111", primarioRgb: "227, 6, 19", secundarioRgb: "255, 255, 255", acentoRgb: "17, 17, 17" },
  "ud-las-palmas": { primario: "#FFDD00", secundario: "#0057A8", acento: "#FFFFFF", primarioRgb: "255, 221, 0", secundarioRgb: "0, 87, 168", acentoRgb: "255, 255, 255" },
  "udinese": { primario: "#111111", secundario: "#FFFFFF", acento: "#D4AF37", primarioRgb: "17, 17, 17", secundarioRgb: "255, 255, 255", acentoRgb: "212, 175, 55" },
  "union-berlin": { primario: "#E30613", secundario: "#FFFFFF", acento: "#F7D117", primarioRgb: "227, 6, 19", secundarioRgb: "255, 255, 255", acentoRgb: "247, 209, 23" },
  "uruguay": { primario: "#5BC2E7", secundario: "#FFFFFF", acento: "#111111", primarioRgb: "91, 194, 231", secundarioRgb: "255, 255, 255", acentoRgb: "17, 17, 17" },
  "valencia-cf": { primario: "#FFFFFF", secundario: "#111111", acento: "#F58220", primarioRgb: "255, 255, 255", secundarioRgb: "17, 17, 17", acentoRgb: "245, 130, 32" },
  "venezia": { primario: "#111111", secundario: "#F58220", acento: "#0B8F55", primarioRgb: "17, 17, 17", secundarioRgb: "245, 130, 32", acentoRgb: "11, 143, 85" },
  "vfb-stuttgart": { primario: "#FFFFFF", secundario: "#E30613", acento: "#111111", primarioRgb: "255, 255, 255", secundarioRgb: "227, 6, 19", acentoRgb: "17, 17, 17" },
  "villarreal-cf": { primario: "#F7D117", secundario: "#0057A8", acento: "#FFFFFF", primarioRgb: "247, 209, 23", secundarioRgb: "0, 87, 168", acentoRgb: "255, 255, 255" },
  "werder-bremen": { primario: "#009A44", secundario: "#FFFFFF", acento: "#111111", primarioRgb: "0, 154, 68", secundarioRgb: "255, 255, 255", acentoRgb: "17, 17, 17" },
  "west-ham-united": { primario: "#7A263A", secundario: "#1BB1E7", acento: "#F3D459", primarioRgb: "122, 38, 58", secundarioRgb: "27, 177, 231", acentoRgb: "243, 212, 89" },
  "wolverhampton-wanderers": { primario: "#FDB913", secundario: "#111111", acento: "#FFFFFF", primarioRgb: "253, 185, 19", secundarioRgb: "17, 17, 17", acentoRgb: "255, 255, 255" }
};

const temaEquipo = paletasEquipos[equipoSlug] ?? temaNeutro;

const convertirRgb = (rgb: string) =>
  rgb.split(",").map((valor) => Number(valor.trim()));

const luminancia = (rgb: string) => {
  const [r = 0, g = 0, b = 0] = convertirRgb(rgb);
  return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
};

const primarioMuyClaro = luminancia(temaEquipo.primarioRgb) > 0.82;

const fondoPrincipalRgb = primarioMuyClaro
  ? temaEquipo.secundarioRgb
  : temaEquipo.primarioRgb;

const fondoSecundarioRgb = primarioMuyClaro
  ? temaEquipo.acentoRgb
  : temaEquipo.secundarioRgb;

const intensidadFondo = primarioMuyClaro ? 0.23 : 0.18;

const colorNavegador = primarioMuyClaro
  ? temaEquipo.secundario
  : temaEquipo.primario;

const escudoUrlAbsoluta = new URL(
  obtenerEscudo(equipo),
  Astro.url.origin
).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={`Todas las camisetas de ${equipo} en Elite Jerseys`}
    />

    <meta name="theme-color" content={colorNavegador} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Elite Jerseys" />
    <meta property="og:title" content={`${equipo} | Elite Jerseys`} />
    <meta
      property="og:description"
      content={`Explora todas las camisetas de ${equipo} por temporada y tipo de equipación.`}
    />
    <meta property="og:image" content={escudoUrlAbsoluta} />
    <meta property="og:url" content={Astro.url.href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${equipo} | Elite Jerseys`} />
    <meta
      name="twitter:description"
      content={`Catálogo de camisetas de ${equipo} en Elite Jerseys.`}
    />
    <meta name="twitter:image" content={escudoUrlAbsoluta} />

    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%23111713'/%3E%3Ctext x='32' y='40' text-anchor='middle' font-family='Arial' font-size='25' font-weight='700' fill='%23d7ad4d'%3EEJ%3C/text%3E%3C/svg%3E"
    />

    <title>{equipo} | Elite Jerseys</title>
  </head>

  <body
    style={[
      `--club-primary:${temaEquipo.primario}`,
      `--club-secondary:${temaEquipo.secundario}`,
      `--club-accent:${temaEquipo.acento}`,
      `--club-primary-rgb:${temaEquipo.primarioRgb}`,
      `--club-secondary-rgb:${temaEquipo.secundarioRgb}`,
      `--club-accent-rgb:${temaEquipo.acentoRgb}`,
      `--club-bg-main-rgb:${fondoPrincipalRgb}`,
      `--club-bg-secondary-rgb:${fondoSecundarioRgb}`,
      `--club-bg-strength:${intensidadFondo}`
    ].join(";")}
  >
    <div class="fondo-paleta-club" aria-hidden="true">
      <span class="halo halo-primario"></span>
      <span class="halo halo-secundario"></span>
      <span class="halo halo-acento"></span>
      <span class="trama-club"></span>
    </div>
    <img
      class="fondo-escudo-equipo"
      src={obtenerEscudo(equipo)}
      alt=""
      aria-hidden="true"
    />

    <header class="cabecera">
      <div class="contenedor cabecera-interior">
        <a href="/" class="marca" aria-label="Ir al inicio">
          <span class="marca-icono">
            <img
              src="/images/logo-elite-jerseys.png"
              alt=""
              aria-hidden="true"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
            />
            <span class="marca-iniciales">EJ</span>
          </span>

          <span class="marca-texto">
            <strong>Elite Jerseys</strong>
            <small>Catálogo de camisetas de fútbol</small>
          </span>
        </a>
      </div>
    </header>

    <main class="contenedor">
      <nav class="migas" aria-label="Navegación">
        <div class="menu-inicio">
          <button
            class="enlace-inicio"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
          >
            <span>Inicio</span>
            <span class="flecha-inicio">▾</span>
          </button>

          <div
            class="desplegable-inicio"
            aria-hidden="true"
          >
            <div class="titulo-desplegable">
              Ligas y selecciones
            </div>

            <div class="lista-categorias">
              {
                categoriasOrdenadas.map((item) => (
                  <details class="categoria-menu">
                    <summary class="categoria-resumen">
                      <span class="categoria-info">
                        <span class="logo-categoria">
                          <img
                            src={item.logo}
                            alt={`Logo de ${item.nombre}`}
                            loading="lazy"
                          />
                        </span>

                        <span>{item.nombre}</span>
                      </span>

                      <span class="flecha-categoria">▾</span>
                    </summary>

                    <div class="equipos-categoria">
                      {
                        item.equipos.map((nombreEquipo) => (
                          <a
                            href={`/equipos/${crearSlug(nombreEquipo)}`}
                            class:list={[
                              "enlace-equipo-inicio",
                              { activo: nombreEquipo === equipo }
                            ]}
                          >
                            <img
                              src={obtenerEscudo(nombreEquipo)}
                              alt=""
                              loading="lazy"
                              onerror="this.style.visibility='hidden'"
                            />

                            <span class="nombre-equipo-menu">
                              {nombreEquipo}
                            </span>

                            {
                              nombreEquipo === equipo && (
                                <span class="marca-activo">✓</span>
                              )
                            }
                          </a>
                        ))
                      }
                    </div>
                  </details>
                ))
              }
            </div>
          </div>
        </div>

        <span class="separador">›</span>

        <div class="menu-liga">
          <button
            class="enlace-liga"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
          >
            <span>{categoria}</span>
            <span class="flecha-menu">▾</span>
          </button>

          <div
            class="desplegable-liga"
            aria-hidden="true"
          >
            <div class="titulo-desplegable">
              Equipos de {categoria}
            </div>

            <div class="lista-equipos">
              {
                equiposCategoria.map((nombreEquipo) => (
                  <a
                    href={`/equipos/${crearSlug(nombreEquipo)}`}
                    class:list={[
                      "enlace-equipo-menu",
                      { activo: nombreEquipo === equipo }
                    ]}
                  >
                    <img
                      src={obtenerEscudo(nombreEquipo)}
                      alt=""
                      loading="lazy"
                      onerror="this.style.visibility='hidden'"
                    />

                    <span class="nombre-equipo-menu">
                      {nombreEquipo}
                    </span>

                    {
                      nombreEquipo === equipo && (
                        <span class="marca-activo">✓</span>
                      )
                    }
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <span class="separador">›</span>
        <strong>{equipo}</strong>
      </nav>

      <section class="equipo-hero">
        <img
          class="marca-agua-escudo"
          src={obtenerEscudo(equipo)}
          alt=""
          aria-hidden="true"
        />

        <div class="equipo-identidad">
          <div class="escudo-grande">
            <img
              src={obtenerEscudo(equipo)}
              alt={`Escudo de ${equipo}`}
              decoding="async"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
            />
            <span class="escudo-error" aria-hidden="true">
              {equipo.charAt(0)}
            </span>
          </div>

          <div class="equipo-datos">
            <div class="categoria-linea">
              <span class="categoria">{categoria}</span>
              <span class="estado-catalogo">CATÁLOGO ACTIVO</span>
            </div>

            <h1>{equipo}</h1>
          </div>
        </div>
      </section>

      {
        equiposCategoria.length > 1 && (
          <nav class="navegacion-equipos navegacion-superior" aria-label="Navegación entre equipos">
            <a href={`/equipos/${crearSlug(equipoAnterior)}`} class="equipo-anterior">
              <span class="nav-flecha" aria-hidden="true">←</span>

              <span class="nav-escudo">
                <img
                  src={obtenerEscudo(equipoAnterior)}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                />
                <span class="nav-escudo-fallback">
                  {equipoAnterior.charAt(0)}
                </span>
              </span>

              <span class="nav-textos">
                <small>Anterior</small>
                <strong>{equipoAnterior}</strong>
              </span>
            </a>

            <a href={`/equipos/${crearSlug(equipoSiguiente)}`} class="equipo-siguiente">
              <span class="nav-textos">
                <small>Siguiente</small>
                <strong>{equipoSiguiente}</strong>
              </span>

              <span class="nav-escudo">
                <img
                  src={obtenerEscudo(equipoSiguiente)}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                />
                <span class="nav-escudo-fallback">
                  {equipoSiguiente.charAt(0)}
                </span>
              </span>

              <span class="nav-flecha" aria-hidden="true">→</span>
            </a>
          </nav>
        )
      }

      {

        camisetas.length > 0 ? (
          <>
            <section class="barra-galeria">
              <div>
                <span class="etiqueta-seccion">COLECCIÓN</span>
                <h2>Camisetas de {equipo}</h2>
                <p>Explora todas las equipaciones disponibles del equipo.</p>
              </div>

              <div class="filtros">

                <select id="filtro-temporada" aria-label="Filtrar por temporada">
                  <option value="todas">Todas las temporadas</option>

                  {
                    temporadas.map((temporada) => (
                      <option value={temporada}>{temporada}</option>
                    ))
                  }
                </select>
              </div>
            </section>

            <div class="filtros-rapidos" aria-label="Filtros rápidos">
              <button class="filtro-rapido activo" type="button" data-filtro-tipo="todos">
                Todas
              </button>

              {
                tipos.map((tipoSlug) => (
                  <button
                    class:list={["filtro-rapido", `tipo-${tipoSlug}`]}
                    type="button"
                    data-filtro-tipo={tipoSlug}
                  >
                    {convertirTipo(tipoSlug)}
                  </button>
                ))
              }
            </div>

            <p id="contador-resultados" class="contador-resultados">
              Mostrando {camisetas.length} camisetas
            </p>

            <section class="galeria">
              {
                camisetas.map((camiseta, indice) => (
                  <button
                    class="foto"
                    type="button"
                    data-indice={indice}
                    data-temporada={camiseta.temporada}
                    data-tipo={camiseta.tipoSlug}
                    data-src={camiseta.src}
                    data-titulo={`${equipo} · ${camiseta.temporada} · ${camiseta.tipo}`}
                  >
                    <div class="foto-imagen">
                      <img
                        src={camiseta.src}
                        alt={`${equipo} ${camiseta.temporada} ${camiseta.tipo}`}
                        loading={indice < 3 ? "eager" : "lazy"}
                        decoding="async"
                        fetchpriority={indice === 0 ? "high" : "auto"}
                        onload="this.classList.add('cargada')"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                      />

                      <span class="imagen-no-disponible">
                        <span>Imagen no disponible</span>
                      </span>

                      <span class="ampliar">Ver imagen</span>
                    </div>

                    <div class="foto-texto">
                      <span class:list={["badge-tipo", `tipo-${camiseta.tipoSlug}`]}>
                        {camiseta.tipo}
                      </span>

                      <span class="temporada">{camiseta.temporada}</span>
                    </div>
                  </button>
                ))
              }
            </section>

            <section id="sin-filtros" class="sin-filtros" hidden>
              <span>⚽</span>
              <h3>No hay camisetas con esos filtros</h3>
              <p>Prueba con otra temporada o tipo de equipación.</p>
            </section>
          </>
        ) : (
          <section class="sin-fotos">
            <span>📷</span>
            <h2>Todavía no hay camisetas</h2>
            <p>
              Añade fotografías directamente dentro de la carpeta del equipo.
            </p>
          </section>
        )
      }

    </main>

    <div
      id="visor"
      class="visor"
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-label="Vista ampliada"
    >
      <div class="visor-fondo" data-cerrar-visor></div>

      <div class="visor-contenido">
        <button
          class="visor-cerrar"
          type="button"
          aria-label="Cerrar imagen"
          data-cerrar-visor
        >
          ×
        </button>

        <button
          class="visor-anterior"
          type="button"
          aria-label="Imagen anterior"
        >
          ‹
        </button>

        <figure>
          <div class="visor-imagen-contenedor">
            <img
              id="visor-imagen"
              src=""
              alt=""
              onerror="this.style.opacity='0';"
            />
          </div>

          <div class="visor-pie">
            <figcaption id="visor-titulo"></figcaption>

            <div class="controles-zoom">
              <button id="zoom-menos" type="button" aria-label="Alejar">−</button>
              <span id="zoom-valor">100%</span>
              <button id="zoom-mas" type="button" aria-label="Acercar">+</button>
              <button id="zoom-restablecer" type="button">Restablecer</button>
            </div>
          </div>
        </figure>

        <button
          class="visor-siguiente"
          type="button"
          aria-label="Imagen siguiente"
        >
          ›
        </button>
      </div>
    </div>

    <script>
      const botonInicio =
        document.querySelector<HTMLButtonElement>(".enlace-inicio");

      const menuInicio =
        document.querySelector<HTMLElement>(".menu-inicio");

      const desplegableInicio =
        document.querySelector<HTMLElement>(".desplegable-inicio");

      const botonLiga =
        document.querySelector<HTMLButtonElement>(".enlace-liga");

      const menuLiga =
        document.querySelector<HTMLElement>(".menu-liga");

      const desplegableLiga =
        document.querySelector<HTMLElement>(".desplegable-liga");

      const cerrarInicio = () => {
        menuInicio?.classList.remove("abierto");
        botonInicio?.setAttribute("aria-expanded", "false");
        desplegableInicio?.setAttribute("aria-hidden", "true");
      };

      const abrirInicio = () => {
        cerrarLiga();
        menuInicio?.classList.add("abierto");
        botonInicio?.setAttribute("aria-expanded", "true");
        desplegableInicio?.setAttribute("aria-hidden", "false");
      };

      const cerrarLiga = () => {
        menuLiga?.classList.remove("abierto");
        botonLiga?.setAttribute("aria-expanded", "false");
        desplegableLiga?.setAttribute("aria-hidden", "true");
      };

      const abrirLiga = () => {
        cerrarInicio();
        menuLiga?.classList.add("abierto");
        botonLiga?.setAttribute("aria-expanded", "true");
        desplegableLiga?.setAttribute("aria-hidden", "false");
      };

      botonInicio?.addEventListener("click", () => {
        const estaAbierto =
          menuInicio?.classList.contains("abierto") ?? false;

        estaAbierto ? cerrarInicio() : abrirInicio();
      });

      botonLiga?.addEventListener("click", () => {
        const estaAbierto =
          menuLiga?.classList.contains("abierto") ?? false;

        estaAbierto ? cerrarLiga() : abrirLiga();
      });

      document.addEventListener("click", (evento) => {
        if (!(evento.target instanceof Node)) return;

        if (menuInicio && !menuInicio.contains(evento.target)) {
          cerrarInicio();
        }

        if (menuLiga && !menuLiga.contains(evento.target)) {
          cerrarLiga();
        }
      });

      const categoriasMenu =
        document.querySelectorAll<HTMLDetailsElement>(".categoria-menu");

      categoriasMenu.forEach((categoriaMenu) => {
        categoriaMenu.addEventListener("toggle", () => {
          if (!categoriaMenu.open) return;

          categoriasMenu.forEach((otraCategoria) => {
            if (otraCategoria !== categoriaMenu) {
              otraCategoria.open = false;
            }
          });
        });
      });

      const filtroTemporada =
        document.querySelector<HTMLSelectElement>("#filtro-temporada");

      const filtrosRapidos =
        document.querySelectorAll<HTMLButtonElement>(".filtro-rapido");

      const tarjetas =
        Array.from(document.querySelectorAll<HTMLButtonElement>(".foto"));

      const contador =
        document.querySelector<HTMLElement>("#contador-resultados");

      const sinFiltros =
        document.querySelector<HTMLElement>("#sin-filtros");

      let tipoActivo = "todos";

      const aplicarFiltros = () => {
        const temporada = filtroTemporada?.value ?? "todas";

        let visibles = 0;

        tarjetas.forEach((tarjeta) => {
          const coincideTemporada =
            temporada === "todas" ||
            tarjeta.dataset.temporada === temporada;

          const coincideTipo =
            tipoActivo === "todos" ||
            tarjeta.dataset.tipo === tipoActivo;

          const mostrar =
            coincideTemporada &&
            coincideTipo;

          tarjeta.hidden = !mostrar;

          if (mostrar) visibles += 1;
        });

        if (contador) {
          contador.textContent =
            visibles === 1
              ? "Mostrando 1 camiseta"
              : `Mostrando ${visibles} camisetas`;
        }

        if (sinFiltros) {
          sinFiltros.hidden = visibles > 0;
        }
      };

      filtroTemporada?.addEventListener("change", aplicarFiltros);

      filtrosRapidos.forEach((boton) => {
        boton.addEventListener("click", () => {
          filtrosRapidos.forEach((otro) => otro.classList.remove("activo"));
          boton.classList.add("activo");

          tipoActivo = boton.dataset.filtroTipo ?? "todos";
          aplicarFiltros();
        });
      });

      const visor =
        document.querySelector<HTMLElement>("#visor");

      const visorImagen =
        document.querySelector<HTMLImageElement>("#visor-imagen");

      const visorTitulo =
        document.querySelector<HTMLElement>("#visor-titulo");

      const botonAnterior =
        document.querySelector<HTMLButtonElement>(".visor-anterior");

      const botonSiguiente =
        document.querySelector<HTMLButtonElement>(".visor-siguiente");

      const zoomMas =
        document.querySelector<HTMLButtonElement>("#zoom-mas");

      const zoomMenos =
        document.querySelector<HTMLButtonElement>("#zoom-menos");

      const zoomRestablecer =
        document.querySelector<HTMLButtonElement>("#zoom-restablecer");

      const zoomValor =
        document.querySelector<HTMLElement>("#zoom-valor");

      let indiceActual = 0;
      let nivelZoom = 1;
      let inicioDeslizamientoX = 0;

      const actualizarZoom = () => {
        if (!visorImagen) return;

        visorImagen.style.transform = `scale(${nivelZoom})`;

        if (zoomValor) {
          zoomValor.textContent = `${Math.round(nivelZoom * 100)}%`;
        }
      };

      const restablecerZoom = () => {
        nivelZoom = 1;
        actualizarZoom();
      };

      const tarjetasVisibles = () =>
        tarjetas.filter((tarjeta) => !tarjeta.hidden);

      const mostrarEnVisor = (tarjeta: HTMLButtonElement) => {
        if (!visor || !visorImagen || !visorTitulo) return;

        const visibles = tarjetasVisibles();
        indiceActual = visibles.indexOf(tarjeta);

        visorImagen.src = tarjeta.dataset.src ?? "";
        visorImagen.alt = tarjeta.dataset.titulo ?? "";
        visorTitulo.textContent = tarjeta.dataset.titulo ?? "";

        restablecerZoom();
        visor.classList.add("abierto");
        visor.setAttribute("aria-hidden", "false");
        document.body.classList.add("sin-scroll");
      };

      const cerrarVisor = () => {
        visor?.classList.remove("abierto");
        visor?.setAttribute("aria-hidden", "true");
        document.body.classList.remove("sin-scroll");
        restablecerZoom();
      };

      const cambiarImagen = (direccion: number) => {
        const visibles = tarjetasVisibles();

        if (visibles.length === 0) return;

        indiceActual =
          (indiceActual + direccion + visibles.length) % visibles.length;

        mostrarEnVisor(visibles[indiceActual]);
      };

      tarjetas.forEach((tarjeta) => {
        tarjeta.addEventListener("click", () => mostrarEnVisor(tarjeta));
      });

      document
        .querySelectorAll<HTMLElement>("[data-cerrar-visor]")
        .forEach((elemento) => {
          elemento.addEventListener("click", cerrarVisor);
        });

      botonAnterior?.addEventListener("click", () => cambiarImagen(-1));
      botonSiguiente?.addEventListener("click", () => cambiarImagen(1));

      zoomMas?.addEventListener("click", () => {
        nivelZoom = Math.min(2.5, nivelZoom + 0.25);
        actualizarZoom();
      });

      zoomMenos?.addEventListener("click", () => {
        nivelZoom = Math.max(0.75, nivelZoom - 0.25);
        actualizarZoom();
      });

      zoomRestablecer?.addEventListener("click", restablecerZoom);

      visorImagen?.addEventListener("dblclick", () => {
        nivelZoom = nivelZoom === 1 ? 1.75 : 1;
        actualizarZoom();
      });

      visorImagen?.addEventListener(
        "wheel",
        (evento) => {
          if (!visor?.classList.contains("abierto")) return;

          evento.preventDefault();

          nivelZoom = Math.min(
            2.5,
            Math.max(
              0.75,
              nivelZoom + (evento.deltaY < 0 ? 0.15 : -0.15)
            )
          );

          actualizarZoom();
        },
        { passive: false }
      );

      visor?.addEventListener("touchstart", (evento) => {
        inicioDeslizamientoX = evento.touches[0]?.clientX ?? 0;
      });

      visor?.addEventListener("touchend", (evento) => {
        const finalX = evento.changedTouches[0]?.clientX ?? 0;
        const diferencia = finalX - inicioDeslizamientoX;

        if (Math.abs(diferencia) < 55) return;

        cambiarImagen(diferencia > 0 ? -1 : 1);
      });

      document.addEventListener("keydown", (evento) => {
        if (evento.key === "Escape") {
          cerrarInicio();
          cerrarLiga();
          cerrarVisor();
        }

        if (!visor?.classList.contains("abierto")) return;

        if (evento.key === "ArrowLeft") cambiarImagen(-1);
        if (evento.key === "ArrowRight") cambiarImagen(1);
      });
    </script>
  </body>
</html>

