  }

  .nombre-equipo {
    font-size: 12px !important;
    font-weight: 760 !important;
  }

  .escudo img {
    transition: transform 160ms ease;
  }

  .equipo:hover .escudo img {
    transform: scale(1.05);
  }

  .hero {
    min-height: 0 !important;
  }

  .hero-interior {
    min-height: 470px !important;
  }

